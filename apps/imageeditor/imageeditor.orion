<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="imageeditor"
    title="Image Editor Dialogs"
    root="apps/imageeditor">

    <plugins>
      <plugin name="formeditor_components" />
      <plugin name="imageeditor_components" />
    </plugins>

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="new" label="New" shortcut="Ctrl+N" />
        <item name="open" label="Open..." shortcut="Ctrl+O" />
        <Separator />
        <item name="save" label="Save" shortcut="Ctrl+S" />
        <item name="saveas" label="Save As..." />
        <Separator />
        <item name="close" label="Close" shortcut="Ctrl+W" />
        <Separator />
        <item name="quit" label="Quit" />
      </menu>

      <menu name="edit" label="Edit">
        <item name="undo" label="Undo" shortcut="Ctrl+Z" />
        <item name="redo" label="Redo" shortcut="Ctrl+Y" />
        <Separator />
        <item name="cut" label="Cut" shortcut="Ctrl+X" />
        <item name="copy" label="Copy" shortcut="Ctrl+C" />
        <item name="paste" label="Paste" shortcut="Ctrl+V" />
      </menu>

      <menu name="select" label="Select">
        <item name="all" label="All" shortcut="Ctrl+A" />
        <item name="deselect" label="Deselect" shortcut="Escape" />
        <Separator />
        <item name="clear" label="Clear Selection" shortcut="Delete;Backspace" />
        <Separator />
        <item name="expand" label="Expand..." />
        <item name="contract" label="Contract..." />
      </menu>

      <menu name="image" label="Image">
        <item name="crop" label="Crop" />
        <Separator />
        <item name="resize" label="Image Size..." />
        <item name="canvas_size" label="Canvas Size..." />
        <Separator />
        <item name="flip_h" label="Flip Horizontal" />
        <item name="flip_v" label="Flip Vertical" />
        <Separator />
        <item name="invert" label="Invert Colors" />
        <item name="levels" label="Levels..." />
      </menu>

      <menu name="filter" label="Filter" dynamic="true">
        <item name="reload" label="Reload Filters" />
        <item name="gallery" label="Filter Gallery..." />
        <Separator />
        <submenu name="blur" label="Blur">
          <item name="blur" label="Blur" />
        </submenu>
        <submenu name="sharpen" label="Sharpen">
          <item name="sharpen" label="Sharpen" />
        </submenu>
        <submenu name="stylize" label="Stylize">
          <item name="edge" label="Find Edges" />
        </submenu>
        <submenu name="photo" label="Photo" />
      </menu>

      <menu name="layer" label="Layer">
        <item name="new" label="New Layer" />
        <item name="duplicate" label="Duplicate Layer" />
        <item name="delete" label="Delete Layer" />
        <Separator />
        <item name="move_up" label="Move Layer Up" />
        <item name="move_down" label="Move Layer Down" />
        <Separator />
        <item name="merge_down" label="Merge Down" />
        <item name="flatten" label="Flatten Image" />
        <item name="fill_foreground" label="Fill with Foreground Color" shortcut="Alt+Backspace" />
        <item name="fill_background" label="Fill with Background Color" shortcut="Ctrl+Backspace" />
        <Separator />
        <item name="add_mask" label="Add Mask" />
        <item name="apply_mask" label="Apply Mask" />
        <item name="remove_mask" label="Remove Mask" />
        <item name="extract_mask" label="Extract Mask" />
        <Separator />
        <item name="edit_mask" label="[ ] Edit Mask" />
      </menu>

      <menu name="view" label="View" mutable="true">
        <item name="window_mode" label="Maximize / Restore" />
        <item name="zoom_in" label="Zoom In" shortcut="Ctrl+Equals;Ctrl+Shift+Equals" />
        <item name="zoom_out" label="Zoom Out" shortcut="Ctrl+Minus" />
        <item name="zoom_fit" label="Fit on Screen" shortcut="Ctrl+0" />
        <Separator />
        <item name="zoom_1x" label="1x" />
        <item name="zoom_2x" label="2x" />
        <item name="zoom_4x" label="4x" />
        <item name="zoom_6x" label="6x" />
        <item name="zoom_8x" label="8x" />
        <Separator />
        <item name="show_grid" label="[ ] Show Grid" />
        <item name="snap_grid" label="[ ] Snap to Grid" />
        <item name="show_background" label="[x] Show Background" />
        <item name="mask_only" label="[ ] Mask Only View" />
        <Separator />
        <item name="grid_options" label="Grid Options..." />
      </menu>

      <menu name="window" label="Window" dynamic="true">
        <item name="tools" label="Tools" />
        <item name="colors" label="Colors" />
        <item name="layers" label="Layers" />
        <item name="timeline" label="Timeline" />
        <Separator />
      </menu>

      <menu name="anim" label="Anim">
        <item name="new_frame" label="New Frame" />
        <item name="duplicate_frame" label="Duplicate Frame" />
        <item name="delete_frame" label="Delete Frame" />
        <Separator />
        <item name="prev_frame" label="Previous Frame" shortcut="Page Up" />
        <item name="next_frame" label="Next Frame" shortcut="Page Down" />
        <Separator />
        <item name="play" label="Play" />
        <item name="stop" label="Stop" />
        <item name="loop" label="[ ] Loop" />
        <item name="onion_skin" label="Onion Skin Settings..." />
        <item name="trace" label="Trace Onion Skin" />
        <Separator />
        <item name="export_gif" label="Export GIF..." />
        <item name="export_apng" label="Export APNG..." />
        <item name="export_spritesheet" label="Export Sprite Sheet..." />
        <item name="set_fps" label="Set FPS..." />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>

      <menu name="color" label="Color">
        <item name="swap" label="Swap Colors" shortcut="X" />
      </menu>

      <menu name="tool" label="Tools">
        <item name="pencil" label="Pencil" shortcut="P;Shift+P" />
        <item name="brush" label="Brush" shortcut="B;Shift+B" />
        <item name="eraser" label="Eraser" shortcut="E;Shift+E" />
        <item name="fill" label="Fill" shortcut="K;Shift+K" />
        <item name="select" label="Select" shortcut="S;Shift+S" />
        <item name="hand" label="Hand" />
        <item name="zoom" label="Zoom" />
        <item name="line" label="Line" />
        <item name="rect" label="Rectangle" />
        <item name="ellipse" label="Ellipse" />
        <item name="rounded_rect" label="Rounded Rectangle" />
        <item name="polygon" label="Polygon" />
        <item name="spray" label="Spray" shortcut="A;Shift+A" />
        <item name="eyedropper" label="Eyedropper" shortcut="I;Shift+I" />
        <item name="magnifier" label="Magnifier" shortcut="G;Shift+G" />
        <item name="text" label="Text" shortcut="T;Shift+T" />
        <item name="crop" label="Crop" shortcut="C;Shift+C" />
        <item name="magic_wand" label="Magic Wand" shortcut="W;Shift+W" />
        <item name="move" label="Move" shortcut="V;Shift+V" />
      </menu>
    </menus>

    <forms>
      <form name="main_toolbar" title="Toolbar" width="1" height="1">
        <Toolbar>
        <Button name="new" command="file.new" icon="page-plus" text="New" tooltip="New image" />
        <Button name="open" command="file.open" icon="folder" text="Open" tooltip="Open image" />
        <Button name="save" command="file.save" icon="floppy-disk" text="Save" tooltip="Save image" />
        <Button name="saveas" command="file.saveas" icon="download" text="Save As" tooltip="Save image as..." />
        <spacer w="10" />
        <Button name="undo" command="edit.undo" icon="undo" text="Undo" tooltip="Undo" />
        <Button name="redo" command="edit.redo" icon="redo" text="Redo" tooltip="Redo" />
        <spacer w="10" />
        <Button name="zoom_out" command="view.zoom_out" icon="zoom-out" text="Zoom Out" tooltip="Zoom out" />
        <Button name="zoom_in" command="view.zoom_in" icon="zoom-in" text="Zoom In" tooltip="Zoom in" />
        <Button name="zoom_1x" command="view.zoom_1x" icon="frame" text="1x" tooltip="Zoom to 100%" />
        <Button name="window_mode" command="view.window_mode" icon="lucide-copy" text="Window" tooltip="Maximize / Restore window" />
        <Button name="zoom_fit" command="view.zoom_fit" icon="expand" text="Fit" tooltip="Fit on screen" />
        <spacer w="10" />
        <Button name="show_background" command="view.show_background" icon="eye" flags="BUTTON_PUSHLIKE" text="BG" tooltip="Toggle background" />
        <Button name="mask_only" command="view.mask_only" icon="square-dashed" flags="BUTTON_PUSHLIKE" text="Mask" tooltip="Toggle mask view" />
        </Toolbar>
      </form>

      <form name="new_image" title="New Image" width="180" spacing="8" padding="8">
        <GridView name="fields" spacing="4">
          <Column name="labels" width="48">
            <Label name="lbl_width" text="Width:" />
            <Label name="lbl_height" text="Height:" />
          </Column>
          <Column name="inputs">
            <TextBox name="width" text="" />
            <TextBox name="height" text="" />
          </Column>
        </GridView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="image_resize" title="Image Size" width="210" spacing="8" padding="8">
        <GridView name="fields" spacing="4">
          <Column name="labels" width="48">
            <Label name="lbl_width" text="Width:" />
            <Label name="lbl_height" text="Height:" />
            <Label name="lbl_filter" text="Filter:" />
          </Column>
          <Column name="inputs">
            <TextBox name="width" text="" />
            <TextBox name="height" text="" />
            <ComboBox name="filter" text="" />
          </Column>
        </GridView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="grid_options" title="Grid Options" width="180" spacing="8" padding="8">
        <GridView name="fields" spacing="4">
          <Column name="labels" width="48">
            <Label name="lbl_width" text="Width:" />
            <Label name="lbl_height" text="Height:" />
          </Column>
          <Column name="inputs">
            <TextBox name="width" text="" />
            <TextBox name="height" text="" />
          </Column>
        </GridView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="selection_modify" title="Modify Selection" width="180" spacing="8" padding="8">
        <StackView name="amount_row" orientation="horizontal" spacing="6">
          <Label name="lbl_amount" text="By:" />
          <TextBox name="amount" text="" />
          <Label name="lbl_pixels" text="pixels" />
        </StackView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="new_layer" title="New Layer" width="200" spacing="8" padding="8">
        <StackView name="fill_row" orientation="horizontal" spacing="6">
          <Label name="lbl_fill" text="Fill with:" />
          <ComboBox name="combo_fill" text="" />
        </StackView>
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="add_mask" title="Add Mask" width="220" spacing="8" padding="8">
        <StackView name="fill_row" orientation="horizontal" spacing="6">
          <Label name="lbl_fill" text="Fill with:" />
          <ComboBox name="combo_fill" text="" />
        </StackView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="text_tool" title="Insert Text" width="220" spacing="6" padding="8">
        <StackView name="text_row" orientation="horizontal" spacing="6">
          <Label name="lbl_text" text="Text:" />
          <TextBox name="edit_text" text="" />
        </StackView>
        <StackView name="size_row" orientation="vertical" spacing="2">
          <Label name="lbl_size" text="Size: 16px" />
          <Slider name="size" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        </StackView>
        <StackView name="color_row" orientation="horizontal" spacing="6">
          <Label name="lbl_color" text="Color:" />
          <Space name="swatch" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <Button name="btn_color" text="Change..." />
          <CheckBox name="chk_aa" text="Anti-alias" />
        </StackView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="btn_ok" text="OK" />
          <Button name="btn_cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="levels" title="Levels" width="280" height="236" spacing="6" padding="10">
        <requires library="imageeditor_components" />
        <GridView name="input_row" spacing="6">
          <Column name="in_label_col" width="88">
            <Label name="in_label" text="Input Levels:" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          </Column>
          <Column name="in_fields_col">
            <GridView name="in_fields" spacing="4">
              <Column name="in_black_col">
                <TextBox name="in_black" text="0" />
              </Column>
              <Column name="in_gamma_col">
                <TextBox name="in_gamma" text="1.00" />
              </Column>
              <Column name="in_white_col">
                <TextBox name="in_white" text="255" />
              </Column>
            </GridView>
          </Column>
        </GridView>
        <lv_histogram name="graph" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <Slider name="in_slider" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <GridView name="output_row" spacing="6">
          <Column name="out_label_col" width="88">
            <Label name="out_label" text="Output Levels:" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          </Column>
          <Column name="out_fields_col">
            <GridView name="out_fields" spacing="4">
              <Column name="out_black_col">
                <TextBox name="out_black" text="0" />
              </Column>
              <Column name="out_white_col">
                <TextBox name="out_white" text="255" />
              </Column>
            </GridView>
          </Column>
        </GridView>
        <Gradient name="out_grad" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <Slider name="out_slider" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <CheckBox name="preview" text="Preview" />
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" />
          <Button name="reset" text="Reset" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="filter_gallery" title="Filter Gallery" width="560" height="360" flags="WINDOW_DIALOG | WINDOW_NOTRAYBUTTON" padding="8">
        <requires library="imageeditor_components" />
        <GridView name="main" spacing="8">
          <Column name="preview_col">
            <filter_preview name="preview" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
            <Label name="filter_name" text="No filters loaded" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          </Column>
          <Column name="filters_col">
            <IconGrid name="filters" text="" flags="WINDOW_NOTITLE | WINDOW_NORESIZE | WINDOW_VSCROLL | WINDOW_FLEXSPACE" />
          </Column>
        </GridView>
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="blur_dialog" title="Blur" width="240" flags="WINDOW_DIALOG | WINDOW_NOTRAYBUTTON" spacing="6" padding="10">
        <StackView name="amount_row" orientation="vertical" spacing="2">
          <Label name="amount_label" text="Blur: 4px" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          <Slider name="amount" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        </StackView>
        <CheckBox name="preview" text="Preview" />
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="onion_skin" title="Onion Skin" width="276" height="142" spacing="6" padding="8">
        <CheckBox name="enabled" text="Enable Onion Skin" />
        <Label name="selected_label" text="Selected: Previous 1 (50%)" />
        <StackView name="prev_row" orientation="horizontal" spacing="4">
          <Label name="prev_label" text="Prev" width="30" />
          <Button name="prev1" text="50%" width="44" flags="BUTTON_PUSHLIKE" />
          <Button name="prev2" text="25%" width="44" flags="BUTTON_PUSHLIKE" />
          <Button name="prev3" text="12.5%" width="44" flags="BUTTON_PUSHLIKE" />
          <Button name="prev4" text="0%" width="44" flags="BUTTON_PUSHLIKE" />
        </StackView>
        <StackView name="next_row" orientation="horizontal" spacing="4">
          <Label name="next_label" text="Next" width="30" />
          <Button name="next1" text="50%" width="44" flags="BUTTON_PUSHLIKE" />
          <Button name="next2" text="25%" width="44" flags="BUTTON_PUSHLIKE" />
          <Button name="next3" text="12.5%" width="44" flags="BUTTON_PUSHLIKE" />
          <Button name="next4" text="0%" width="44" flags="BUTTON_PUSHLIKE" />
        </StackView>
        <StackView name="value_row" orientation="vertical" spacing="2">
          <Label name="value_label" text="Opacity: 50%" />
          <Slider name="value" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        </StackView>
        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="about" title="About Orion Image Editor" width="270" height="120" orientation="horizontal" spacing="8" padding="0">
        <Image name="banner" width="120" height="120" />
        <StackView name="info" spacing="2" padding="0 8 4 4">
          <Label name="title" text="Orion Image Editor" font="system" />
          <Label name="version" text="Version 1.0" color="text-disabled" />
          <Label name="desc1" text="A MacPaint-inspired" color="text-disabled" />
          <Label name="desc2" text="pixel art editor." color="text-disabled" />
          <Label name="desc3" text="Built with the" color="text-disabled" />
          <Label name="desc4" text="Orion UI framework." color="text-disabled" />
          <Space name="spacer" />
          <StackView name="actions" orientation="horizontal" spacing="6">
            <Space name="flex" />
            <Button name="ok" text="OK" width="50" flags="BUTTON_DEFAULT" />
          </StackView>
        </StackView>
      </form>

      <form name="color_picker" title="Edit Color" width="240" spacing="0" padding="0">
        <cp_surface name="surface" width="240" height="104" />
        <StackView name="actions" orientation="horizontal" spacing="2">
          <Button name="ok" text="OK" width="40" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" width="48" />
          <Button name="add_palette" text="+ Palette" width="62" />
          <Space name="flex" />
        </StackView>
      </form>
    </forms>
</orion>
