<orion>
  <databases>
    <database name="lodge_remote_cache" class="db_schema_xml">
      <table name="rooms" transient="true"><field name="id" type="integer" key="YES"/><field name="name" type="string" length="40"/><field name="cleaning_state" type="string" length="24"/></table>
      <table name="guests" transient="true"><field name="id" type="integer" key="YES"/><field name="name" type="string" length="100"/></table>
      <table name="groups" transient="true"><field name="id" type="integer" key="YES"/><field name="name" type="string" length="100"/></table>
      <table name="reservations" transient="true"><field name="id" type="integer" key="YES"/><field name="choice" type="string" length="180"/><field name="room_name" type="string" length="40"/><field name="guest_name" type="string" length="100"/><field name="arrival" type="date"/><field name="departure" type="date"/><field name="status" type="string" length="20"/><field name="balance" type="double"/></table>
    </database>
  </databases>
  <application runtime-api="1" name="lodge_remote" form="remote" />
  <forms>
    <form name="remote" controller="remote" title="Lodge · Shared server" width="1180" height="850" padding="12" spacing="8">
      <Label text="Shared hotel reception" font="title"/><Label name="connection"/><Label name="notice"/><Label name="error"/>
      <StackView orientation="horizontal" spacing="6"><Button name="connect" text="Connect or refresh" action="connect"/><Button name="retry" text="Retry pending request" action="retry"/></StackView>
      <TabView name="sections" flags="flexspace"><StackView name="reception_tab" text="Reception" spacing="6" flags="flexspace">
      <Separator/><Label text="Rooms and guests" font="heading"/>
      <GridView spacing="4"><Column width="auto"><Label text="Room name:"/><Label text="Category:"/><Label text="Capacity:"/><Label text="Nightly rate:"/><Label text="Guest name:"/><Label text="Phone:"/></Column><Column>
        <TextBox name="room_name"/><TextBox name="room_category"/><TextBox name="capacity" type="integer"/><TextBox name="room_rate" type="number" decimals="2"/><TextBox name="guest_name"/><TextBox name="phone"/>
      </Column></GridView>
      <StackView orientation="horizontal" spacing="6"><Button name="add_room" text="Add room" action="add_room"/><Button name="add_guest" text="Add guest" action="add_guest"/></StackView>
      <StackView orientation="horizontal" spacing="6"><Label text="Room to edit:"/><ComboBox name="edit_room_choice" source="lodge_remote_cache.rooms" display="name" value="id"/><Button name="load_room" text="Load room" action="load_room"/><Button name="save_room" text="Save room" action="save_room"/><Label name="room_editor"/></StackView>
      <StackView orientation="horizontal" spacing="6"><Label text="Guest to edit:"/><ComboBox name="edit_guest_choice" source="lodge_remote_cache.guests" display="name" value="id"/><Button name="load_guest" text="Load guest" action="load_guest"/><Button name="save_guest" text="Save guest" action="save_guest"/><Label name="guest_editor"/></StackView>
      <StackView orientation="horizontal" spacing="6"><Label text="Room:"/><ComboBox name="clean_room" source="lodge_remote_cache.rooms" display="name" value="id"/><Button name="mark_clean" text="Mark clean" action="mark_clean"/><Button name="mark_dirty" text="Mark dirty" action="mark_dirty"/><Button name="mark_inspection" text="Needs inspection" action="mark_inspection"/></StackView>
      <Separator/><Label name="editor" font="heading"/>
      <GridView spacing="4"><Column width="auto"><Label text="Room:"/><Label text="Guest:"/><Label text="Arrival:"/><Label text="Departure:"/><Label text="Guests:"/><Label text="Nightly rate:"/><Label text="Extra charges:"/><Label text="Notes:"/></Column><Column>
        <ComboBox name="room" source="lodge_remote_cache.rooms" display="name" value="id"/><ComboBox name="guest" source="lodge_remote_cache.guests" display="name" value="id"/>
        <TextBox name="arrival" type="date"/><TextBox name="departure" type="date"/><TextBox name="persons" type="integer"/><TextBox name="rate" type="number" decimals="2"/><TextBox name="extras" type="number" decimals="2"/><TextBox name="notes"/>
      </Column></GridView>
      <StackView orientation="horizontal" spacing="6"><Button name="reserve" text="Save reservation" action="reserve" flags="BUTTON_DEFAULT"/><Button name="new_booking" text="New reservation" action="new_booking"/><Button name="edit_booking" text="Edit selected reservation" action="edit_booking"/></StackView>
      <StackView name="lists" orientation="horizontal" spacing="8" flags="flexspace">
      <TableView name="room_status" source="lodge_remote_cache.rooms" flags="flexspace,vscroll" frame="true">
        <Column field="name" title="Room" width="0"/><Column field="cleaning_state" title="Cleaning status" width="150"/>
      </TableView>
      <TableView name="bookings" source="lodge_remote_cache.reservations" flags="flexspace,vscroll" frame="true">
        <Column field="room_name" title="Room" width="90"/><Column field="guest_name" title="Guest" width="0" min-width="140"/><Column field="arrival" title="Arrival" width="100"/><Column field="departure" title="Departure" width="100"/><Column field="status" title="Status" width="110"/><Column field="balance" title="Balance" width="100"/>
      </TableView>
      </StackView>
      <StackView orientation="horizontal" spacing="6"><Button name="check_in" text="Check in" action="check_in"/><Button name="check_out" text="Check out" action="check_out"/><Button name="cancel" text="Cancel reservation" action="cancel"/><Button name="confirmation" text="Export confirmation" action="confirmation"/></StackView>
      <StackView orientation="horizontal" spacing="6"><TextBox name="amount" type="number" decimals="2"/><Button name="pay" text="Record payment" action="pay"/><Button name="refund" text="Record refund" action="refund"/><Button name="new_payment" text="New payment or refund" action="new_payment"/><Label name="payment_status"/></StackView>
      </StackView><StackView name="group_tab" text="Group" spacing="6" flags="flexspace">
      <Separator/><Label text="Two-room group" font="heading"/>
      <GridView spacing="4"><Column width="auto"><Label text="Group name:"/><Label text="Guest:"/><Label text="Arrival:"/><Label text="Departure:"/></Column><Column>
        <TextBox name="group_name"/><ComboBox name="group_guest" source="lodge_remote_cache.guests" display="name" value="id"/><TextBox name="group_arrival" type="date"/><TextBox name="group_departure" type="date"/>
      </Column><Column width="auto"><Label text="First room:"/><Label text="Guests:"/><Label text="Nightly rate:"/></Column><Column>
        <ComboBox name="group_room1" source="lodge_remote_cache.rooms" display="name" value="id"/><TextBox name="group_persons1" type="integer"/><TextBox name="group_rate1" type="number" decimals="2"/>
      </Column><Column width="auto"><Label text="Second room:"/><Label text="Guests:"/><Label text="Nightly rate:"/></Column><Column>
        <ComboBox name="group_room2" source="lodge_remote_cache.rooms" display="name" value="id"/><TextBox name="group_persons2" type="integer"/><TextBox name="group_rate2" type="number" decimals="2"/>
      </Column></GridView>
      <Button name="group_reserve" text="Create group reservations" action="group_reserve"/>
      <Separator/><Label text="Group reservation statement" font="heading"/>
      <StackView orientation="horizontal" spacing="6"><Label text="Group:"/><ComboBox name="statement_group" source="lodge_remote_cache.groups" display="name" value="id"/><Button name="group_statement" text="Export group statement" action="group_statement"/></StackView>
      </StackView><StackView name="night_tab" text="Nightly prices" spacing="6" flags="flexspace">
      <Separator/><Label text="Selected reservation: nightly price" font="heading"/>
      <StackView orientation="horizontal" spacing="6"><ComboBox name="night_booking" source="lodge_remote_cache.reservations" display="choice" value="id"/><Label text="Night:"/><TextBox name="night" type="date"/><Label text="Price:"/><TextBox name="night_amount" type="number" decimals="2"/><Button name="set_night" text="Set price" action="set_night"/><Button name="reset_night" text="Restore base price" action="reset_night"/></StackView>
      </StackView><StackView name="day_tab" text="Day close" spacing="6" flags="flexspace">
      <Separator/><Label text="Operational day" font="heading"/><Label name="day_report"/><Label name="cancelled_paid_report"/>
      <StackView orientation="horizontal" spacing="6"><Button name="preview_day" text="Preview day" action="preview_day"/><Button name="close_day" text="Close day" action="close_day"/></StackView>
      </StackView></TabView>
    </form>
  </forms>
</orion>
