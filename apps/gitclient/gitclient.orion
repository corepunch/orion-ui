<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="gitclient"
    title="Git Client"
    root="apps/gitclient">

    <menus var="kGCMenus" count="kGCMenuCount">
        <menu name="file" label="File">
            <item name="open_repo" label="Open Repository..." />
            <item name="repositories" label="Repositories..." />
            <item name="new_repo" label="Create Repository..." />
            <item name="clone" label="Clone..." shortcut="Ctrl+Shift+N" />
            <Separator />
            <item name="quit" label="Exit" />
        </menu>

        <menu name="repo" label="Repo">
            <item name="refresh" label="Refresh" shortcut="F5" />
            <item name="search" label="Search..." shortcut="Ctrl+Shift+F" />
            <item name="identity" label="Git Identity..." />
            <item name="terminal" label="Open Terminal Here" />
        </menu>

        <menu name="view" label="View">
            <item name="window_mode" label="Maximize / Restore" />
            <item name="changes" label="Changes" shortcut="Ctrl+1" />
            <item name="history" label="History" shortcut="Ctrl+2" />
            <item name="github" label="GitHub" shortcut="Ctrl+3" />
        </menu>

        <menu name="branch" label="Branch">
            <item name="new" label="New Branch..." shortcut="Ctrl+N" />
            <item name="checkout" label="Checkout..." shortcut="Ctrl+P" />
            <Separator />
            <item name="merge" label="Merge Into Current" shortcut="Ctrl+M" />
            <item name="rebase" label="Rebase Current" />
            <Separator />
            <item name="delete" label="Delete..." shortcut="Ctrl+D" />
            <item name="rename" label="Rename..." />
        </menu>

        <menu name="commit" label="Commit">
            <item name="commit" label="Commit..." shortcut="Ctrl+K" />
            <item name="amend" label="Amend Last Commit" />
            <item name="undo" label="Undo Last Commit" />
            <Separator />
            <item name="stash" label="Stash Changes" />
            <item name="stash_pop" label="Pop Stash" />
            <item name="stash_drop" label="Drop Stash..." />
            <Separator />
            <item name="discard" label="Discard Changes..." />
        </menu>

        <menu name="files" label="Files">
            <item name="stage" label="Stage" />
            <item name="unstage" label="Unstage" />
            <Separator />
            <item name="stage_all" label="Stage All" shortcut="Ctrl+Shift+A" />
            <item name="unstage_all" label="Unstage All" />
            <Separator />
            <item name="reveal" label="Reveal in File Manager" />
            <item name="discard" label="Discard..." />
        </menu>

        <menu name="remote" label="Remote">
            <item name="sync" label="Sync Current Branch" />
            <Separator />
            <item name="fetch" label="Fetch" shortcut="Ctrl+F" />
            <item name="pull" label="Pull..." />
            <item name="push" label="Push..." />
            <Separator />
            <item name="manage" label="Manage Remotes..." />
        </menu>

        <menu name="tag" label="Tag">
            <item name="create" label="Create Tag..." />
            <item name="delete" label="Delete Tag..." />
            <Separator />
            <item name="push" label="Push Tags" />
        </menu>

        <menu name="help" label="Help">
            <item name="about" label="About Git Client" />
        </menu>
    </menus>

    <contextMenus>
        <contextMenu name="branches">
            <item command="branch.checkout" label="Checkout" />
            <item command="branch.merge" label="Merge Into Current" />
            <Separator />
            <item command="branch.delete" label="Delete" />
        </contextMenu>
        <contextMenu name="tags">
            <item command="tag.delete" label="Delete Tag" />
        </contextMenu>
        <contextMenu name="stash">
            <item command="commit.stash_pop" label="Pop" />
            <item command="commit.stash_drop" label="Drop" />
        </contextMenu>
        <contextMenu name="files">
            <item command="files.stage" label="Stage" />
            <item command="files.unstage" label="Unstage" />
            <Separator />
            <item command="files.stage_all" label="Stage All" />
            <item command="files.unstage_all" label="Unstage All" />
            <Separator />
            <item command="files.reveal" label="Reveal in File Manager" />
            <item command="files.discard" label="Discard" />
        </contextMenu>
    </contextMenus>

    <databases>
        <database name="db" class="gitclient_db">
            <table name="branches">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="hash" type="string" length="41"/>
                <field name="is_current" type="bool"/>
                <field name="is_remote" type="bool"/>
            </table>

            <table name="commits">
                <field name="id" type="integer" key="YES"/>
                <field name="branch_id" type="integer" relation="branches.id"/>
                <field name="hash" type="string" length="41"/>
                <field name="author" type="string" length="64"/>
                <field name="date" type="string" length="20"/>
                <field name="subject" type="string" length="256"/>
            </table>

            <table name="files">
                <field name="id" type="integer" key="YES"/>
                <field name="commit_id" type="integer" relation="commits.id"/>
                <field name="path" type="string" length="512"/>
                <field name="status" type="string" length="2"/>
                <field name="staged" type="bool"/>
            </table>

            <table name="diff">
                <field name="id" type="integer" key="YES"/>
                <field name="content" type="string" length="262144"/>
            </table>

            <table name="tags">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="hash" type="string" length="41"/>
                <field name="date" type="string" length="20"/>
            </table>

            <table name="stash">
                <field name="id" type="integer" key="YES"/>
                <field name="ref" type="string" length="64"/>
                <field name="message" type="string" length="512"/>
                <field name="branch" type="string" length="256"/>
            </table>

            <table name="remotes">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="url" type="string" length="512"/>
            </table>
        </database>

        <database name="github_db" class="github_database_proc">
            <table name="issues">
                <field name="id" type="integer" key="YES"/>
                <field name="number" type="integer"/>
                <field name="title" type="string" length="256"/>
                <field name="state" type="string" length="16"/>
                <field name="author" type="string" length="64"/>
                <field name="created_at" type="string" length="32"/>
            </table>

            <table name="pulls">
                <field name="id" type="integer" key="YES"/>
                <field name="number" type="integer"/>
                <field name="title" type="string" length="256"/>
                <field name="state" type="string" length="16"/>
                <field name="author" type="string" length="64"/>
                <field name="base" type="string" length="64"/>
            </table>
        </database>
    </databases>

    <plugins>
        <plugin name="gitclient_components" />
    </plugins>

    <forms>
        <!-- Main window shell: just the chrome + TabView with empty tab slots.
             Each slot is filled at runtime by create_window_from_form() with the
             corresponding page sub-form. -->
        <form name="main_window"
              title="Git Client"
              width="960" height="640"
              role="host"
              flags="toolbar,statusbar">
            <TabView name="views" flags="notitle,nofill,flexspace">
                <StackView name="changes_tab" text="Changes" flags="notitle,nofill,flexspace" />
                <StackView name="history_tab" text="History" flags="notitle,nofill,flexspace" />
                <StackView name="github_tab"  text="GitHub"  flags="notitle,nofill,flexspace" />
            </TabView>
        </form>

        <!-- Changes page: file list + inline commit panel on left, diff on right. -->
        <form name="changes_page" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <Toolbar>
                <Button name="sync"        command="remote.sync"        icon="data-transfer-both"  text="Sync"       tooltip="Publish, pull, or push the current branch" />
                <Button name="fetch"       command="remote.fetch"       icon="git-fetch"           text="Fetch"      tooltip="Fetch from remote" />
                <spacer />
                <Button name="commit"      command="commit.commit"      icon="git-commit"          text="Commit"     tooltip="Commit staged changes" />
                <Button name="undo"        command="commit.undo"        icon="undo"                text="Undo"       tooltip="Undo last commit and keep changes staged" />
                <Button name="stage_all"   command="files.stage_all"    icon="arrow-up"            text="Stage All"  tooltip="Stage all changes" />
                <Button name="unstage_all" command="files.unstage_all"  icon="arrow-down"          text="Unstage All" tooltip="Unstage all changes" />
                <Button name="branch"      command="branch.new"         icon="git-fork"            text="Branch"     tooltip="Create new branch" />
                <spacer />
                <Button name="refresh"     command="repo.refresh"       icon="refresh"             text="Refresh"    tooltip="Refresh repository" />
                <Button name="repos"       command="file.repositories"  icon="git-repos"           text="Repos"      tooltip="Switch or discover repositories" />
            </Toolbar>
            <requires library="gitclient_components" />
            <SplitView name="changes_split" flags="flexspace">
                <StackView name="changes_panel" spacing="4" padding="4">
                    <TableView name="changes_files"
                               source="db.files"
                               master="none"
                               check-field="staged"
                               context-menu="files"
                               flags="notitle,nofill,vscroll,flexspace">
                        <Column field="path" title="File" width="0" />
                        <Column field="status" title="Status" width="64" />
                    </TableView>
                    <Label name="commit_hint" text="Commit staged changes" />
                    <TextEdit name="commit_summary" text="" />
                    <TextEdit name="commit_description" text="" />
                    <StackView name="commit_actions" orientation="horizontal" spacing="4">
                        <Button name="stash_inline" text="Stash" />
                        <Space />
                        <Button name="commit_now" text="Commit" flags="default" />
                    </StackView>
                </StackView>
                <DiffView name="changes_diff" flags="notitle,nofill,vscroll,flexspace"/>
            </SplitView>
        </form>

        <!-- History page: branches/tags/stash sidebar, log + files + diff. -->
        <form name="history_page" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <Toolbar>
                <Button name="sync"        command="remote.sync"        icon="data-transfer-both"  text="Sync"       tooltip="Publish, pull, or push the current branch" />
                <Button name="fetch"       command="remote.fetch"       icon="git-fetch"           text="Fetch"      tooltip="Fetch from remote" />
                <spacer />
                <Button name="branch"      command="branch.new"         icon="git-fork"            text="Branch"     tooltip="Create new branch" />
                <Button name="search"      command="repo.search"        icon="search"              text="Search"     tooltip="Search repository history" />
                <spacer />
                <Button name="refresh"     command="repo.refresh"       icon="refresh"             text="Refresh"    tooltip="Refresh repository" />
                <Button name="repos"       command="file.repositories"  icon="git-repos"           text="Repos"      tooltip="Switch or discover repositories" />
            </Toolbar>
            <requires library="gitclient_components" />
            <SplitView name="history_main_split" flags="flexspace">
                <SplitView name="left_split" orientation="vertical" flags="flexspace" width="180">
                    <TableView name="branches" source="db.branches" context-menu="branches"
                               flags="notitle,nofill,vscroll">
                        <Column field="name" title="" width="0" />
                    </TableView>
                    <TableView name="tags" source="db.tags" context-menu="tags"
                               flags="notitle,nofill,vscroll">
                        <Column field="name" title="Tag" width="0" />
                        <Column field="date" title="Date" width="80" />
                    </TableView>
                    <TableView name="stash_list" source="db.stash" context-menu="stash"
                               flags="notitle,nofill,vscroll">
                        <Column field="message" title="Stash" width="0" />
                        <Column field="branch" title="Branch" width="80" />
                    </TableView>
                </SplitView>
                <SplitView name="history_content_split" flags="flexspace">
                    <SplitView name="log_files_split" orientation="vertical" flags="flexspace">
                        <TableView name="log" source="db.commits" cell-style="two-line"
                                   flags="notitle,nofill,vscroll,flexspace">
                            <Column field="subject" title="Subject" width="0" min-width="120" />
                            <Column field="author" title="Author" width="0" />
                            <Column field="date" title="Date" width="0" />
                        </TableView>
                        <TableView name="history_files" source="db.files" master="log"
                                   flags="notitle,nofill,vscroll,flexspace">
                            <Column field="path" title="File" width="0" />
                            <Column field="status" title="Status" width="64" />
                        </TableView>
                    </SplitView>
                    <DiffView name="history_diff" flags="notitle,nofill,vscroll,flexspace"/>
                </SplitView>
            </SplitView>
        </form>

        <!-- GitHub page: issues on top, pull requests on bottom. -->
        <form name="github_page" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <Toolbar>
                <Button name="refresh" command="repo.refresh" icon="refresh" text="Refresh" tooltip="Refresh GitHub data" />
                <Button name="repos" command="file.repositories" icon="git-repos" text="Repos" tooltip="Switch or discover repositories" />
            </Toolbar>
            <SplitView name="github_split" orientation="vertical" flags="flexspace">
                <StackView name="issues_panel" spacing="4" padding="4">
                    <Label text="Issues" />
                    <TableView name="issues" source="github_db.issues"
                               flags="notitle,nofill,vscroll,flexspace">
                        <Column field="number" title="#" width="40" />
                        <Column field="title" title="Title" width="0" />
                        <Column field="state" title="State" width="64" />
                        <Column field="author" title="Author" width="100" />
                        <Column field="created_at" title="Opened" width="100" />
                    </TableView>
                </StackView>
                <StackView name="pulls_panel" spacing="4" padding="4">
                    <Label text="Pull Requests" />
                    <TableView name="pulls" source="github_db.pulls"
                               flags="notitle,nofill,vscroll,flexspace">
                        <Column field="number" title="#" width="40" />
                        <Column field="title" title="Title" width="0" />
                        <Column field="state" title="State" width="64" />
                        <Column field="author" title="Author" width="100" />
                        <Column field="base" title="Base" width="80" />
                    </TableView>
                </StackView>
            </SplitView>
        </form>

        <form name="commit_dialog"
              title="Commit"
              width="324"
              auto_layout="1"
              spacing="6"
              padding="8">
            <Label text="Message:" />
            <MultiEdit name="msg" flags="vscroll,flexspace" />
            <StackView orientation="horizontal" spacing="6">
                <CheckBox name="amend" text="Amend last commit" />
                <Space />
                <Button name="ok" text="Commit" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="new_branch_dialog"
              title="New Branch"
              width="276"
              auto_layout="1"
              spacing="6"
              padding="8">
            <StackView orientation="horizontal" spacing="6">
                <Label text="Name:" />
                <TextEdit name="name" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Label text="From:" />
                <ComboBox name="from" flags="flexspace" control-size="regular" source="db.branches" display="name" value="name" filter_field="is_remote" filter_value="0" />
            </StackView>
            <CheckBox name="checkout" text="Checkout after creation" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Create" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="branch_rename_dialog"
              title="Rename Branch"
              width="276"
              auto_layout="1"
              spacing="6"
              padding="8">
            <StackView orientation="horizontal" spacing="6">
                <Label text="New name:" />
                <TextEdit name="name" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Rename" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="clone_dialog"
              title="Clone Repository"
              width="420"
              auto_layout="1"
              spacing="6"
              padding="8">
            <StackView orientation="horizontal" spacing="6">
                <Label text="URL:" />
                <TextEdit name="url" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Label text="Path:" />
                <TextEdit name="path" flags="flexspace" />
                <Button name="browse" text="..." />
            </StackView>
            <Label name="status" text="" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Clone" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="remote_dialog"
              title="Manage Remotes"
              width="400"
              height="320"
              auto_layout="1"
              spacing="6"
              padding="8">
            <Label text="Remotes:" />
            <ComboBox name="remote_list" flags="flexspace" />
            <StackView orientation="horizontal" spacing="6">
                <Label text="Name:" />
                <TextEdit name="name" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Label text="URL:" />
                <TextEdit name="url" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Button name="add" text="Add" />
                <Button name="update" text="Update" />
                <Button name="remove" text="Remove" />
                <Space />
                <Button name="close" text="Close" flags="default" />
            </StackView>
        </form>
        <form name="search_dialog"
              title="Search"
              width="320"
              auto_layout="1"
              spacing="6"
              padding="8">
            <Label text="Search commits, branches, files:" />
            <TextEdit name="query" flags="flexspace" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Search" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="conflict_dialog"
              title="Merge Conflicts"
              width="400"
              height="280"
              auto_layout="1"
              spacing="6"
              padding="8">
            <Label text="Conflicted files:" />
            <ComboBox name="file_list" flags="flexspace" />
            <StackView orientation="horizontal" spacing="6">
                <Button name="ours" text="Accept Ours" flags="default" />
                <Button name="theirs" text="Accept Theirs" />
                <Button name="both" text="Accept Both" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="abort" text="Abort Merge" />
                <Button name="close" text="Close" />
            </StackView>
        </form>

        <form name="create_tag_dialog"
              title="Create Tag"
              width="320"
              auto_layout="1"
              spacing="6"
              padding="8">
            <StackView orientation="horizontal" spacing="6">
                <Label text="Name:" />
                <TextEdit name="name" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Label text="Ref:" />
                <TextEdit name="ref" flags="flexspace" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Create" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="push_pull_dialog"
              title="Remote Operation"
              width="262"
              auto_layout="1"
              spacing="6"
              padding="8">
            <StackView orientation="horizontal" spacing="6">
                <Label text="Remote:" />
                <ComboBox name="remote" flags="flexspace" source="db.remotes" display="name" value="name" />
            </StackView>
            <StackView orientation="horizontal" spacing="6">
                <Label text="Branch:" />
                <ComboBox name="branch" flags="flexspace" source="db.branches" display="name" value="name" filter_field="is_remote" filter_value="0" />
            </StackView>
            <CheckBox name="prune" text="Prune deleted remote branches" />
            <CheckBox name="force" text="Force" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="OK" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="repositories_dialog" title="Repositories" width="276" auto_layout="1" spacing="6" padding="8">
            <Label text="Known repositories:" />
            <ComboBox name="repo_list" />
            <StackView orientation="horizontal" spacing="4">
                <Button name="add" text="Add..." />
                <Button name="scan" text="Scan Folder..." />
                <Button name="remove" text="Remove" />
            </StackView>
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="open" text="Open" flags="default" />
                <Button name="close" text="Close" />
            </StackView>
        </form>

        <form name="create_repo_dialog" title="Create Repository" width="500" auto_layout="1" spacing="6" padding="8">
            <Label text="Repository folder:" />
            <StackView orientation="horizontal" spacing="4">
                <TextEdit name="path" flags="flexspace" />
                <Button name="browse" text="Choose..." />
            </StackView>
            <Label name="status" text="The folder will be created and initialized with branch main." />
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="ok" text="Create" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="identity_dialog" title="Git Identity" width="460" auto_layout="1" spacing="6" padding="8">
            <Label text="Name:" />
            <TextEdit name="name" />
            <Label text="Email:" />
            <TextEdit name="email" />
            <CheckBox name="global" text="Use for all repositories" />
            <Label name="status" text="Stored in this repository unless global is selected." />
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="ok" text="Save" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>

        <form name="switch_branch_dialog" title="Switch Branch" width="440" auto_layout="1" spacing="6" padding="8">
            <Label text="Find a branch:" />
            <TextEdit name="query" />
            <ComboBox name="branches" flags="flexspace" />
            <StackView orientation="horizontal" spacing="4">
                <Button name="new_branch" text="New Branch..." />
                <Space />
                <Button name="ok" text="Switch" flags="default" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
    </forms>
</orion>
