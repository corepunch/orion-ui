<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="gitclient"
    title="Git Client"
    root="apps/gitclient"
    stylesheet="gitclient.css">

    <menus var="kGCMenus" count="kGCMenuCount">
        <menu name="file" label="File">
            <item name="open_repo" label="Open Repository..." />
            <item name="open_workspace" label="Open Workspace..." shortcut="Ctrl+O" />
            <item name="save_workspace" label="Save Workspace..." shortcut="Ctrl+S" />
            <item name="repositories" label="Repositories..." />
            <item name="remove_repo" label="Remove from Workspace" />
            <item name="new_repo" label="Create Repository..." />
            <item name="clone" label="Clone..." shortcut="Ctrl+Shift+N" />
            <Separator />
            <item name="quit" label="Exit" />
        </menu>

        <menu name="repo" label="Repo">
            <item name="refresh" label="Refresh" shortcut="F5" />
            <item name="search" label="Search..." shortcut="Ctrl+Shift+F" />
            <item name="identity" label="Git Identity..." />
            <item name="terminal" label="Open Terminal Here" />
        </menu>

        <menu name="view" label="View">
            <item name="window_mode" label="Maximize / Restore" />
            <item name="overview" label="Overview" shortcut="Ctrl+0" />
            <item name="changes" label="Changes" shortcut="Ctrl+1" />
            <item name="history" label="History" shortcut="Ctrl+2" />
            <item name="github" label="GitHub" shortcut="Ctrl+3" />
            <item name="agents" label="Agents" shortcut="Ctrl+4" />
            <Separator />
            <item name="all_commits" label="All Commits" />
            <item name="reflog" label="Reflog" />
            <item name="worktrees" label="Worktrees" />
            <item name="split_diff" label="Side-by-Side Diff" />
            <Separator />
            <item name="next_pane" label="Focus Next Pane" shortcut="Ctrl+Alt+Tab" />
            <item name="next_tab" label="Next View Tab" shortcut="Ctrl+Tab" />
            <item name="close_tab" label="Close View" shortcut="Ctrl+Shift+W" />
            <item name="show_closed_views" label="Show Closed Views" />
            <item name="move_tab" label="Move View to Next Pane" shortcut="Ctrl+Shift+M" />
            <item name="split_left" label="Split View Left" />
            <item name="split_right" label="Split View Right" shortcut="Ctrl+Shift+E" />
            <item name="split_up" label="Split View Above" />
            <item name="split_down" label="Split View Below" shortcut="Ctrl+Shift+O" />
        </menu>

        <menu name="agents" label="Agents">
            <item name="start_batch" label="Start Three Agents..." />
            <item name="output" label="Agent Output" />
            <item name="stop" label="Stop Agent" />
            <item name="run_reviewed" label="Run Reviewed Revision" />
        </menu>

        <menu name="branch" label="Branch">
            <item name="new" label="New Branch..." shortcut="Ctrl+N" />
            <item name="checkout" label="Checkout..." shortcut="Ctrl+P" />
            <Separator />
            <item name="merge" label="Merge Into Current" shortcut="Ctrl+M" />
            <item name="rebase_default" label="Rebase onto Default Branch" />
            <item name="rebase" label="Rebase onto Selected Branch" />
            <Separator />
            <item name="continue" label="Continue Rebase or Merge" />
            <item name="skip" label="Skip Commit..." />
            <item name="abort" label="Abort Rebase or Merge..." />
            <Separator />
            <item name="delete" label="Delete..." shortcut="Ctrl+D" />
            <item name="delete_merged" label="Delete Merged Branches..." />
            <item name="rename" label="Rename..." />
        </menu>

        <menu name="commit" label="Commit">
            <item name="commit" label="Write Commit Message" shortcut="Ctrl+K" />
            <item name="commit_now" label="Commit Staged Files" shortcut="Ctrl+Enter" />
            <item name="amend" label="Amend Last Commit" />
            <item name="undo" label="Undo Last Commit" />
            <Separator />
            <item name="stash" label="Stash Changes" />
            <item name="stash_pop" label="Pop Stash" />
            <item name="stash_drop" label="Drop Stash..." />
            <Separator />
            <item name="discard" label="Discard Changes..." />
        </menu>

        <menu name="files" label="Files">
            <item name="stage" label="Stage" />
            <item name="unstage" label="Unstage" />
            <Separator />
            <item name="stage_all" label="Stage All" shortcut="Ctrl+Shift+A" />
            <item name="unstage_all" label="Unstage All" />
            <Separator />
            <item name="reveal" label="Reveal in File Manager" />
            <item name="discard" label="Discard..." />
            <Separator />
            <item name="use_mine" label="Use My Version" />
            <item name="use_theirs" label="Use Their Version" />
            <item name="mark_resolved" label="Mark Resolved" />
        </menu>

        <menu name="remote" label="Remote">
            <item name="sync" label="Sync Current Branch" />
            <Separator />
            <item name="fetch" label="Fetch" shortcut="Ctrl+F" />
            <item name="fetch_all" label="Fetch All Repositories" shortcut="Ctrl+Shift+R" />
            <item name="pull" label="Pull..." />
            <item name="push" label="Push..." />
            <Separator />
            <item name="manage" label="Manage Remotes..." />
            <item name="prune" label="Prune Origin" />
        </menu>

        <menu name="tag" label="Tag">
            <item name="create" label="Create Tag..." />
            <item name="delete" label="Delete Tag..." />
            <Separator />
            <item name="push" label="Push Tags" />
        </menu>

        <menu name="help" label="Help">
            <item name="about" label="About Git Client" />
        </menu>
    </menus>

    <!-- Standalone, Git Client's commands are a ribbon: File is the application menu and the
         everyday commands stay beside the tabs as the Quick Access Toolbar. As a gem the shell
         owns the menu row, so the menus above and the toolbar below serve there. -->
    <ribbon>
        <ApplicationMenu menu="file" />
        <QuickAccessToolbar>
            <Button command="remote.sync" icon="data-transfer-both" tooltip="Publish, pull, or push the current branch" />
            <Button command="remote.fetch" icon="git-fetch" tooltip="Fetch from remote" />
            <Button command="commit.commit" icon="git-commit" tooltip="Commit staged changes" />
            <Button command="repo.search" icon="search" tooltip="Search repository history" />
            <Button command="repo.refresh" icon="refresh" tooltip="Refresh" />
        </QuickAccessToolbar>
        <Tab label="Home">
            <Group label="Sync">
                <Button command="remote.sync" icon="data-transfer-both" text="Sync" size="large" tooltip="Publish, pull, or push the current branch" />
                <Button command="remote.fetch" icon="git-fetch" text="Fetch" />
                <Button command="remote.pull" icon="download" text="Pull" />
                <Button command="remote.push" icon="upload" text="Push" />
            </Group>
            <Group label="Commit">
                <Button command="commit.commit_now" icon="git-commit" text="Commit" size="large" tooltip="Commit the staged files with the message in Changes (Ctrl+Enter)" />
                <Button command="commit.commit" icon="chat-lines" text="Write Message" tooltip="Go to the commit message in Changes (Ctrl+K)" />
                <Button command="commit.amend" icon="edit-pencil" text="Amend Last" tooltip="Amend the last commit" />
                <Button command="commit.undo" icon="undo" text="Undo Last" tooltip="Undo the last commit" />
                <Button command="commit.discard" icon="trash" text="Discard Changes" />
            </Group>
            <Group label="Files">
                <Button command="files.stage_all" icon="plus-square" text="Stage All" size="large" />
                <Button command="files.stage" icon="plus" text="Stage" />
                <Button command="files.unstage" icon="minus" text="Unstage" />
                <Button command="files.unstage_all" icon="minus-square" text="Unstage All" />
                <Button command="files.reveal" icon="folder" text="Reveal" tooltip="Reveal in the file manager" />
                <Button command="files.discard" icon="trash" text="Discard" tooltip="Discard the selected file's changes" />
            </Group>
            <Group label="Stash">
                <Button command="commit.stash" icon="import" text="Stash" tooltip="Stash changes" />
                <Button command="commit.stash_pop" icon="upload-square" text="Pop" tooltip="Pop the stash" />
                <Button command="commit.stash_drop" icon="xmark" text="Drop" tooltip="Drop a stash" />
            </Group>
            <Group label="Repository">
                <Button command="repo.refresh" icon="refresh" text="Refresh" size="large" />
                <Button command="repo.search" icon="search" text="Search" />
                <Button command="repo.terminal" icon="terminal" text="Terminal" tooltip="Open a terminal here" />
                <Button command="repo.identity" icon="user" text="Identity" tooltip="Git identity" />
            </Group>
        </Tab>
        <Tab label="Branch">
            <Group label="Branch">
                <Button command="branch.new" icon="git-fork" text="New Branch" size="large" />
                <Button command="branch.checkout" icon="arrow-right" text="Checkout" size="large" />
            </Group>
            <Group label="Integrate">
                <Button command="branch.merge" icon="gc-git-merge" text="Merge Into Current" size="large" tooltip="Merge the branch selected in History into the current branch" />
                <Button command="branch.rebase_default" icon="arrow-separate-vertical" text="Rebase onto Main" size="large" tooltip="Rebase the current branch onto the default branch (its upstream when it has one)" />
                <Button command="branch.rebase" icon="arrow-separate-vertical" text="Rebase onto Selected" tooltip="Rebase the current branch onto the branch selected in History" />
            </Group>
            <Group label="Conflicts">
                <Button command="files.use_mine" icon="user" text="Use Mine" tooltip="Resolve the selected conflicted file with your branch's version" />
                <Button command="files.use_theirs" icon="arrow-left" text="Use Theirs" tooltip="Resolve the selected conflicted file with the other branch's version" />
                <Button command="files.mark_resolved" icon="check" text="Mark Resolved" tooltip="Stage a file you resolved by hand" />
                <Button command="branch.continue" icon="play" text="Continue" tooltip="Continue the rebase or merge once every conflict is resolved" />
                <Button command="branch.skip" icon="skip-next" text="Skip Commit" tooltip="Leave out the commit that stopped the rebase" />
                <Button command="branch.abort" icon="xmark" text="Abort" tooltip="Stop and put the branch back as it was" />
            </Group>
            <Group label="Manage">
                <Button command="branch.rename" icon="edit-pencil" text="Rename" />
                <Button command="branch.delete" icon="trash" text="Delete" />
                <Button command="branch.delete_merged" icon="check-circle" text="Delete Merged" tooltip="Delete local branches already merged into the default branch" />
            </Group>
            <Group label="Tags">
                <Button command="tag.create" icon="triangle-flag" text="Create Tag" size="large" />
                <Button command="tag.delete" icon="trash" text="Delete Tag" />
                <Button command="tag.push" icon="upload" text="Push Tags" />
            </Group>
        </Tab>
        <Tab label="Remote">
            <Group label="Current Branch">
                <Button command="remote.sync" icon="data-transfer-both" text="Sync" size="large" tooltip="Publish, pull, or push the current branch" />
                <Button command="remote.pull" icon="download" text="Pull" size="large" />
                <Button command="remote.push" icon="upload" text="Push" size="large" />
            </Group>
            <Group label="Fetch">
                <Button command="remote.fetch" icon="git-fetch" text="Fetch" size="large" />
                <Button command="remote.fetch_all" icon="git-repos" text="Fetch All" size="large" tooltip="Fetch every repository in the background" />
            </Group>
            <Group label="Remotes">
                <Button command="remote.manage" icon="settings" text="Manage Remotes" size="large" />
                <Button command="remote.prune" icon="scissor" text="Prune Origin" size="large" tooltip="Prune deleted remote-tracking branches" />
            </Group>
        </Tab>
        <Tab label="View">
            <Group label="Show">
                <Button command="view.overview" icon="gc-nav-overview" text="Overview" size="large" />
                <Button command="view.changes" icon="gc-nav-changes" text="Changes" size="large" />
                <Button command="view.history" icon="gc-nav-history" text="History" size="large" />
                <Button command="view.github" icon="gc-nav-github" text="GitHub" size="large" />
                <Button command="view.agents" icon="gc-nav-agents" text="Agents" size="large" />
            </Group>
            <Group label="Agent Tasks">
                <Button command="agents.start_batch" icon="gc-nav-agents" text="Start Three Agents..." />
                <Button command="agents.output" icon="gc-terminal-window" text="Agent Output" />
                <Button command="agents.stop" icon="gc-stop-circle" text="Stop Agent" />
                <Button command="agents.run_reviewed" icon="gc-play" text="Run Reviewed Revision" />
            </Group>
            <Group label="History">
                <Button command="view.all_commits" icon="list" text="All Commits" />
                <Button command="view.reflog" icon="clock-rotate-right" text="Reflog" />
                <Button command="view.worktrees" icon="view-grid" text="Worktrees" />
            </Group>
            <Group label="Diff">
                <Button command="view.split_diff" icon="gc-columns" text="Side by Side" size="large" toggle="true" tooltip="Show the old and new file next to each other" />
            </Group>
            <Group label="Split">
                <Button command="view.split_right" icon="pane-split-right" text="Split Right" size="large" />
                <Button command="view.split_down" icon="pane-split-down" text="Split Below" size="large" />
                <Button command="view.split_left" icon="pane-split-right" text="Split Left" />
                <Button command="view.split_up" icon="pane-split-down" text="Split Above" />
                <Button command="view.move_tab" icon="arrow-right-to-line" text="Move to Next Pane" />
            </Group>
            <Group label="Views">
                <Button command="view.next_pane" icon="select-window" text="Next Pane" />
                <Button command="view.next_tab" icon="nav-arrow-right" text="Next View" />
                <Button command="view.close_tab" icon="pane-close" text="Close View" />
                <Button command="view.show_closed_views" icon="eye" text="Show Closed" tooltip="Show closed views" />
                <Button command="view.window_mode" icon="expand" text="Maximize" tooltip="Maximize or restore the window" />
            </Group>
        </Tab>
        <Tab label="Help">
            <Group label="Git Client">
                <Button command="help.about" icon="info-circle" text="About Git Client" size="large" />
            </Group>
        </Tab>
    </ribbon>

    <toolbar presentation="compact">
        <Button name="sync" command="remote.sync" icon="data-transfer-both" text="Sync" tooltip="Publish, pull, or push the current branch" />
        <Button name="fetch" command="remote.fetch" icon="git-fetch" text="Fetch" tooltip="Fetch from remote" />
        <Button name="fetch_all" command="remote.fetch_all" icon="download" text="Fetch All" tooltip="Fetch every repository in the background" />
        <spacer w="10" />
        <Button name="commit" command="commit.commit" icon="git-commit" text="Commit" tooltip="Commit staged changes" />
        <Button name="branch" command="branch.new" icon="git-fork" text="Branch" tooltip="Create new branch" />
        <Button name="search" command="repo.search" icon="search" text="Search" tooltip="Search repository history" />
        <Button name="prune" command="remote.prune" icon="git-fetch" text="Prune" tooltip="Prune deleted remote-tracking branches" />
        <Button name="merged" command="branch.delete_merged" icon="git-diff" text="Merged" tooltip="Delete local branches already merged into the default branch" />
        <Button name="worktrees" command="view.worktrees" icon="view-grid" text="Worktrees" tooltip="List linked worktrees" />
        <spacer w="10" />
        <Button name="refresh" command="repo.refresh" icon="refresh" text="Refresh" tooltip="Refresh" />
        <Button name="repos" command="file.repositories" icon="git-repos" text="Repos" tooltip="Switch or discover repositories" />
        <Button name="open_repo" command="file.open_repo" icon="folder" text="Add Repo" tooltip="Add a repository" />
        <Button name="clone" command="file.clone" icon="git-fork" text="Clone" tooltip="Clone a repository" />
    </toolbar>

    <contextMenus>
        <contextMenu name="branches">
            <item command="branch.checkout" label="Checkout" />
            <item command="branch.merge" label="Merge Into Current" />
            <Separator />
            <item command="branch.delete" label="Delete" />
        </contextMenu>
        <contextMenu name="checkouts">
            <item command="file.remove_repo" label="Remove from Workspace" />
        </contextMenu>
        <contextMenu name="tags">
            <item command="tag.delete" label="Delete Tag" />
        </contextMenu>
        <contextMenu name="stash">
            <item command="commit.stash_pop" label="Pop" />
            <item command="commit.stash_drop" label="Drop" />
        </contextMenu>
        <contextMenu name="files">
            <item command="files.stage" label="Stage" />
            <item command="files.unstage" label="Unstage" />
            <Separator />
            <item command="files.stage_all" label="Stage All" />
            <item command="files.unstage_all" label="Unstage All" />
            <Separator />
            <item command="files.reveal" label="Reveal in File Manager" />
            <item command="files.discard" label="Discard" />
        </contextMenu>
    </contextMenus>

    <databases>
        <database name="db" class="gitclient_db">
            <table name="branches">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="hash" type="string" length="41"/>
                <field name="is_current" type="bool"/>
                <field name="is_remote" type="bool"/>
                <field name="activity" type="string" length="32"/>
                <field name="kind" type="string" length="16"/>
            </table>
            <table name="commits">
                <field name="id" type="integer" key="YES"/>
                <field name="branch_id" type="integer" relation="branches.id"/>
                <field name="hash" type="string" length="41"/>
                <field name="author" type="string" length="64"/>
                <field name="date" type="string" length="20"/>
                <field name="subject" type="string" length="256"/>
            </table>
            <table name="files">
                <field name="id" type="integer" key="YES"/>
                <field name="commit_id" type="integer" relation="commits.id"/>
                <field name="path" type="string" length="512"/>
                <field name="status" type="string" length="2"/>
                <field name="staged" type="bool"/>
            </table>
            <table name="diff">
                <field name="id" type="integer" key="YES"/>
                <field name="content" type="string" length="262144"/>
            </table>
            <table name="tags">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="hash" type="string" length="41"/>
                <field name="date" type="string" length="20"/>
            </table>
            <table name="stash">
                <field name="id" type="integer" key="YES"/>
                <field name="ref" type="string" length="64"/>
                <field name="message" type="string" length="512"/>
                <field name="branch" type="string" length="256"/>
            </table>
            <table name="remotes">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="url" type="string" length="512"/>
            </table>
            <table name="worktrees">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="path" type="string" length="512"/>
                <field name="branch" type="string" length="96"/>
                <field name="status" type="string" length="16"/>
                <field name="is_current" type="bool"/>
                <field name="is_linked" type="bool"/>
                <field name="is_detached" type="bool"/>
                <field name="is_prunable" type="bool"/>
            </table>
        </database>
        <database name="workspace" class="db_schema_xml">
            <table name="checkouts" transient="true">
                <field name="id" type="integer" key="YES"/>
                <field name="project" type="string" length="96"/>
                <field name="name" type="string" length="128"/>
                <field name="branch" type="string" length="96"/>
                <field name="state" type="string" length="48"/>
                <field name="tone" type="string" length="12"/>
                <field name="target" type="string" length="64"/>
                <field name="guessed" type="bool"/>
                <field name="path" type="string" length="512"/>
                <field name="root" type="string" length="512"/>
            </table>
            <table name="targets" transient="true">
                <field name="id" type="integer" key="YES"/>
                <field name="checkout_id" type="integer" relation="checkouts.id"/>
                <field name="name" type="string" length="64"/>
                <field name="kind" type="string" length="8"/>
                <field name="command" type="string" length="1024"/>
                <field name="checkout" type="string" length="512"/>
                <field name="running" type="bool"/>
            </table>
        </database>
        <database name="agent_queue" class="db_schema_xml">
            <table name="agent_tasks" transient="true">
                <field name="id" type="integer" key="YES"/>
                <field name="task" type="string" length="256"/>
                <field name="provider" type="string" length="32"/>
                <field name="status" type="string" length="96"/>
                <field name="tone" type="string" length="16"/>
                <field name="section" type="string" length="64"/>
            </table>
        </database>
        <database name="github_db" class="github_database_proc">
            <table name="issues">
                <field name="id" type="integer" key="YES"/>
                <field name="number" type="integer"/>
                <field name="title" type="string" length="256"/>
                <field name="state" type="string" length="16"/>
                <field name="author" type="string" length="64"/>
                <field name="created_at" type="string" length="32"/>
            </table>
            <table name="pulls">
                <field name="id" type="integer" key="YES"/>
                <field name="number" type="integer"/>
                <field name="title" type="string" length="256"/>
                <field name="state" type="string" length="16"/>
                <field name="author" type="string" length="64"/>
                <field name="base" type="string" length="64"/>
            </table>
        </database>
    </databases>

    <plugins>
        <plugin name="gitclient_components" />
        <plugin name="terminal_components" />
    </plugins>

    <forms>
        <form name="main_window" title="Git Client" width="960" height="640" role="host" active-page="changes_page" flags="statusbar" spacing="0">
            <ActivityBar name="activity" flags="notitle">
                <Page form="overview_page" command="view.overview" />
                <Page form="changes_page" command="view.changes" />
                <Page form="history_page" command="view.history" />
                <Page form="github_page" command="view.github" />
                <Page form="agents_page" command="view.agents" />
            </ActivityBar>
        </form>
        <form name="terminal_tab" title="Terminal" width="640" height="240" flags="notitle,nofill" spacing="0" padding="0">
            <requires library="terminal_components" />
            <TerminalView name="terminal" flags="notitle,nofill,vscroll,flexspace" />
        </form>
        <form name="overview_page" title="Overview" icon="gc-nav-overview" checked-icon="gc-nav-overview-fill" tooltip="All repositories (Ctrl+0)" focus="checkouts" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <PaneToolbar replace="true">
                <Button command="view.close_tab" icon="pane-close" tooltip="Close active view" />
            </PaneToolbar>
            <SplitView name="overview_split" split-ratio="0.62" flags="flexspace">
                <TabView name="checkouts_tabs" hide-single-tab="true" flags="flexspace">
                    <StackView name="checkouts_panel" text="Worktrees" flags="flexspace" spacing="0" padding="0">
                        <StackView name="filter_bar" orientation="horizontal" spacing="6" padding="14 8 14 8">
                            <SegmentedControl name="filter" text="All|Needs attention" tooltip="Show every checkout, or only those with changes, conflicts or commits to sync" />
                        </StackView>
                        <TableView name="checkouts" source="workspace.checkouts" group-field="project" context-menu="checkouts" flags="notitle,nofill,vscroll,flexspace">
                            <RowIcon field="tone" value="conflict" icon="gc-x-circle" color="error" />
                            <RowIcon field="tone" value="dirty" icon="gc-warning-circle" color="warning" />
                            <RowIcon field="tone" value="remote" icon="gc-arrows-down-up" color="info" />
                            <RowIcon field="tone" value="missing" icon="gc-question" color="secondary" />
                            <RowIcon icon="gc-check-circle" color="success" />
                            <Column field="name" title="Worktree" width="0" />
                            <Column field="branch" title="Branch" width="0" />
                            <Column field="state" title="State" width="184" style="badge" />
                            <Column field="target" title="Runs" width="120" color="info" />
                        </TableView>
                    </StackView>
                </TabView>
                <SplitView name="targets_split" orientation="vertical" split-ratio="0.45" flags="flexspace">
                    <TabView name="targets_tabs" hide-single-tab="true" flags="flexspace">
                        <StackView name="targets_panel" text="Launch Targets" flags="flexspace" spacing="0" padding="0">
                            <StackView name="targets_bar" orientation="horizontal" spacing="6" padding="14 8 14 8">
                                <Button name="run_target" text="Run" icon="gc-play" tooltip="Run the selected target; click a running target's icon to stop it" />
                                <Button name="show_terminal" text="Terminal" icon="gc-terminal-window" tooltip="Show or hide the output of the targets that ran" />
                                <Button name="save_launch" text="Save launch.xml" icon="gc-floppy-disk" tooltip="Save the guessed targets as launch.xml at the root of the selected checkout" />
                            </StackView>
                            <TableView name="targets" source="workspace.targets" master="checkouts" flags="notitle,nofill,vscroll,flexspace">
                                <RowIcon field="running" icon="gc-stop-circle" color="info" />
                                <RowIcon field="kind" value="build" icon="gc-hammer" color="secondary" />
                                <RowIcon field="kind" value="test" icon="gc-flask" color="secondary" />
                                <RowIcon icon="gc-play" color="success" />
                                <Column field="name" title="Target" width="150" />
                                <Column field="command" title="Command" width="0" />
                            </TableView>
                        </StackView>
                    </TabView>
                    <TabView name="terminal_tabs" hide-single-tab="true" flags="flexspace" />
                </SplitView>
            </SplitView>
        </form>
        <form name="agents_page" title="Agents" icon="gc-nav-agents" checked-icon="gc-nav-agents-fill" tooltip="Agent tasks and revision review (Ctrl+4)" focus="tasks" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <requires library="gitclient_components" />
            <SplitView name="agent_split" split-ratio="0.4" flags="flexspace">
                <TabView name="task_tabs" hide-single-tab="true" flags="flexspace">
                    <StackView name="task_panel" text="Tasks" spacing="0" padding="0" flags="flexspace">
                        <StackView name="task_bar" orientation="horizontal" spacing="6" padding="14 8 14 8">
                            <Button command="agents.start_batch" icon="gc-nav-agents" text="Start Three Agents..." flags="BUTTON_DEFAULT" />
                            <Space />
                            <Label name="summary" text="" color="text-secondary" v-align="center" />
                        </StackView>
                        <TableView name="tasks" source="agent_queue.agent_tasks" cell-style="stacked" column-titles="false" group-field="section"
                                   placeholder="No agent tasks yet. Start three agents to work on the same revision in parallel, each in its own worktree."
                                   flags="notitle,nofill,vscroll,flexspace">
                            <RowIcon field="tone" value="ready" icon="gc-check-circle" color="success" />
                            <RowIcon field="tone" value="failed" icon="gc-x-circle" color="error" />
                            <RowIcon field="tone" value="running" icon="gc-play" color="info" />
                            <RowIcon field="tone" value="waiting" icon="gc-hourglass" color="secondary" />
                            <RowIcon icon="gc-minus-circle" color="secondary" />
                            <Column field="task" title="Task" width="0" min-width="80" />
                            <Column field="provider" title="Agent" />
                            <Column field="status" title="State" width="132" style="badge" />
                        </TableView>
                    </StackView>
                </TabView>
                <TabView name="review_tabs" hide-single-tab="true" flags="flexspace">
                    <StackView name="review_panel" text="Review" spacing="0" padding="0" flags="flexspace">
                        <StackView name="review_head" spacing="2" padding="14 10 14 4">
                            <StackView name="review_title_row" orientation="horizontal" spacing="8">
                                <Label name="revision" text="No task selected" font="title" flags="flexspace" />
                                <Badge name="state" text="" icon="gc-check-circle" color="secondary" v-align="center" />
                            </StackView>
                            <Label name="source" text="Select a task to review the revision its agent saved." color="text-secondary" />
                            <Label name="detail" text="" flags="LABEL_COLLAPSE_EMPTY" />
                        </StackView>
                        <StackView name="review_bar" orientation="horizontal" spacing="6" padding="14 8 14 8">
                            <Button command="agents.run_reviewed" icon="gc-play" text="Run Reviewed Revision" tooltip="Run the default application target from this revision's launch.xml" />
                            <Button command="agents.output" icon="gc-terminal-window" text="Agent Output" tooltip="Show the agent's terminal" />
                            <Button command="agents.stop" icon="gc-stop-circle" text="Stop Agent" tooltip="Stop the running agent" />
                        </StackView>
                        <DiffView name="review_diff" text="Diff" placeholder="Select a task to see the changes its agent made." flags="notitle,nofill,vscroll,flexspace" />
                    </StackView>
                </TabView>
            </SplitView>
        </form>
        <form name="agent_batch_dialog" title="Start Three Agents" width="640" auto_layout="1" padding="12" spacing="8">
            <Label text="Each agent works on its own task in its own worktree, starting from the current committed revision." />
            <Label name="repository" text="" color="text-secondary" />
            <GridView name="tasks" spacing="8">
                <Column name="labels" width="auto">
                    <Label text="Task 1:" />
                    <Label text="Task 2:" />
                    <Label text="Task 3:" />
                </Column>
                <Column name="prompts">
                    <MultiEdit name="prompt_one" height="64" placeholder="Describe what the first agent should do" flags="vscroll" />
                    <MultiEdit name="prompt_two" height="64" placeholder="Describe what the second agent should do" flags="vscroll" />
                    <MultiEdit name="prompt_three" height="64" placeholder="Describe what the third agent should do" flags="vscroll" />
                </Column>
                <Column name="providers" width="120">
                    <ComboBox name="provider_one" v-align="start" />
                    <ComboBox name="provider_two" v-align="start" />
                    <ComboBox name="provider_three" v-align="start" />
                </Column>
            </GridView>
            <Separator name="sep" />
            <StackView orientation="horizontal" spacing="8">
                <Space />
                <Button name="start" text="Start Three Agents" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="changes_page" title="Changes" icon="gc-nav-changes" checked-icon="gc-nav-changes-fill" tooltip="Working tree (Ctrl+1)" focus="changes_files" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <PaneToolbar replace="true">
                <Button command="view.close_tab" icon="pane-close" tooltip="Close active view" />
            </PaneToolbar>
            <requires library="gitclient_components" />
            <StackView name="operation_bar" orientation="horizontal" spacing="8" padding="14 8 14 8">
                <Badge name="operation_state" text="Conflicts" icon="gc-x-circle" color="error" v-align="center" />
                <StackView name="operation_text" spacing="2" flags="flexspace">
                    <Label name="operation_title" text="" font="heading" />
                    <Label name="operation_detail" text="" color="text-secondary" />
                </StackView>
                <Button command="branch.continue" icon="gc-play" text="Continue" v-align="center" tooltip="Continue once every conflict is resolved" />
                <Button command="branch.skip" text="Skip Commit" v-align="center" tooltip="Leave out the commit that stopped" />
                <Button command="branch.abort" text="Abort" v-align="center" tooltip="Stop and put the branch back as it was" />
            </StackView>
            <SplitView name="changes_split" split-ratio="0.30" flags="flexspace">
                <TabView name="changes_panel_tabs" hide-single-tab="true" flags="flexspace">
                    <StackView name="changes_panel" text="Changes" spacing="4" padding="4">
                        <CheckBox name="stage_all" text="0 changed files" margin="4 0 0 0" />
                        <TableView name="changes_files" source="db.files" master="none" check-field="staged" column-titles="false" context-menu="files" flags="notitle,nofill,vscroll,flexspace">
                            <RowIcon field="status" value="Conflicted" icon="gc-x-circle" color="error" />
                            <Column field="path" title="File" width="0" />
                            <Column field="status" title="Status" width="88" color="secondary" />
                        </TableView>
                        <TextEdit name="commit_summary" placeholder="Summary (required)" />
                        <MultiEdit name="commit_description" placeholder="Description" height="64" flags="vscroll" />
                        <StackView name="commit_actions" orientation="horizontal" spacing="4">
                            <Button name="stash_inline" text="Stash" />
                            <Button name="commit_now" text="Commit" flags="flexspace" />
                        </StackView>
                    </StackView>
                </TabView>
                <TabView name="changes_diff_tabs" hide-single-tab="true" flags="flexspace">
                    <DiffView name="changes_diff" text="Diff" flags="notitle,nofill,vscroll,flexspace"/>
                </TabView>
            </SplitView>
        </form>
        <form name="history_page" title="History" icon="gc-nav-history" checked-icon="gc-nav-history-fill" tooltip="Commit history (Ctrl+2)" focus="log" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <PaneToolbar replace="true">
                <Button command="view.close_tab" icon="pane-close" tooltip="Close active view" />
            </PaneToolbar>
            <requires library="gitclient_components" />
            <SplitView name="history_main_split" split-ratio="0.3" flags="flexspace">
                <SplitView name="left_split" orientation="vertical" flags="flexspace" width="180">
                    <TabView name="branches_tabs" hide-single-tab="true" flags="flexspace">
                        <TableView name="branches" text="Branches" source="db.branches" context-menu="branches" cell-style="stacked" column-titles="false" flags="notitle,nofill,vscroll">
                            <RowIcon field="is_current" icon="gc-check-circle" color="success" />
                            <Column field="name" title="Branch" width="0" />
                            <Column field="activity" title="Updated" />
                            <Column field="kind" title="Kind" width="72" color="secondary" />
                        </TableView>
                    </TabView>
                    <SplitView name="tags_worktrees_split" split-ratio="0.35" flags="flexspace">
                        <SplitView name="tags_stash_split" orientation="vertical" flags="flexspace">
                            <TabView name="tags_tabs" hide-single-tab="true" flags="flexspace">
                                <TableView name="tags" text="Tags" source="db.tags" context-menu="tags" cell-style="stacked" column-titles="false" flags="notitle,nofill,vscroll">
                                    <Column field="name" title="Tag" width="0" />
                                    <Column field="date" title="Date" />
                                </TableView>
                            </TabView>
                            <TabView name="stash_list_tabs" hide-single-tab="true" flags="flexspace">
                                <TableView name="stash_list" text="Stash" source="db.stash" context-menu="stash" flags="notitle,nofill,vscroll">
                                    <Column field="message" title="Stash" width="0" />
                                    <Column field="branch" title="Branch" width="80" />
                                </TableView>
                            </TabView>
                        </SplitView>
                        <TabView name="worktrees_tabs" hide-single-tab="true" flags="flexspace">
                            <TableView name="worktrees" text="Worktrees" source="db.worktrees" master="none" column-titles="false" flags="notitle,nofill,vscroll">
                                <Column field="name" title="Worktree" width="0" />
                                <Column field="status" title="State" width="72" color="secondary" />
                            </TableView>
                        </TabView>
                    </SplitView>
                </SplitView>
                <SplitView name="history_content_split" split-ratio="0.42" flags="flexspace">
                    <SplitView name="log_files_split" orientation="vertical" flags="flexspace">
                        <TabView name="log_tabs" hide-single-tab="true" flags="flexspace">
                            <TableView name="log" text="Commits" source="db.commits" cell-style="two-line" flags="notitle,nofill,vscroll,flexspace">
                                <Column field="subject" title="Subject" width="0" min-width="120" />
                                <Column field="author" title="Author" width="0" />
                                <Column field="date" title="Date" width="0" />
                            </TableView>
                        </TabView>
                        <TabView name="history_files_tabs" hide-single-tab="true" flags="flexspace">
                            <TableView name="history_files" text="Files" source="db.files" master="log" flags="notitle,nofill,vscroll,flexspace">
                                <Column field="path" title="File" width="0" />
                                <Column field="status" title="Status" width="64" />
                            </TableView>
                        </TabView>
                    </SplitView>
                    <TabView name="history_diff_tabs" hide-single-tab="true" flags="flexspace">
                        <DiffView name="history_diff" text="Diff" flags="notitle,nofill,vscroll,flexspace"/>
                    </TabView>
                </SplitView>
            </SplitView>
        </form>
        <form name="github_page" title="GitHub" icon="gc-nav-github" checked-icon="gc-nav-github-fill" tooltip="Issues and pull requests (Ctrl+3)" focus="issues" width="960" height="600" role="page" auto_layout="1" flags="nofill,flexspace">
            <PaneToolbar replace="true">
                <Button command="view.close_tab" icon="pane-close" tooltip="Close active view" />
            </PaneToolbar>
            <SplitView name="github_split" orientation="vertical" flags="flexspace">
                <TabView name="issues_panel_tabs" hide-single-tab="true" flags="flexspace">
                    <StackView name="issues_panel" text="Issues" spacing="4" padding="4">
                        <TableView name="issues" source="github_db.issues" placeholder="No open issues to show. Git Client reads them with the GitHub CLI: install gh and sign in with gh auth login." flags="notitle,nofill,vscroll,flexspace">
                            <Column field="number" title="#" width="40" />
                            <Column field="title" title="Title" width="0" />
                            <Column field="state" title="State" width="64" />
                            <Column field="author" title="Author" width="100" />
                            <Column field="created_at" title="Opened" width="100" />
                        </TableView>
                    </StackView>
                </TabView>
                <TabView name="pulls_panel_tabs" hide-single-tab="true" flags="flexspace">
                    <StackView name="pulls_panel" text="Pull Requests" spacing="4" padding="4">
                        <TableView name="pulls" source="github_db.pulls" placeholder="No open pull requests to show. Git Client reads them with the GitHub CLI: install gh and sign in with gh auth login." flags="notitle,nofill,vscroll,flexspace">
                            <Column field="number" title="#" width="40" />
                            <Column field="title" title="Title" width="0" />
                            <Column field="state" title="State" width="64" />
                            <Column field="author" title="Author" width="100" />
                            <Column field="base" title="Base" width="80" />
                        </TableView>
                    </StackView>
                </TabView>
            </SplitView>
        </form>
        <form name="commit_dialog" title="Commit" width="324" auto_layout="1" spacing="6" padding="8">
            <Label text="Message:" />
            <MultiEdit name="msg" flags="vscroll,flexspace" />
            <StackView orientation="horizontal" spacing="6">
                <CheckBox name="amend" text="Amend last commit" />
                <Space />
                <Button name="ok" text="Commit" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="new_branch_dialog" title="New Branch" width="276" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="Name:" />
                    <Label text="From:" />
                </Column>
                <Column name="inputs">
                    <TextEdit name="name" />
                    <ComboBox name="from" control-size="regular" source="db.branches" display="name" value="name" filter_field="is_remote" filter_value="0" />
                </Column>
            </GridView>
            <CheckBox name="checkout" text="Checkout after creation" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Create" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="branch_rename_dialog" title="Rename Branch" width="276" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="New name:" />
                </Column>
                <Column name="inputs">
                    <TextEdit name="name" />
                </Column>
            </GridView>
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Rename" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="clone_dialog" title="Clone Repository" width="420" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="URL:" />
                    <Label text="Path:" />
                </Column>
                <Column name="inputs">
                    <TextEdit name="url" />
                    <TextEdit name="path" />
                </Column>
                <Column name="field_actions" width="auto">
                    <Label text="" />
                    <Button name="browse" text="..." />
                </Column>
            </GridView>
            <Label name="status" text="" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Clone" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="remote_dialog" title="Manage Remotes" width="400" height="320" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="Remotes:" />
                    <Label text="Name:" />
                    <Label text="URL:" />
                </Column>
                <Column name="inputs">
                    <ComboBox name="remote_list" />
                    <TextEdit name="name" />
                    <TextEdit name="url" />
                </Column>
            </GridView>
            <StackView orientation="horizontal" spacing="6">
                <Button name="add" text="Add" />
                <Button name="update" text="Update" />
                <Button name="remove" text="Remove" />
                <Space />
                <Button name="close" text="Close" flags="BUTTON_DEFAULT" />
            </StackView>
        </form>
        <form name="search_dialog" title="Search" width="320" auto_layout="1" spacing="6" padding="8">
            <Label text="Search commits, branches, files:" />
            <TextEdit name="query" flags="flexspace" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Search" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="create_tag_dialog" title="Create Tag" width="320" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="Name:" />
                    <Label text="Ref:" />
                </Column>
                <Column name="inputs">
                    <TextEdit name="name" />
                    <TextEdit name="ref" />
                </Column>
            </GridView>
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="Create" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="push_pull_dialog" title="Remote Operation" width="262" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="Remote:" />
                    <Label text="Branch:" />
                </Column>
                <Column name="inputs">
                    <ComboBox name="remote" source="db.remotes" display="name" value="name" />
                    <ComboBox name="branch" source="db.branches" display="name" value="name" filter_field="is_remote" filter_value="0" />
                </Column>
            </GridView>
            <CheckBox name="prune" text="Prune deleted remote branches" />
            <CheckBox name="force" text="Force push if the remote has not moved" tooltip="Uses --force-with-lease: it overwrites the remote branch only when nobody has pushed since your last fetch" />
            <StackView orientation="horizontal" spacing="6">
                <Space />
                <Button name="ok" text="OK" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="repositories_dialog" title="Repositories" width="276" auto_layout="1" spacing="6" padding="8">
            <Label text="Known repositories:" />
            <ComboBox name="repo_list" />
            <StackView orientation="horizontal" spacing="4">
                <Button name="add" text="Add..." />
                <Button name="scan" text="Scan Folder..." />
                <Button name="remove" text="Remove" />
            </StackView>
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="open" text="Open" flags="BUTTON_DEFAULT" />
                <Button name="close" text="Close" />
            </StackView>
        </form>
        <form name="create_repo_dialog" title="Create Repository" width="500" auto_layout="1" spacing="6" padding="8">
            <Label text="Repository folder:" />
            <GridView name="fields" spacing="4">
                <Column name="inputs">
                    <TextEdit name="path" />
                </Column>
                <Column name="field_actions" width="auto">
                    <Button name="browse" text="Choose..." />
                </Column>
            </GridView>
            <Label name="status" text="The folder will be created and initialized with branch main." />
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="ok" text="Create" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="identity_dialog" title="Git Identity" width="460" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="Name:" />
                    <Label text="Email:" />
                </Column>
                <Column name="inputs">
                    <TextEdit name="name" />
                    <TextEdit name="email" />
                </Column>
            </GridView>
            <CheckBox name="global" text="Use for all repositories" />
            <Label name="status" text="Without it, the identity is saved for this repository only." color="text-secondary" />
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="ok" text="Save" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="switch_branch_dialog" title="Switch Branch" width="440" auto_layout="1" spacing="6" padding="8">
            <GridView name="fields" spacing="6">
                <Column name="labels" width="auto">
                    <Label text="Find:" />
                    <Label text="Branch:" />
                </Column>
                <Column name="inputs">
                    <TextEdit name="query" />
                    <ComboBox name="branches" />
                </Column>
            </GridView>
            <StackView orientation="horizontal" spacing="4">
                <Button name="new_branch" text="New Branch..." />
                <Space />
                <Button name="ok" text="Switch" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
        <form name="worktree_dialog" title="Worktrees" width="520" auto_layout="1" spacing="6" padding="8">
            <Label text="Switch to a worktree:" />
            <ComboBox name="list" flags="flexspace" />
            <StackView orientation="horizontal" spacing="4">
                <Space />
                <Button name="ok" text="Switch" flags="BUTTON_DEFAULT" />
                <Button name="cancel" text="Cancel" />
            </StackView>
        </form>
    </forms>
</orion>
