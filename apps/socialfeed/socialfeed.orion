<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="socialfeed"
    title="Social Feed Dialogs"
    root="apps/socialfeed">

    <plugins>
      <plugin name="socialfeed_components" />
    </plugins>

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="quit" label="Quit" />
      </menu>

      <menu name="post" label="Post">
        <item name="new" label="New Post..." shortcut="Ctrl+N" />
        <item name="like" label="Like Post" shortcut="Ctrl+L" />
        <item name="view" label="View Post..." shortcut="Enter" />
        <Separator />
        <item name="delete" label="Delete Post" shortcut="Delete" />
      </menu>

      <menu name="view" label="View">
        <item name="refresh" label="Refresh" />
      </menu>

      <menu name="test" label="Test">
        <item name="edit_author" label="Edit Author (DB Dialog)..." />
        <item name="new_author" label="New Author (DB Dialog)..." />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <databases>
      <!-- NeXTSTEP-style split: one database per model/table. -->
      <database name="db" class="SimpleXMLDatabase" source="apps/socialfeed/share/socialfeed_seed.xml">
        <!-- Core entities -->
        <table name="authors">
          <field name="id" type="integer" key="YES"/>
          <field name="name" type="string" length="64"/>
          <field name="avatar" type="string" length="256"/>
        </table>

        <table name="posts">
          <field name="id" type="integer" key="YES"/>
          <field name="author_id" type="integer" relation="authors.id"/>
          <field name="title" type="string" length="256"/>
          <field name="body" type="string" length="2048"/>
          <field name="like_count" type="integer"/>
          <field name="comment_count" type="integer"/>
        </table>
        
        <table name="comments">
          <field name="id" type="integer" key="YES"/>
          <field name="post_id" type="integer" relation="posts.id"/>
          <field name="author_id" type="integer" relation="authors.id"/>
          <field name="text" type="string" length="1024"/>
          <field name="like_count" type="integer"/>
        </table>
      </database>
    </databases>

    <forms>
      <form name="main_window"
            title="Social Feed"
            width="472" height="336"
            flags="WINDOW_STATUSBAR"
            spacing="0"
            padding="0">
        <Toolbar>
          <Button name="new" command="post.new" icon="plus" text="New Post" tooltip="Create new post" />
          <Button name="like" command="post.like" icon="heart" text="Like" tooltip="Like post" />
          <Button name="view" command="post.view" icon="chat-bubble-empty" text="View Post" tooltip="View post details" />
          <spacer />
          <Button name="delete" command="post.delete" icon="trash" text="Delete" tooltip="Delete post" />
        </Toolbar>
        <StackView name="content" spacing="0" flags="WINDOW_FLEXSPACE">
          <TableView name="feed"
                     source="db.posts"
                     action="fetch_feed"
                     flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE">
            <Column field="title" title="Title" width="0" />
            <Column field="author.name" title="Author" width="80" />
            <Column field="like_count" title="Likes" width="50" />
            <Column field="comment_count" title="Comments" width="55" />
          </TableView>
        </StackView>
      </form>

      <form name="new_post"
            title="New Post"
            width="272" height="250"
            spacing="0"
            padding="8">
        <GridView name="fields" spacing="4">
          <Column name="labels" width="56">
            <Label name="lbl_author" text="Author:" />
            <Label name="lbl_title" text="Title:" />
            <Label name="lbl_body" text="Body:" />
          </Column>
          <Column name="inputs">
            <ComboBox name="author" 
                      field="db.posts.author_id"
                      source="db.authors"
                      display="name"
                      value="id" />
            <TextBox name="title" field="db.posts.title" />
            <MultiEdit name="body" field="db.posts.body" />
          </Column>
        </GridView>
        <Separator name="section_sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex_left" />
          <Button name="ok" text="Post" action="db.posts.insert" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
          <Space name="flex_right" />
        </StackView>
      </form>

      <form name="new_comment"
            title="New Comment"
            width="260"
            padding="8">
        <StackView name="author_row" orientation="horizontal" spacing="6">
          <Label name="lbl_author" text="Author:" />
          <ComboBox name="author"
                    field="db.comments.author_id"
                    source="db.authors"
                    display="name"
                    value="id" />
        </StackView>

        <StackView name="text_row" orientation="horizontal" spacing="6">
          <Label name="lbl_text" text="Text:" />
          <TextBox name="text" field="db.comments.text" />
        </StackView>

        <Separator name="sep" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Button name="ok" text="Submit" action="db.comments.insert" flags="BUTTON_DEFAULT" />
          <Space name="flex" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>

      <form name="post_detail"
            title="Post Detail"
            width="520" height="336"
            padding="8">
        <StackView name="header" orientation="vertical" spacing="2">
          <!-- Post header labels (populated in evCreate) -->
          <Label name="lbl_title" font="system" color="text-normal" />
          <Label name="lbl_body" font="small" color="text-normal" />
          <StackView name="meta" orientation="horizontal" spacing="8">
            <Label name="lbl_author" font="small" color="text-disabled" />
            <Label name="lbl_likes" font="small" color="text-disabled" />
            <Label name="lbl_cmt_hdr" font="small" color="text-disabled" />
          </StackView>
        </StackView>

        <!-- Bound tableview for comments (reportview-compatible class). -->
        <TableView name="comments"
                   source="db.comments"
                   action="fetch_comments"
                   master="posts"
                   master-key="post_id"
                   flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE">
          <Column field="author.name" title="Author" width="70" />
          <Column field="text" title="Text" width="0" />
          <Column field="like_count" title="Likes" width="45" />
        </TableView>

        <Separator name="section_sep" />

        <StackView name="actions" orientation="horizontal" spacing="4">
          <Button name="like_post" text="Like Post" />
          <Button name="add_comment" text="Add Comment" />
          <Button name="add_reply" text="Add Reply" />
          <Button name="like_comment" text="Like Comment" />
          <Space name="flex" />
          <Button name="close" text="Close" flags="BUTTON_DEFAULT" />
        </StackView>
      </form>
    </forms>
</orion>
