<?xml version="1.0" encoding="UTF-8"?>
<orion version="1" name="terminal" title="Terminal" root="apps/terminal">
    <plugins>
        <plugin name="terminal_components" />
    </plugins>

    <menus var="kTerminalMenus" count="kTerminalMenuCount">
        <menu name="tab" label="Tab">
            <item name="new" label="New Tab" shortcut="Ctrl+Shift+T" />
            <item name="close" label="Close Tab" shortcut="Ctrl+Shift+W" />
            <item name="next" label="Next Tab" shortcut="Ctrl+Tab" />
            <item name="previous" label="Previous Tab" shortcut="Ctrl+Shift+Tab" />
            <item name="split_right" label="Split Right" shortcut="Ctrl+Shift+E" />
            <item name="split_down" label="Split Down" shortcut="Ctrl+Shift+O" />
            <item name="move" label="Move Tab to Next Pane" shortcut="Ctrl+Shift+M" />
            <item name="focus_next" label="Focus Next Pane" shortcut="Ctrl+Alt+Tab" />
        </menu>
        <menu name="view" label="View">
            <item name="workspace" label="Workspace" />
        </menu>
    </menus>

    <forms>
        <form name="main_window" title="Terminal" width="1024" height="700" role="host" active-page="workspace_page" flags="toolbar" auto_layout="1" spacing="0" padding="0">
            <ActivityBar name="activity" flags="notitle">
                <Page form="workspace_page" command="view.workspace" />
            </ActivityBar>
        </form>
        <form name="workspace_page" title="Workspace" icon="workspace" checked-icon="workspace-fill" tooltip="Terminal workspace" focus="left_tabs" width="960" height="680" role="page" auto_layout="1" flags="nofill,flexspace" spacing="0" padding="0">
            <Toolbar>
                <Button command="tab.previous" icon="tab-previous" text="Previous" tooltip="Previous tab (Ctrl+Shift+Tab)" />
                <Button command="tab.next" icon="tab-next" text="Next" tooltip="Next tab (Ctrl+Tab)" />
                <Separator />
                <Button command="tab.move" icon="tab-move" text="Move Tab" tooltip="Move tab to next pane (Ctrl+Shift+M)" />
                <Button command="tab.focus_next" icon="pane-next" text="Next Pane" tooltip="Focus next pane (Ctrl+Alt+Tab)" />
            </Toolbar>
            <PaneToolbar>
                <Button command="tab.new" icon="tab-new" text="New Tab" tooltip="New tab in this pane (Ctrl+Shift+T)" />
            </PaneToolbar>
            <SplitView name="terminals" split-ratio="0.5" flags="flexspace">
                <TabView name="left_tabs" flags="flexspace" />
                <TabView name="right_tabs" flags="flexspace" />
            </SplitView>
        </form>
        <form name="session_tab" title="Terminal" width="960" height="640" flags="notitle,nofill" spacing="0" padding="0">
            <TerminalView name="terminal" flags="notitle,nofill,vscroll,flexspace" />
        </form>
    </forms>
</orion>
