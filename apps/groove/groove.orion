<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="groove"
    title="Groove"
    root="apps/groove">

    <plugins>
      <plugin name="groove_components" />
    </plugins>

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="new" label="New Song" shortcut="Ctrl+N" />
        <item name="open" label="Open Song..." shortcut="Ctrl+O" />
        <item name="save" label="Save Song" shortcut="Ctrl+S" />
        <item name="saveas" label="Save Song As..." />
        <Separator />
        <item name="record" label="Record Sample..." shortcut="Ctrl+R" />
        <item name="manage_samples" label="Manage Recordings..." />
        <item name="import_project" label="Import Song..." />
        <item name="export_project" label="Export Song..." />
        <Separator />
        <item name="export_audio" label="Export Audio..." shortcut="Ctrl+E" />
        <item name="share_audio" label="Share Audio..." />
        <item name="export_video" label="Export Timeline Video..." shortcut="Ctrl+Shift+E" />
        <Separator />
        <item name="demo" label="Demo: Neon Skyline" />
        <item name="demo_afterglow" label="Demo: Afterglow Avenue" />
        <item name="demo_victory" label="Demo: Victory Lights" />
        <Separator if="!defined(AX_PLATFORM_IOS)" />
        <item name="quit" label="Quit" shortcut="Ctrl+Q" if="!defined(AX_PLATFORM_IOS)" />
      </menu>

      <menu name="edit" label="Edit">
        <item name="delete" label="Delete Block" shortcut="Delete;Backspace" />
      </menu>

      <menu name="transport" label="Transport">
        <item name="play" label="Play / Pause" shortcut="Space" />
        <item name="stop" label="Stop" />
        <item name="rewind" label="Rewind" shortcut="Home" />
        <item name="forward" label="Go to End" shortcut="End" />
        <item name="loop" label="Loop" shortcut="L" />
      </menu>
      <menu name="window" label="Window">
        <item name="library" label="Show Library" />
        <item name="reset" label="Reset Workspace" />
      </menu>
    </menus>

    <contextmenus>
      <contextmenu name="track">
        <item name="duplicate" label="Add Same Instrument Track" />
        <item name="full" label="All 8 tracks are in use" />
      </contextmenu>
      <contextmenu name="more">
        <item command="file.saveas" label="Save Song As..." />
        <item command="file.import_project" label="Import Song..." />
        <item command="file.export_project" label="Export Song..." />
        <Separator />
        <item command="file.manage_samples" label="Manage Recordings..." />
        <item command="file.share_audio" label="Share Audio..." />
        <item command="file.export_video" label="Export Timeline Video..." />
        <Separator />
        <item command="file.demo" label="Demo: Neon Skyline" />
        <item command="file.demo_afterglow" label="Demo: Afterglow Avenue" />
        <item command="file.demo_victory" label="Demo: Victory Lights" />
        <item command="window.reset" label="Reset Workspace" />
        <item command="file.quit" label="Quit" if="!defined(AX_PLATFORM_IOS)" />
      </contextmenu>
    </contextmenus>

    <databases>
      <database name="library" class="groove_library_db">
        <table name="blocks" model="library_block_t">
          <field name="id" type="integer" key="YES" />
          <field name="name" type="string" length="64" />
          <field name="category" type="integer" />
          <field name="genres" type="integer" />
          <field name="bars" type="integer" />
          <field name="variant" type="integer" />
        </table>
      </database>

      <!-- iPad: songs saved in Groove's own storage (axSettingsDirectory()/Songs), newest first. -->
      <database name="songs" class="groove_songs_db">
        <table name="songs" model="song_entry_t">
          <field name="id" type="integer" key="YES" />
          <field name="name" type="string" length="128" />
          <field name="path" type="string" length="512" />
          <field name="modified" type="integer" />
          <field name="bpm" type="integer" />
          <field name="bars" type="integer" />
        </table>
      </database>
    </databases>

    <forms>
      <form name="export_media" title="Export" width="520" spacing="8" padding="12">
        <GridView name="fields" spacing="6">
          <Column name="labels" width="auto">
            <Label name="lbl_format" text="Format:" />
            <Label name="lbl_aspect" text="Video size:" />
          </Column>
          <Column name="inputs">
            <ComboBox name="format" />
            <ComboBox name="aspect" />
          </Column>
        </GridView>
        <Label name="details" text="Export the whole song, with current mute, solo and block levels." height="44" />
        <Label name="status" text="Ready to export." height="44" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Button name="save" text="Save File..." flags="BUTTON_DEFAULT" />
          <Button name="share" text="Share..." />
          <Space name="flex" />
          <Button name="cancel" text="Close" />
        </StackView>
      </form>
      <form name="record_sample" title="Record Sample" width="460" spacing="8" padding="12">
        <GridView name="fields" spacing="6">
          <Column name="labels" width="auto">
            <Label name="lbl_name" text="Name:" />
            <Label name="lbl_bars" text="Length:" />
          </Column>
          <Column name="inputs">
            <TextBox name="name" />
            <ComboBox name="bars" />
          </Column>
        </GridView>
        <Label name="status" text="Record a sample at the current song tempo." height="40" />
        <CheckBox name="metronome" text="Metronome" />
        <Label name="hint" text="Use headphones to keep the click out of the recording." height="32" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Button name="record" text="Record" />
          <Button name="stop" text="Stop" />
          <Button name="preview" text="Listen" />
          <Space name="flex" />
          <Button name="save" text="Save Sample" flags="BUTTON_DEFAULT" />
          <Button name="cancel" text="Cancel" />
        </StackView>
      </form>
      <form name="manage_samples" title="Manage Recordings" width="460" height="330" spacing="8" padding="12">
        <TableView name="recordings" source="library.blocks" filter-field="category" filter-value="10" master="none"
                   flags="WINDOW_NOTITLE | WINDOW_VSCROLL | WINDOW_FLEXSPACE">
          <Column field="name" title="Recording" width="0" />
          <Column field="bars" title="Bars" width="70" />
        </TableView>
        <Label name="empty" text="No recordings yet. Use Add Recording in My Samples." color="text-secondary" />
        <GridView name="fields" spacing="6">
          <Column name="labels" width="auto">
            <Label name="lbl_name" text="Name:" />
          </Column>
          <Column name="inputs">
            <TextBox name="name" />
          </Column>
        </GridView>
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Button name="rename" text="Rename" />
          <Button name="delete" text="Delete" />
          <Space name="flex" />
          <Button name="close" text="Close" flags="BUTTON_DEFAULT" />
        </StackView>
      </form>

      <form name="main_window" title="Groove" width="1180" height="760"
            flags="WINDOW_AUTO_LAYOUT | WINDOW_TOOLBAR | WINDOW_TITLETOOLBAR | WINDOW_NORESIZE | WINDOW_NOCLOSE | WINDOW_NOCOLLAPSE" spacing="0" padding="0">
        <Toolbar>
          <Button command="file.new" icon="phosphor-file-plus" tooltip="New Song" />
          <Button command="file.open" icon="phosphor-folder-open" tooltip="Open Song..." />
          <Button command="file.save" icon="phosphor-floppy-disk" tooltip="Save Song" />
          <Spacer flags="TOOLBAR_ITEM_FLAG_FLEXSPACE" />
          <Button command="transport.rewind" icon="phosphor-rewind-fill" tooltip="Rewind (Home)" />
          <Button command="transport.play" icon="phosphor-play-fill" checked-icon="phosphor-pause-fill" tooltip="Play / pause (Space)" />
          <Button command="transport.forward" icon="phosphor-fast-forward-fill" tooltip="Go to end (End)" />
          <Spacer flags="TOOLBAR_ITEM_FLAG_FLEXSPACE" />
          <Button command="transport.loop" icon="phosphor-repeat" checked-icon="phosphor-repeat-fill" tooltip="Loop (L)" />
          <Button command="edit.delete" icon="phosphor-trash" tooltip="Remove selected block (Delete)" />
          <Button command="file.record" icon="phosphor-microphone" tooltip="Record Sample..." />
          <Button command="file.export_audio" icon="phosphor-arrow-square-out" tooltip="Export Audio..." />
          <Button name="more" icon="phosphor-dots-three" tooltip="More actions" />
        </Toolbar>
        <GrooveTracks name="tracks" width="64" />
        <GrooveArrangement name="arrangement" flags="WINDOW_FLEXSPACE" />
      </form>

      <form name="library_window" title="Library" width="800" height="320"
            flags="WINDOW_AUTO_LAYOUT | WINDOW_NOTITLE | WINDOW_NORESIZE | WINDOW_NOCLOSE | WINDOW_NOCOLLAPSE"
            spacing="4" padding="4">
        <SegmentedControl name="families" text="Drums|Fills|Bass|Guitar|Synth|Pads|Stabs|Vocals|Scratch|FX|My Samples" flags="CONTROL_SIZE_LARGE" />
        <GrooveBlockBin name="bin" source="library.blocks" flags="WINDOW_FLEXSPACE">
          <FlowView name="blocks" spacing="0" padding="0" flags="WINDOW_FLEXSPACE">
            <GrooveBlockCard name="record_audio" text="Add Recording" width="176" height="44" flags="WINDOW_HIDDEN" />
            <GrooveBlockCard name="item_template" width="128" height="44" />
          </FlowView>
        </GrooveBlockBin>
      </form>

      <!-- iPad File > Open Song: every saved song as a card with a preview drawn from the file itself. -->
      <form name="song_browser" title="My Songs" width="700" height="460" spacing="8" padding="12">
        <Label name="heading" text="My Songs" font="title" />
        <TileGrid name="songs" spacing="8" padding="8 8 8 8" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE" />
        <Label name="empty" text="Your saved songs will appear here." color="text-secondary" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Button name="delete" text="Delete" height="44" />
          <Space name="flex" />
          <Button name="cancel" text="Cancel" height="44" />
          <Button name="open" text="Open" height="44" flags="BUTTON_DEFAULT" />
        </StackView>
      </form>

      <form name="new_song_card" width="232" flags="WINDOW_NOTITLE | WINDOW_NOFILL" spacing="4" padding="0">
        <Button name="placeholder" text="+ New Song" height="84" />
        <Label name="detail" text="Start with an empty song" color="text-secondary" />
      </form>

      <!-- One song tile inside song_browser's TileGrid; the form root is a Card. -->
      <form name="song_card" width="232" flags="WINDOW_NOTITLE | WINDOW_NOFILL" spacing="4" padding="0">
        <GrooveSongPreview name="preview" height="84" />
        <Label name="title" font="system" />
        <Label name="detail" color="text-disabled" />
      </form>

      <form name="save_song" title="Save Song" width="360" spacing="8" padding="12">
        <GridView name="fields" spacing="4">
          <Column name="labels" width="auto">
            <Label name="lbl_name" text="Name:" />
          </Column>
          <Column name="inputs">
            <TextBox name="name" height="44" />
          </Column>
        </GridView>
        <Label name="status" text="Saved songs appear in My Songs." height="44" color="text-secondary" />
        <StackView name="actions" orientation="horizontal" spacing="6">
          <Space name="flex" />
          <Button name="cancel" text="Cancel" height="44" />
          <Button name="ok" text="Save" height="44" flags="BUTTON_DEFAULT" />
        </StackView>
      </form>
    </forms>
</orion>
