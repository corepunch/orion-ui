  <rounded-rect size="19.5 27" radius="1.18" color="0.42 0.47 0.54" shininess="75">
    <extrude amount="0.65"/><bevel amount="0.12" bevelSegments="4"/>
  </rounded-rect>
  <rounded-rect pos="0 0 0.34" size="19.22 26.72" radius="1.08" color="0.018 0.022 0.03" shininess="82">
    <extrude amount="0.08"/><bevel amount="0.018" bevelSegments="3"/>
  </rounded-rect>
  <screen pos="0 0 0.405" size="18.55 25.52 0.035" radius="0.53"
          image="share/screens/tablet-demo.png" color="1 1 1"/>
  <sphere pos="0 13.13 0.415" radius="0.075" color="0.07 0.10 0.16" shininess="75" castShadow="0"/>
  <rounded-rect pos="9.77 7.2 0" size="0.08 1.35" radius="0.035" color="0.52 0.57 0.63"><extrude amount="0.22"/></rounded-rect>
</prefab>
