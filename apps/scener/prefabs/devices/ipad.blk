<?xml version="1.0" encoding="UTF-8"?>
<!-- Stylized iPad promo model. Local +Z is the display/front; center is the device center. Dimensions are illustrative. -->
<prefab up="y" front="+z">
  <rect size="19.5 27" color="0.42 0.47 0.54" shininess="75"><fillet radius="1.18" segments="8"/>
    <extrude amount="0.65"/><bevel amount="0.12" bevelSegments="4"/>
  </rect>
  <rect pos="0 0 0.34" size="19.22 26.72" color="0.018 0.022 0.03" shininess="82"><fillet radius="1.08" segments="8"/>
    <extrude amount="0.08"/><bevel amount="0.018" bevelSegments="3"/>
  </rect>
  <screen pos="0 0 0.405" size="18.55 25.52 0.035" radius="0.53"
          image="share/screens/tablet-demo.png" color="1 1 1"/>
  <sphere pos="0 13.13 0.415" radius="0.075" color="0.07 0.10 0.16" shininess="75" castShadow="0"/>
  <rect pos="9.77 7.2 0" size="0.08 1.35" color="0.52 0.57 0.63"><fillet radius="0.035" segments="8"/><extrude amount="0.22"/></rect>
</prefab>
