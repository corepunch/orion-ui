<!-- CAT-style biped preset after CAT's Base Human, about 178 cm. Copy this file to start a
     character, then edit proportions, materials, features and poses; nothing is inherited.
     Body frame Z up, facing local -Y, the character's left at +X. Lengths in centimetres.
     Base Human layout: Pelvis hub; Spine of 3 links; Ribcage hub; Neck of 1 link; Head hub.
     Legs on the pelvis: Thigh, Calf, Ankle (foot) and a two-knuckle toe digit.
     Arms on the ribcage: Collarbone, Upperarm, Forearm, Palm and five three-knuckle digits.
     Author the left limbs; mirror="1" builds the right ones, as CAT's Paste Mirrored does. -->
<prefab>
  <option name="gloves" enabled="0" />
  <material id="glove" color="0.07 0.055 0.04" shininess="5" />
  <material id="skin" color="0.86 0.68 0.56" shininess="10" />
  <material id="shirt" color="0.30 0.42 0.62" shininess="6" />
  <material id="trousers" color="0.22 0.22 0.26" shininess="6" />
  <material id="shoes" color="0.12 0.10 0.09" shininess="8" />
  <material id="hair" color="0.25 0.17 0.11" shininess="12" />
  <material id="eye" color="0.08 0.08 0.10" shininess="60" />

  <hub name="pelvis" aim="0 90" length="14" radius="18 11.5" material="trousers">
    <ellipsoid on="120 -15" at="0.25" radii="9 8 10" sink="4.5" material="trousers" />
    <ellipsoid on="-120 -15" at="0.25" radii="9 8 10" sink="4.5" material="trousers" />
    <limb name="left_leg" type="leg" at="0.25" from="90 0" sink="3.8" mirror="1">
      <bone name="left_thigh" aim="0 -90" length="44" radius="10.5 11" taper="0.78" overlap="6" material="trousers">
        <bone name="left_calf" aim="0 -90" length="43" radius="7.5 8" taper="0.65" overlap="4" material="trousers">
          <ellipsoid on="0 0" at="0" radii="6.5 6 6.5" sink="2" material="trousers" />
          <ankle name="left_foot" aim="0 -12" length="18" radius="5.5 4.6" overlap="3" material="shoes">
            <digit name="left_toe" at="1" from="0 -30" aim="0 -6" links="2" length="4" radius="5 3.5" taper="0.9" overlap="3" material="shoes" />
          </ankle>
        </bone>
      </bone>
    </limb>
    <spine name="spine" links="3" aim="0 90" aimEnd="0 86" length="24" radius="13 9.5" taper="1.1" volume="0" material="shirt">
      <ellipsoid on="0 0" at="0.5" radii="13.5 8.8 23" sink="9.8" material="shirt" />
      <hub name="ribcage" aim="0 90" length="20" radius="17 10.5" material="shirt">
        <ellipsoid on="40 0" at="0.68" radii="10.5 4.5 9.5" sink="2.5" material="shirt" />
        <ellipsoid on="-40 0" at="0.68" radii="10.5 4.5 9.5" sink="2.5" material="shirt" />
        <limb name="left_arm" type="arm" at="0.9" from="90 0" mirror="1">
          <collarbone name="left_collarbone" aim="90 0" length="8" radius="4" material="shirt">
            <bone name="left_upperarm" aim="90 -82" length="29" radius="6.5 7" taper="0.78" overlap="4" material="shirt">
              <ellipsoid on="90 20" at="0.08" radii="7 7 8" sink="6.5" material="shirt" />
              <bone name="left_forearm" aim="0 -86" length="26" radius="4.6 4.8" taper="0.75" material="skin">
                <ellipsoid name="left_glove_cuff" on="0 0" at="0.76" sink="4.8" radii="5.2 5.4 7" material="glove" if-feature="gloves" />
                <palm name="left_palm" aim="0 -90" length="12" radius="3.5 4.8" overlap="2" material="skin">
                  <ellipsoid name="left_glove_hand" on="0 0" at="0.5" sink="4.8" radii="3.85 5.25 8" material="glove" if-feature="gloves" />
                  <digit name="left_thumb" at="0.32" across="-0.85" aim="180 -40" aimEnd="-140 -62" links="3" length="7" radius="1" taper="0.8" material="skin" />
                  <digit name="left_index" at="0.82" across="-0.78" aim="-90 -88" aimEnd="-90 -72" links="3" length="8" radius="0.85" taper="0.8" material="skin" />
                  <digit name="left_middle" at="0.94" across="-0.26" aim="-90 -86" aimEnd="-90 -68" links="3" length="8.5" radius="0.9" taper="0.8" material="skin" />
                  <digit name="left_ring" at="0.88" across="0.26" aim="-90 -84" aimEnd="-90 -64" links="3" length="8" radius="0.85" taper="0.8" material="skin" />
                  <digit name="left_pinky" at="0.74" across="0.78" aim="-90 -82" aimEnd="-90 -60" links="3" length="6.5" radius="0.75" taper="0.8" material="skin" />
                </palm>
              </bone>
            </bone>
          </collarbone>
        </limb>
        <spine name="neck" aim="0 90" aimEnd="0 80" length="9" radius="5.5" material="skin">
          <hub name="head" aim="0 90" length="21" radius="8 9.5" material="skin">
            <sphere on="28 5" at="0.45" radius="1.3" material="eye" />
            <sphere on="-28 5" at="0.45" radius="1.3" material="eye" />
            <ellipsoid on="0 -5" at="0.35" radii="1.4 2 2.6" sink="0.5" material="skin" />
            <ellipsoid on="90 0" at="0.45" radii="1 2 3" sink="0.5" material="skin" />
            <ellipsoid on="-90 0" at="0.45" radii="1 2 3" sink="0.5" material="skin" />
            <bone name="hair" at="0.7" from="180 50" aim="0 90" length="8" radius="8.5 9.5" sink="6" material="hair" />
          </hub>
        </spine>
      </hub>
    </spine>
  </hub>

  <!-- Pose library. Poses in the character file travel with it; a scene pose of the same name wins. -->
  <pose name="Stand" />
  <pose name="WaveLeft">
    <ik limb="left_arm" offset="4 -8 72" bend="150 -20" />
    <joint target="left_palm" aim="0 90" />
    <joint target="head" rot="0 0 15" />
  </pose>
  <pose name="WaveRight" mirror="WaveLeft" />
  <pose name="PointLeft">
    <ik limb="left_arm" offset="22 -43 54" bend="90 -90" />
    <joint target="left_palm" aim="30 0" />
    <joint target="head" rot="0 0 25" />
  </pose>
  <pose name="PointRight" mirror="PointLeft" />
  <pose name="HandsOnHips">
    <ik limb="left_arm" offset="-2 2 24" bend="130 0" />
    <ik limb="right_arm" offset="2 2 24" bend="-130 0" />
  </pose>
  <pose name="Think">
    <ik limb="right_arm" offset="21 -9 55" bend="-60 -60" />
    <joint target="right_palm" aim="0 70" />
    <ik limb="left_arm" offset="-14 -14 26" bend="150 -60" />
    <joint target="head" rot="8 0 -10" />
  </pose>
  <pose name="HandsOpen">
    <joint target="left_index" rot="0 -2 0" />
    <joint target="left_index_2" rot="0 -8 0" />
    <joint target="left_index_3" rot="0 -8 0" />
    <joint target="left_middle" rot="0 -4 0" />
    <joint target="left_middle_2" rot="0 -9 0" />
    <joint target="left_middle_3" rot="0 -9 0" />
    <joint target="left_ring" rot="0 -6 0" />
    <joint target="left_ring_2" rot="0 -10 0" />
    <joint target="left_ring_3" rot="0 -10 0" />
    <joint target="left_pinky" rot="0 -8 0" />
    <joint target="left_pinky_2" rot="0 -11 0" />
    <joint target="left_pinky_3" rot="0 -11 0" />
    <joint target="left_thumb" rot="0 0 0" />
    <joint target="right_index" rot="0 2 0" />
    <joint target="right_index_2" rot="0 8 0" />
    <joint target="right_index_3" rot="0 8 0" />
    <joint target="right_middle" rot="0 4 0" />
    <joint target="right_middle_2" rot="0 9 0" />
    <joint target="right_middle_3" rot="0 9 0" />
    <joint target="right_ring" rot="0 6 0" />
    <joint target="right_ring_2" rot="0 10 0" />
    <joint target="right_ring_3" rot="0 10 0" />
    <joint target="right_pinky" rot="0 8 0" />
    <joint target="right_pinky_2" rot="0 11 0" />
    <joint target="right_pinky_3" rot="0 11 0" />
    <joint target="right_thumb" rot="0 0 0" />
  </pose>
  <pose name="HandsRelaxed">
    <joint target="left_index" rot="0 10 0" />
    <joint target="left_index_2" rot="0 4 0" />
    <joint target="left_index_3" rot="0 4 0" />
    <joint target="left_middle" rot="0 8 0" />
    <joint target="left_middle_2" rot="0 3 0" />
    <joint target="left_middle_3" rot="0 3 0" />
    <joint target="left_ring" rot="0 6 0" />
    <joint target="left_ring_2" rot="0 2 0" />
    <joint target="left_ring_3" rot="0 2 0" />
    <joint target="left_pinky" rot="0 4 0" />
    <joint target="left_pinky_2" rot="0 1 0" />
    <joint target="left_pinky_3" rot="0 1 0" />
    <joint target="left_thumb" rot="0 6 0" />
    <joint target="right_index" rot="0 -10 0" />
    <joint target="right_index_2" rot="0 -4 0" />
    <joint target="right_index_3" rot="0 -4 0" />
    <joint target="right_middle" rot="0 -8 0" />
    <joint target="right_middle_2" rot="0 -3 0" />
    <joint target="right_middle_3" rot="0 -3 0" />
    <joint target="right_ring" rot="0 -6 0" />
    <joint target="right_ring_2" rot="0 -2 0" />
    <joint target="right_ring_3" rot="0 -2 0" />
    <joint target="right_pinky" rot="0 -4 0" />
    <joint target="right_pinky_2" rot="0 -1 0" />
    <joint target="right_pinky_3" rot="0 -1 0" />
    <joint target="right_thumb" rot="0 -6 0" />
  </pose>
  <pose name="HandsFist">
    <joint target="left_index" rot="0 53 0" />
    <joint target="left_index_2" rot="0 47 0" />
    <joint target="left_index_3" rot="0 47 0" />
    <joint target="left_middle" rot="0 51 0" />
    <joint target="left_middle_2" rot="0 46 0" />
    <joint target="left_middle_3" rot="0 46 0" />
    <joint target="left_ring" rot="0 49 0" />
    <joint target="left_ring_2" rot="0 45 0" />
    <joint target="left_ring_3" rot="0 45 0" />
    <joint target="left_pinky" rot="0 47 0" />
    <joint target="left_pinky_2" rot="0 44 0" />
    <joint target="left_pinky_3" rot="0 44 0" />
    <joint target="left_thumb" rot="0 27.5 0" />
    <joint target="right_index" rot="0 -53 0" />
    <joint target="right_index_2" rot="0 -47 0" />
    <joint target="right_index_3" rot="0 -47 0" />
    <joint target="right_middle" rot="0 -51 0" />
    <joint target="right_middle_2" rot="0 -46 0" />
    <joint target="right_middle_3" rot="0 -46 0" />
    <joint target="right_ring" rot="0 -49 0" />
    <joint target="right_ring_2" rot="0 -45 0" />
    <joint target="right_ring_3" rot="0 -45 0" />
    <joint target="right_pinky" rot="0 -47 0" />
    <joint target="right_pinky_2" rot="0 -44 0" />
    <joint target="right_pinky_3" rot="0 -44 0" />
    <joint target="right_thumb" rot="0 -27.5 0" />
  </pose>
</prefab>
