<?xml version="1.0" encoding="UTF-8"?>
<!-- workbench: footprint 200 x 107.8 cm, baseline y=0, top surface at y=94.
     Front is +Z. Work from the +Z side. Drawer handles are climbable visual footholds. -->
<prefab up="y" front="+z">
  <attach name="top_surface" pos="0 94 0"/>
  <attach name="under_center" pos="0 12 0"/>
  <box pos="0 90 0" size="200 8 90" material="wood"/>
  <box pos="0 29 -2" size="170 6 66" material="wood"/>
  <box pos="0 73 42" size="176 28 8" material="dark_wood"/>
  <box pos="-58 75 48" size="50 20 4" material="wood"/>
  <box pos="0 75 48" size="50 20 4" material="wood"/>
  <box pos="58 75 48" size="50 20 4" material="wood"/>
  <torus pos="-58 75 51.5" rot="90 0 0" majorRadius="4.5" minorRadius="1" material="brass"/>
  <torus pos="0 75 51.5" rot="90 0 0" majorRadius="4.5" minorRadius="1" material="brass"/>
  <torus pos="58 75 51.5" rot="90 0 0" majorRadius="4.5" minorRadius="1" material="brass"/>
  <prism pos="-86 43 -34" radius="9" height="86" sides="8" material="dark_wood"/>
  <prism pos="86 43 -34" radius="9" height="86" sides="8" material="dark_wood"/>
  <prism pos="-86 43 34" radius="9" height="86" sides="8" material="dark_wood"/>
  <prism pos="86 43 34" radius="9" height="86" sides="8" material="dark_wood"/>
  <box pos="78 101 30" size="34 16 20" material="iron"/>
  <box pos="78 101 13" size="34 16 10" material="iron"/>
  <cylinder pos="78 92 42" rot="90 0 0" radius="3.5" height="34" material="iron"/>
  <box pos="78 92 61" size="30 3.5 3.5" material="wood"/>
</prefab>
