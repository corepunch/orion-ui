  <attach name="edge_e" pos="83 78 0"/>
  <attach name="edge_w" pos="-83 78 0"/>
  <box pos="0 75 0" size="160 6 100" material="wood"/>
  <cylinder pos="-70 37.5 -42" radius="4" height="75" material="wood"/>
  <cylinder pos="70 37.5 -42" radius="4" height="75" material="wood"/>
  <cylinder pos="-70 37.5 42" radius="4" height="75" material="wood"/>
  <cylinder pos="70 37.5 42" radius="4" height="75" material="wood"/>
</prefab>
