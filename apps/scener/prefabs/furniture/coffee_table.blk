<?xml version="1.0" encoding="UTF-8"?>
<!-- coffee table: footprint 120 x 70 cm, baseline y=0, no front direction.
     Centered at origin with 4 metal cylinder legs. -->
<prefab up="y">
  <attach name="top" pos="0 48 0"/>
  <box pos="0 45 0" size="120 6 70" material="wood"/>
  <cylinder pos="-50 21 -28" radius="3" height="42" material="metal"/>
  <cylinder pos="50 21 -28" radius="3" height="42" material="metal"/>
  <cylinder pos="-50 21 28" radius="3" height="42" material="metal"/>
  <cylinder pos="50 21 28" radius="3" height="42" material="metal"/>
</prefab>
