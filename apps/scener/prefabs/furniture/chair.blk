<?xml version="1.0" encoding="UTF-8"?>
<!-- chair: footprint 45 x 45 cm, baseline y=0, backrest at z=-20.
     Front direction is +Z (backrest = -Z).
     Rotate around Y to change facing: rotY(+90) -> faces +X, rotY(-90) -> faces -X. -->
<prefab up="y" front="+z">
  <attach name="seat" pos="0 47.5 0"/>
  <box pos="0 45 0" size="45 5 45" material="wood"/>
  <box pos="0 75 -20" size="45 55 5" material="wood"/>
  <prism pos="-18 22.5 -18" radius="2.5" height="45" sides="4" material="wood"/>
  <prism pos="18 22.5 -18" radius="2.5" height="45" sides="4" material="wood"/>
  <prism pos="-18 22.5 18" radius="2.5" height="45" sides="4" material="wood"/>
  <prism pos="18 22.5 18" radius="2.5" height="45" sides="4" material="wood"/>
</prefab>
