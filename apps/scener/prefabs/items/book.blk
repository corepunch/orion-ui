<?xml version="1.0" encoding="UTF-8"?>
<!-- book: footprint 44 x 32 cm, baseline y=0, top at y=12.
     Spine faces -X. tint=1 marks cover parts for instance color. -->
<prefab up="y">
  <attach name="top" pos="0 12 0"/>
  <box pos="0 1.5 0" size="44 3 32" color="0.12 0.24 0.17" shininess="14" tint="1"/>
  <box pos="1.2 6 0" size="39 6 28" color="0.76 0.68 0.50" shininess="2"/>
  <box pos="0 10.5 0" size="44 3 32" color="0.12 0.24 0.17" shininess="14" tint="1"/>
  <box pos="-20.5 6 0" size="3 6 32" color="0.12 0.24 0.17" shininess="14" tint="1"/>
</prefab>
