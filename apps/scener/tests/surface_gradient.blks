<?xml version="1.0" encoding="UTF-8"?>
<!-- <surface>, <gradient> gizmos and a non-uniform <taper>: the tools the converted Blender kits use instead of
     vertex colours and polygon soup. -->
<scene ambient="0.35 0.38 0.48" background="0.62 0.7 0.84" skyReflection="2">
  <sun dir="-0.4 -0.75 -0.5" intensity="1" castShadows="1"/>
  <camera name="All" pos="0 260 560" look="0 70 0" fov="42"/>
  <box pos="0 -5 0" size="900 10 400" color="0.86 0.9 0.96"/>
  <let name="r" value="14"/>
  <!-- a candy-cane post: a closed tube whose stripes are a repeating uv gizmo, u + 5v -->
  <surface name="candy" pos="-300 0 0" segments="24 60" closed="u" color="1 1 1" shininess="40"
           x="{r}*cos(u*2*pi)" y="v*160" z="-{r}*sin(u*2*pi)">
    <gradient type="uv" tile="1 5" repeat="1" edge="0.5" from="0.83 0.13 0.17" to="0.98 0.95 0.9"/>
  </surface>
  <!-- a frustum with different insets on x and z: one taper per crosswise axis (Max's Effect) -->
  <box name="frustum" pos="-140 50 0" size="100 100 100" color="0.36 0.62 0.38">
    <taper center="0 0 0" amount="-1" effect="x"/><taper center="0 0 0" amount="-0.3" effect="z"/>
  </box>
  <!-- a snow sheet with a lip coloured by a hard step along v, and its soft fold -->
  <surface name="snow" pos="20 60 -60" segments="20 20" twoSided="1" color="0.95 0.97 1"
           x="u*140" y="20*sin(v*2.2)-35*max(0,v-0.8)*max(0,v-0.8)/0.04" z="v*130">
    <gradient type="uv" tile="0 1" edge="0.92" from="1 1 1" to="0.82 0.86 0.96"/>
  </surface>
  <!-- a line gizmo between two points and a radial one -->
  <box name="line" pos="230 50 0" size="80 100 80" color="1 1 1">
    <gradient type="line" start="0 -50 0" end="0 50 0" power="0.6" from="0.9 0.4 0.2" to="1 0.85 0.3"/>
  </box>
  <cylinder name="radial" pos="340 2 0" radius="50" height="4" color="1 1 1">
    <gradient type="radial" start="0 0 0" end="50 0 0" repeat="1" edge="0.5" from="0.2 0.4 0.8" to="0.95 0.95 1"/>
  </cylinder>
</scene>
