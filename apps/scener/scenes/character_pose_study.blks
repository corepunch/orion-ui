<?xml version="1.0" encoding="UTF-8"?>
<scene up="z" ambient="0.34 0.35 0.38" background="0.075 0.085 0.11">
  <camera name="Standing" comment="Neutral ellipsoid actor" pos="-260 -450 210" look="0 -10 94" fov="39">
