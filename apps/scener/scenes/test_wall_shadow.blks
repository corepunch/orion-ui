<?xml version="1.0" encoding="UTF-8"?>
<scene ambient="0.10 0.10 0.13" background="0.04 0.05 0.07">
  <camera name="Main" comment="Wall-opening shadow geometry diagnostic" pos="0 250 200" look="0 100 -300" fov="65"/>

  <light type="point" pos="50 250 -150" color="1.0 0.95 0.85" intensity="1.3" radius="600" castShadows="1"/>

  <material id="wall" color="0.80 0.78 0.72" shininess="6"/>
  <material id="floor" color="0.35 0.28 0.22" shininess="12"/>

  <!-- floor -->
  <box pos="0 -5 -300" size="800 10 600" material="floor" castShadow="0"/>

  <!-- back wall -->
  <group pos="-400 0 -600" rot="0 90 0">
    <wall length="600" height="280" thickness="20" material="wall"/>
    <bool-negative-box pos="-246 105 0" size="100 210 20"/>
  </group>

  <!-- right wall, solid -->
  <wall pos="400 0 -300" length="600" height="280" thickness="20" material="wall"/>

  <!-- a simple box to cast a visible shadow -->
  <box pos="100 50 -250" size="80 100 80" color="0.55 0.15 0.18" shininess="20"/>
</scene>
