<?xml version="1.0" encoding="UTF-8"?>
<scene ambient="0.10 0.10 0.13" background="dusk">
  <camera name="Main" comment="Front-half view from entrance" pos="0 160 450" look="0 100 -300" fov="65"/>
  <camera name="Top"  comment="Overhead top-down" pos="0 600 -200" look="0 100 -200" fov="50"/>
  <camera name="Close" comment="Close-up of dining table" pos="-250 150 -270" look="-400 150 -270" fov="60"/>

  <light pos="50 250 -150" color="1.0 0.95 0.85" intensity="1.3" radius="600" castShadows="1"/>
  <sun dir="0.75 -0.55 0.35" color="0.95 0.90 0.80" intensity="1.1" castShadows="1"/>

  <material id="fabric" color="0.55 0.15 0.18" shininess="4"/>

  <box pos="0 -5 -300" size="800 10 600" material="floor" castShadow="0"/>
  <box pos="0 285 -300" size="800 10 600" material="plaster"/>

  <group pos="0 0 -600">
    <wall length="800" height="280" thickness="20" material="wall"/>
    <bool-negative-box pos="-346 105 0" size="100 210 20"/>
  </group>

  <group pos="-400 0 -300" rot="0 90 0">
    <wall length="600" height="280" thickness="20" material="wall"/>
    <bool-negative-box pos="-228 150 0" size="140 120 20"/>
  </group>

  <wall pos="400 0 -300" rot="0 90 0" length="600" height="280" thickness="20" material="wall"/>

  <wall pos="0 0 0" length="800" height="280" thickness="20" material="wall" renderable="0" castShadow="1"/>

  <!-- ================= furniture ================= -->

  <prefab source="furniture/sofa" pos="-150 0 -500"/>

  <prefab source="furniture/coffee_table" pos="-150 0 -380"/>

  <torus pos="260 5 -360" majorRadius="28" minorRadius="5" material="metal"/>
  <sphere pos="-150 64 -380" radius="16" material="fabric"/>
  <pyramid pos="-300 25 -90" radius="35" height="50" material="wood"/>

  <box pos="-150 49 -380" size="110 1 60" material="glass"/>

  <!-- dining table with 4 chairs -->
  <prefab source="furniture/dining_table" name="dining_table" pos="0 0 -150"/>

  <cylinder pos="-35 75 -135" radius="4" height="12" material="glass"/>
  <cylinder pos="35 75 -165" radius="4" height="12" material="glass"/>

  <sphere attach="dining_table:center" radius="14" material="fabric"/>

  <prefab source="furniture/chair" pos="0 0 -75" rot="0 180 0"/>
  <prefab source="furniture/chair" pos="0 0 -225"/>
  <prefab source="furniture/chair" pos="-105 0 -150" rot="0 90 0"/>
  <prefab source="furniture/chair" pos="105 0 -150" rot="0 -90 0"/>
</scene>
