<?xml version="1.0" encoding="UTF-8"?>
<!-- Chess study on a felt table top: the board is four <array> boxes, every piece is a lathed
     Staunton profile, and squares are addressed by file and rank through {S*(file - 3.5)}.
     Z up, centimetres. The table top is the ground plane; white sits at -Y.
     Position after 1.e4 e5 2.Nf3 Nc6 3.Bb5 a6 4.Ba4 Nf6 5.O-O, with a captured pawn lying beside the board. -->
<scene up="z" ambient="0.20 0.19 0.22" background="twilight">
  <let name="S" value="5"/>
  <let name="F" value="3.2"/>
  <let name="BASE" value="2"/>
  <let name="TILE" value="0.4"/>
  <let name="Z" value="BASE + TILE"/>

  <camera name="white" comment="White's eye line over the kingside, pieces in depth" pos="18 -66 34" look="2 2 4" fov="40"/>
  <camera name="oblique" comment="Three-quarter view from the lamp side, long shadows across the board" pos="-58 -52 44" look="-1 1 3" fov="42"/>
  <camera name="plan" comment="Straight-down plan of the position" pos="0 -2 120" look="0 0 0" fov="30"/>

  <material id="felt" color="0.16 0.30 0.22" shininess="2"/>
  <material id="mahogany" color="0.34 0.16 0.10" shininess="30"/>
  <material id="maple" color="0.82 0.70 0.50" shininess="26"/>
  <material id="walnut" color="0.30 0.19 0.12" shininess="26"/>
  <material id="ivory" color="0.90 0.85 0.72" shininess="34"/>
  <material id="ebony" color="0.11 0.09 0.08" shininess="44"/>
  <material id="brass" color="0.72 0.50 0.20" shininess="40"/>

  <!-- A warm desk lamp off to the west, a cool window fill from the north-east. -->
  <light pos="-70 -30 72" color="1.0 0.84 0.62" intensity="1.6" radius="190" castShadows="1"/>
  <sun dir="0.6 0.8 -1" color="0.55 0.65 0.95" intensity="0.42" castShadows="0"/>

  <!-- Table top as the ground, with its top face at z=0. -->
  <box pos="0 0 -1.5" size="170 120 3" material="felt"/>

  <!-- Board: frame slab, then two colours of tiles. Each tile box is arrayed 4x4 on a 2S pitch;
       the second copy of each colour is shifted one square diagonally. -->
  <box pos="0 0 {BASE/2}" size="{8*S + 2*F} {8*S + 2*F} {BASE}" material="mahogany"/>
  <box pos="{-3.5*S} {-3.5*S} {BASE + TILE/2}" size="{S} {S} {TILE}" material="walnut">
    <array count="4" translation="{2*S} 0 0"/>
    <array count="4" translation="0 {2*S} 0"/>
  </box>
  <box pos="{-2.5*S} {-2.5*S} {BASE + TILE/2}" size="{S} {S} {TILE}" material="walnut">
    <array count="4" translation="{2*S} 0 0"/>
    <array count="4" translation="0 {2*S} 0"/>
  </box>
  <box pos="{-2.5*S} {-3.5*S} {BASE + TILE/2}" size="{S} {S} {TILE}" material="maple">
    <array count="4" translation="{2*S} 0 0"/>
    <array count="4" translation="0 {2*S} 0"/>
  </box>
  <box pos="{-3.5*S} {-2.5*S} {BASE + TILE/2}" size="{S} {S} {TILE}" material="maple">
    <array count="4" translation="{2*S} 0 0"/>
    <array count="4" translation="0 {2*S} 0"/>
  </box>

  <!-- Staunton profiles, radius x against height y; lathes stand on their first vertex. -->
  <shape id="pawn" closed="0">
    <v x="0" y="0"/><v x="1.75" y="0"/><v x="1.75" y="0.55"/><v x="1.15" y="0.95"/><v x="0.85" y="2.3"/>
    <v x="1.25" y="2.65"/><v x="0.8" y="3.0"/><v x="0.75" y="3.3"/><v x="1.1" y="3.75"/><v x="0.95" y="4.3"/><v x="0.5" y="4.65"/><v x="0" y="4.75"/>
  </shape>
  <shape id="rook" closed="0">
    <v x="0" y="0"/><v x="1.9" y="0"/><v x="1.9" y="0.6"/><v x="1.3" y="1.0"/><v x="1.15" y="3.6"/><v x="1.6" y="3.9"/>
    <v x="1.6" y="5.0"/><v x="1.15" y="5.0"/><v x="1.15" y="4.55"/><v x="0" y="4.55"/>
  </shape>
  <shape id="bishop" closed="0">
    <v x="0" y="0"/><v x="1.9" y="0"/><v x="1.9" y="0.6"/><v x="1.3" y="1.0"/><v x="0.95" y="2.6"/><v x="1.4" y="3.0"/>
    <v x="0.95" y="3.4"/><v x="1.3" y="4.3"/><v x="1.1" y="5.3"/><v x="0.6" y="6.0"/><v x="0.3" y="6.25"/><v x="0.45" y="6.55"/><v x="0" y="6.85"/>
  </shape>
  <shape id="queen" closed="0">
    <v x="0" y="0"/><v x="2.1" y="0"/><v x="2.1" y="0.7"/><v x="1.4" y="1.1"/><v x="1.05" y="3.1"/><v x="1.6" y="3.5"/>
    <v x="1.05" y="3.95"/><v x="1.3" y="5.3"/><v x="1.6" y="6.6"/><v x="1.9" y="7.3"/><v x="1.45" y="7.55"/><v x="1.0" y="7.8"/><v x="0.55" y="8.2"/><v x="0" y="8.45"/>
  </shape>
  <shape id="king" closed="0">
    <v x="0" y="0"/><v x="2.2" y="0"/><v x="2.2" y="0.7"/><v x="1.5" y="1.1"/><v x="1.15" y="3.2"/><v x="1.7" y="3.7"/>
    <v x="1.15" y="4.15"/><v x="1.4" y="5.6"/><v x="1.8" y="7.0"/><v x="2.0" y="7.8"/><v x="1.35" y="8.1"/><v x="0.55" y="8.35"/><v x="0.55" y="8.6"/><v x="0" y="8.6"/>
  </shape>
  <shape id="knight_base" closed="0">
    <v x="0" y="0"/><v x="1.9" y="0"/><v x="1.9" y="0.6"/><v x="1.3" y="1.0"/><v x="1.25" y="1.7"/><v x="0" y="1.7"/>
  </shape>

  <!-- White, rank 1 and 2 (files a..h = 0..7). -->
  <lathe shape="rook"   segments="32" pos="{S*(0-3.5)} {S*(0-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="queen"  segments="32" pos="{S*(3-3.5)} {S*(0-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="rook"   segments="32" pos="{S*(5-3.5)} {S*(0-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="bishop" segments="32" pos="{S*(2-3.5)} {S*(0-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <group name="white_king" pos="{S*(6-3.5)} {S*(0-3.5)} {Z}">
    <lathe shape="king" segments="32" rot="90 0 0" material="ivory"/>
    <box pos="0 0 9.1" size="0.35 0.35 1.3" material="ivory"/>
    <box pos="0 0 9.3" size="1.0 0.35 0.35" material="ivory"/>
  </group>
  <group name="white_knight_b1" pos="{S*(1-3.5)} {S*(0-3.5)} {Z}">
    <lathe shape="knight_base" segments="32" rot="90 0 0" material="ivory"/>
    <ellipsoid pos="0 0.3 3.2" rot="-28 0 0" radii="1.0 1.15 2.3" material="ivory"/>
    <ellipsoid pos="0 -0.9 5.1" rot="22 0 0" radii="0.8 1.55 0.85" material="ivory"/>
    <cone pos="-0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ivory"/>
    <cone pos="0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ivory"/>
  </group>
  <group name="white_knight_f3" pos="{S*(5-3.5)} {S*(2-3.5)} {Z}">
    <lathe shape="knight_base" segments="32" rot="90 0 0" material="ivory"/>
    <ellipsoid pos="0 0.3 3.2" rot="-28 0 0" radii="1.0 1.15 2.3" material="ivory"/>
    <ellipsoid pos="0 -0.9 5.1" rot="22 0 0" radii="0.8 1.55 0.85" material="ivory"/>
    <cone pos="-0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ivory"/>
    <cone pos="0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ivory"/>
  </group>
  <lathe shape="bishop" segments="32" pos="{S*(0-3.5)} {S*(3-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(0-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(1-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(2-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(3-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(4-3.5)} {S*(3-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(5-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(6-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>
  <lathe shape="pawn" segments="32" pos="{S*(7-3.5)} {S*(1-3.5)} {Z}" rot="90 0 0" material="ivory"/>

  <!-- Black, rank 7 and 8. -->
  <lathe shape="rook"   segments="32" pos="{S*(0-3.5)} {S*(7-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="bishop" segments="32" pos="{S*(2-3.5)} {S*(7-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="queen"  segments="32" pos="{S*(3-3.5)} {S*(7-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <group name="black_king" pos="{S*(4-3.5)} {S*(7-3.5)} {Z}">
    <lathe shape="king" segments="32" rot="90 0 0" material="ebony"/>
    <box pos="0 0 9.1" size="0.35 0.35 1.3" material="ebony"/>
    <box pos="0 0 9.3" size="1.0 0.35 0.35" material="ebony"/>
  </group>
  <lathe shape="bishop" segments="32" pos="{S*(5-3.5)} {S*(7-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="rook"   segments="32" pos="{S*(7-3.5)} {S*(7-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <group name="black_knight_c6" pos="{S*(2-3.5)} {S*(5-3.5)} {Z}" rot="0 0 180">
    <lathe shape="knight_base" segments="32" rot="90 0 0" material="ebony"/>
    <ellipsoid pos="0 0.3 3.2" rot="-28 0 0" radii="1.0 1.15 2.3" material="ebony"/>
    <ellipsoid pos="0 -0.9 5.1" rot="22 0 0" radii="0.8 1.55 0.85" material="ebony"/>
    <cone pos="-0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ebony"/>
    <cone pos="0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ebony"/>
  </group>
  <group name="black_knight_f6" pos="{S*(5-3.5)} {S*(5-3.5)} {Z}" rot="0 0 180">
    <lathe shape="knight_base" segments="32" rot="90 0 0" material="ebony"/>
    <ellipsoid pos="0 0.3 3.2" rot="-28 0 0" radii="1.0 1.15 2.3" material="ebony"/>
    <ellipsoid pos="0 -0.9 5.1" rot="22 0 0" radii="0.8 1.55 0.85" material="ebony"/>
    <cone pos="-0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ebony"/>
    <cone pos="0.4 0.1 5.8" rot="80 0 0" radius="0.3" height="0.9" material="ebony"/>
  </group>
  <lathe shape="pawn" segments="32" pos="{S*(0-3.5)} {S*(5-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(1-3.5)} {S*(6-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(2-3.5)} {S*(6-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(3-3.5)} {S*(6-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(4-3.5)} {S*(4-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(5-3.5)} {S*(6-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(6-3.5)} {S*(6-3.5)} {Z}" rot="90 0 0" material="ebony"/>
  <lathe shape="pawn" segments="32" pos="{S*(7-3.5)} {S*(6-3.5)} {Z}" rot="90 0 0" material="ebony"/>

  <!-- Beside the board: a captured black pawn on its side (axis along -X), a clock, a saucer. -->
  <lathe shape="pawn" segments="32" pos="{4*S + F + 9} -10 1.75" rot="0 0 100" material="ebony"/>
  <group name="clock" pos="{-(4*S + F) - 16} 6 0" rot="0 0 25">
    <box pos="0 0 4" size="14 5 8" material="mahogany"/>
    <cylinder pos="-3.6 -2.55 4.2" rot="90 0 0" radius="2.6" height="0.3" material="ivory"/>
    <cylinder pos="3.6 -2.55 4.2" rot="90 0 0" radius="2.6" height="0.3" material="ivory"/>
    <cylinder pos="-3.6 0 9.2" rot="0 0 0" radius="0.9" height="2.4" material="brass"/>
    <cylinder pos="3.6 0 8.4" rot="0 0 0" radius="0.9" height="0.8" material="brass"/>
  </group>
  <cylinder pos="{4*S + F + 12} 18 0.4" rot="90 0 0" radius="6" height="0.8" material="ivory"/>
  <prefab source="items/mug" pos="{4*S + F + 12} 18 0.8" rot="90 0 -30" scale="0.55 0.55 0.55" color="0.58 0.22 0.18"/>
</scene>
