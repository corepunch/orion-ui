<?xml version="1.0" encoding="UTF-8"?>
<scene ambient="0.10 0.10 0.13" background="0.04 0.05 0.07">
  <camera name="Main" comment="Sphere and receiver geometry diagnostic" pos="0 160 450" look="0 50 -300" fov="65"/>

  <light pos="50 250 -150" color="1.0 0.95 0.85" intensity="1.3" radius="600" castShadows="1"/>

  <material id="floor_mat" color="0.35 0.28 0.22" shininess="12"/>
  <material id="wall_mat" color="0.80 0.78 0.72" shininess="6"/>
  <material id="sphere_mat" color="0.55 0.15 0.18" shininess="30"/>

  <!-- floor: receiver only -->
  <box pos="0 -5 -300" size="800 10 600" material="floor_mat" castShadow="0"/>

  <!-- back wall: receiver only -->
  <box pos="0 140 -605" size="800 280 5" material="wall_mat" castShadow="0"/>

  <!-- left wall: receiver only -->
  <box pos="-405 140 -300" size="5 280 600" material="wall_mat" castShadow="0"/>

  <!-- right wall: receiver only -->
  <box pos="405 140 -300" size="5 280 600" material="wall_mat" castShadow="0"/>

  <!-- sphere: only shadow caster -->
  <sphere pos="0 50 -300" radius="40" material="sphere_mat" castShadow="1" rings="16" slices="24"/>
</scene>
