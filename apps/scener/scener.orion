<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="scener"
    title="SimpleSketch3D"
    root="apps/scener"
    stylesheet="scener.css">

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="new" label="New" shortcut="Ctrl+N" />
        <item name="open" label="Open..." shortcut="Ctrl+O" />
        <Separator />
        <item name="save" label="Save" shortcut="Ctrl+S" />
        <item name="saveas" label="Save As..." />
        <Separator />
        <item name="close" label="Close" shortcut="Ctrl+W" />
        <Separator />
        <item name="quit" label="Quit" />
      </menu>

      <menu name="edit" label="Edit">
        <item name="undo" label="Undo" shortcut="Ctrl+Z" />
        <item name="redo" label="Redo" shortcut="Ctrl+Y" />
        <Separator />
        <item name="cut" label="Cut" />
        <item name="copy" label="Copy" />
        <item name="paste" label="Paste" />
        <Separator />
        <item name="duplicate" label="Duplicate" shortcut="Ctrl+D" />
        <item name="delete" label="Delete" shortcut="Delete" />
      </menu>

      <menu name="tool" label="Tools">
        <item name="select" label="Select Mode" shortcut="Q" />
        <item name="move" label="Move Mode" shortcut="W" />
        <item name="rotate" label="Rotate Mode" shortcut="E" />
        <item name="scale" label="Scale Mode" shortcut="R" />
        <item name="select_by_name" label="Select by Name…" shortcut="H" />
        <Separator />
        <item name="grid_snap" label="Grid Snap" />
        <item name="angle_snap" label="Angle Snap" />
      </menu>

      <menu name="view" label="View">
        <item name="zoom_in" label="Zoom In" />
        <item name="zoom_out" label="Zoom Out" />
        <item name="zoom_fit" label="Frame Selected" shortcut="F" />
        <item name="next_camera" label="Next Camera" shortcut="Tab" />
        <item name="prev_camera" label="Previous Camera" shortcut="Shift+Tab" />
        <Separator />
        <item name="perspective" label="Perspective" />
        <item name="front" label="Front" />
        <item name="back" label="Back" />
        <item name="left" label="Left" />
        <item name="right" label="Right" />
        <item name="top" label="Top" />
        <item name="bottom" label="Bottom" />
        <Separator />
        <item name="show_grid" label="[x] Show Grid" />
        <item name="show_shadows" label="[x] Show Shadows" />
        <item name="toggle_ssao" label="Toggle Ambient Occlusion" />
        <item name="show_wireframe" label="[ ] Wireframe Overlay" />
        <Separator />
        <item name="grid_options" label="Grid Options..." />
      </menu>

      <menu name="create" label="Create">
        <item name="box" label="Box" />
        <item name="rect" label="Rect" />
        <item name="circle" label="Circle" />
        <item name="ellipse" label="Ellipse" />
        <item name="star" label="Star" />
        <item name="screen" label="Screen" />
        <item name="sphere" label="Sphere" />
        <item name="cylinder" label="Cylinder" />
        <item name="cone" label="Cone" />
        <item name="torus" label="Torus" />
        <item name="prism" label="Prism" />
        <item name="capsule" label="Capsule" />
        <item name="arch" label="Arch" />
        <item name="window_round" label="Round-arch Window" />
        <item name="window_cottage" label="Cottage Window" />
        <item name="window_gothic" label="Gothic Window" />
        <item name="door_rectangular" label="Rectangular Door" />
        <item name="door_round" label="Round-arch Door" />
        <item name="door_gothic" label="Gothic Door" />
        <Separator />
        <item name="point_light" label="Point Light" />
        <item name="directional_light" label="Directional Light" />
        <Separator />
        <item name="camera" label="Camera from View" />
      </menu>

      <menu name="modify" label="Modify">
        <item name="apply_taper" label="Taper..." />
        <item name="apply_twist" label="Twist..." />
        <item name="apply_bend" label="Bend..." />
        <item name="apply_stretch" label="Stretch..." />
        <item name="apply_skew" label="Skew..." />
        <item name="apply_extrude" label="Extrude..." />
        <item name="apply_mirror" label="Mirror..." />
        <item name="apply_noise" label="Noise..." />
        <item name="apply_shell" label="Shell..." />
        <Separator />
        <item name="apply_array" label="Array..." />
      </menu>

      <menu name="animation" label="Animation">
        <item name="play" label="Play / Pause" shortcut="Space" />
        <item name="rewind" label="Go to Start" shortcut="Shift+Space" />
      </menu>

      <menu name="window" label="Window" dynamic="true">
        <item name="command_panel" label="Rig Hierarchy" />
        <Separator />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <toolbar presentation="normal">
      <Button command="file.open" icon="scener-folder-open" tooltip="Open Scene" />
      <Button command="file.save" icon="scener-floppy-disk" tooltip="Save Scene" />
      <Separator />
      <Button command="tool.select" icon="scener-cursor" checked-icon="scener-cursor-fill" tooltip="Select Object (Q)" flags="TBSTYLE_CHECKGROUP" />
      <Button command="tool.select_by_name" icon="scener-list-magnifying-glass" tooltip="Select by Name (H)" />
      <Separator />
      <Button command="tool.move" icon="scener-arrows-out-cardinal" checked-icon="scener-arrows-out-cardinal-fill" tooltip="Select and Move (W)" flags="TBSTYLE_CHECKGROUP" />
      <Button command="tool.rotate" icon="scener-arrows-clockwise" checked-icon="scener-arrows-clockwise-fill" tooltip="Select and Rotate (E)" flags="TBSTYLE_CHECKGROUP" />
      <Button command="tool.scale" icon="scener-corners-out" checked-icon="scener-corners-out-fill" tooltip="Select and Scale (R)" flags="TBSTYLE_CHECKGROUP" />
      <Separator />
      <Button command="tool.grid_snap" icon="scener-magnet" checked-icon="scener-magnet-fill" tooltip="Grid Snap (10 cm)" flags="TBSTYLE_CHECK" />
      <Button command="tool.angle_snap" icon="scener-angle" checked-icon="scener-angle-fill" tooltip="Angle Snap (15°)" flags="TBSTYLE_CHECK" />
      <Separator />
      <Button command="view.zoom_fit" icon="scener-crosshair" tooltip="Frame Selected (F)" />
    </toolbar>

  <forms>
    <form name="command_panel" title="Command Panel" width="270" height="540" auto_layout="1" spacing="0" flags="notitle,WINDOW_ALWAYSONTOP,WINDOW_NOTRAYBUTTON,WINDOW_NORESIZE">
      <TabView name="command_tabs" flags="flexspace">
        <StackView name="create_page" text="Create" spacing="6" padding="6" flags="vscroll">
          <Label name="shapes_label" text="Shapes" />
          <GridView name="shapes" spacing="4">
            <Column name="shapes_left">
              <Button command="create.box" text="Box" height="22" icon="scener-cube" />
              <Button command="create.sphere" text="Sphere" height="22" icon="scener-globe" />
              <Button command="create.cylinder" text="Cylinder" height="22" icon="scener-cylinder" />
              <Button command="create.cone" text="Cone" height="22" icon="scener-traffic-cone" />
              <Button command="create.torus" text="Torus" height="22" icon="scener-torus" />
              <Button command="create.prism" text="Prism" height="22" icon="scener-pentagon" />
            </Column>
            <Column name="shapes_right">
              <Button command="create.capsule" text="Capsule" height="22" icon="scener-pill" />
              <Button command="create.rect" text="Rectangle" height="22" icon="scener-rectangle" />
              <Button command="create.circle" text="Circle" height="22" icon="scener-circle" />
              <Button command="create.ellipse" text="Ellipse" height="22" icon="scener-ellipse" />
              <Button command="create.star" text="Star" height="22" icon="scener-star" />
              <Button command="create.screen" text="Screen" height="22" icon="scener-monitor" />
            </Column>
          </GridView>
          <Label name="architecture_label" text="Windows and Doors" />
          <GridView name="architecture" spacing="4">
            <Column name="architecture_left">
              <Button command="create.arch" text="Arch" height="22" icon="scener-columns" />
              <Button command="create.window_round" text="Round Window" height="22" icon="scener-circle" />
              <Button command="create.window_cottage" text="Cottage Window" height="22" icon="scener-house" />
              <Button command="create.window_gothic" text="Gothic Window" height="22" icon="scener-church" />
            </Column>
            <Column name="architecture_right">
              <Button command="create.door_rectangular" text="Door" tooltip="Rectangular Door" height="22" icon="scener-door" />
              <Button command="create.door_round" text="Round Door" height="22" icon="scener-door" />
              <Button command="create.door_gothic" text="Gothic Door" height="22" icon="scener-door" />
            </Column>
          </GridView>
          <Label name="lighting_label" text="Lights and Cameras" />
          <GridView name="lighting" spacing="4">
            <Column name="lighting_left">
              <Button command="create.point_light" text="Point Light" height="22" icon="scener-lightbulb" />
              <Button command="create.directional_light" text="Directional Light" height="22" icon="scener-sun" />
            </Column>
            <Column name="lighting_right">
              <Button command="create.camera" text="Camera" tooltip="Camera from View" height="22" icon="scener-camera" />
            </Column>
          </GridView>
          <ReportView name="create_properties" height="132" flags="notitle,flexspace,vscroll,WINDOW_NOACTIVATE" />
        </StackView>
        <StackView name="modify_page" text="Modify" spacing="6" padding="6">
          <Label name="modify_empty" text="Select an object to inspect." />
          <ReportView name="selection_properties" flags="notitle,flexspace,vscroll,WINDOW_NOACTIVATE" />
        </StackView>
        <StackView name="hierarchy_page" text="Hierarchy" spacing="0" />
        <StackView name="motion_page" text="Motion" spacing="6" padding="6">
          <Button command="animation.play" text="Play / Pause" />
          <Button command="animation.rewind" text="Go to Start" />
        </StackView>
        <StackView name="display_page" text="Display" spacing="6" padding="6">
          <CheckBox name="scene_guides" text="Camera and Light Guides" />
          <CheckBox name="character_guides" text="Character Guides" />
        </StackView>
        <StackView name="render_page" text="Render" spacing="6" padding="6">
          <CheckBox name="cast_shadows" text="Cast Shadows" />
          <CheckBox name="ambient_occlusion" text="Ambient Occlusion" />
        </StackView>
        <StackView name="utilities_page" text="Utilities" spacing="6" padding="6">
          <Button command="file.new" text="New Scene" />
          <Button command="file.saveas" text="Save Scene As…" />
        </StackView>
      </TabView>
    </form>
  </forms>

</orion>
