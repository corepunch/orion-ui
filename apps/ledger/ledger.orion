<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ledger — a double-entry bookkeeping platform in the spirit of early-2000s
  desktop accounting suites.

  The platform (this file) is country-neutral. Everything national — chart of
  accounts, tax rates, units, document types with their posting rules and the
  printed legal forms — comes from a *configuration* directory under
  share/configurations/<code>/ and is loaded into the read-only `cfg`
  database. User data lives in the `ib` (infobase) database, one per
  configuration. Swapping the configuration swaps the country.
-->
<orion
    version="1"
    name="ledger"
    title="Ledger"
    root="apps/ledger">

  <menus var="kLedgerMenus" count="kLedgerMenuCount">
    <menu name="file" label="File">
      <item name="save" label="Save" shortcut="Ctrl+S" />
      <Separator />
      <item name="organization" label="Organization Details..." />
      <item name="configuration" label="Select Configuration..." />
      <item name="language" label="Language..." />
      <Separator />
      <item name="import_1c" label="Import from 1C (EnterpriseData)..." />
      <item name="addon" label="Open Add-on..." />
      <Separator />
      <item name="quit" label="Exit" />
    </menu>
    <menu name="doc" label="Documents">
      <item name="new" label="New Document..." shortcut="Ctrl+N" />
      <item name="new_operation" label="New Manual Operation..." shortcut="Ctrl+M" />
      <item name="new_payroll" label="New Payroll Document..." shortcut="Ctrl+W" />
      <item name="new_assets" label="Put Assets into Service..." />
      <item name="close_month" label="Close Month..." shortcut="Ctrl+E" />
      <item name="open" label="Open Document..." shortcut="Ctrl+O" />
      <item name="open_entry" label="Open Entry's Document" />
      <Separator />
      <item name="post" label="Post" shortcut="F9" />
      <item name="post_close" label="Post and Close" shortcut="Ctrl+Enter" />
      <item name="unpost" label="Cancel Posting" />
      <item name="print" label="Print Forms" shortcut="Ctrl+P" />
      <Separator />
      <item name="delete" label="Delete Document..." />
    </menu>
    <menu name="catalog" label="Catalogs">
      <item name="new_counterparty" label="New Counterparty..." />
      <item name="edit_counterparty" label="Edit Counterparty..." />
      <item name="delete_counterparty" label="Delete Counterparty..." />
      <Separator />
      <item name="new_item" label="New Item..." />
      <item name="edit_item" label="Edit Item..." />
      <item name="delete_item" label="Delete Item..." />
      <Separator />
      <item name="new_employee" label="New Employee..." />
      <item name="edit_employee" label="Edit Employee..." />
      <item name="delete_employee" label="Delete Employee..." />
      <Separator />
      <item name="new_asset" label="New Fixed Asset..." />
      <item name="edit_asset" label="Edit Fixed Asset..." />
      <item name="delete_asset" label="Delete Fixed Asset..." />
      <Separator />
      <item name="new_currency" label="New Currency..." />
      <item name="edit_currency" label="Edit Currency..." />
      <item name="new_rate" label="New Exchange Rate..." />
      <item name="delete_rate" label="Delete Exchange Rate..." />
    </menu>
    <menu name="view" label="View">
      <item name="back" label="Back" shortcut="Alt+Left" />
      <item name="forward" label="Forward" shortcut="Alt+Right" />
      <item name="sidebar" label="Show or Hide Sidebar" shortcut="Ctrl+B" />
      <Separator />
      <item name="journal" label="Document Journal" shortcut="Ctrl+1" />
      <item name="counterparties" label="Counterparties" shortcut="Ctrl+2" />
      <item name="items" label="Items" shortcut="Ctrl+3" />
      <item name="accounts" label="Chart of Accounts" shortcut="Ctrl+4" />
      <item name="employees" label="Employees" shortcut="Ctrl+5" />
      <item name="assets" label="Fixed Assets" shortcut="Ctrl+6" />
      <item name="currencies" label="Currencies" shortcut="Ctrl+7" />
      <item name="entries" label="Entry Journal" shortcut="Ctrl+8" />
      <item name="reports" label="Reports" shortcut="Ctrl+9" />
      <item name="config" label="Configuration" shortcut="Ctrl+0" />
    </menu>
    <menu name="report" label="Reports">
      <item name="settings" label="Report Settings..." shortcut="Ctrl+R" />
      <item name="recalc" label="Recalculate Totals" shortcut="F5" />
      <item name="print" label="Print Report Forms" shortcut="Ctrl+Shift+P" />
      <Separator />
      <item name="card" label="Account Card" shortcut="Ctrl+K" />
    </menu>
    <menu name="window" label="Window">
      <item name="next_document" label="Next Document" shortcut="Ctrl+F6" />
      <item name="previous_document" label="Previous Document" shortcut="Ctrl+Shift+F6" />
      <item name="close_document" label="Close Document" shortcut="Ctrl+F4" />
      <Separator />
      <item name="cascade" label="Cascade Documents" />
      <item name="tile" label="Tile Documents" />
    </menu>
    <menu name="help" label="Help">
      <item name="find_command" label="Find a Command..." shortcut="Ctrl+Shift+K" />
      <item name="assistant" label="Show Office Assistant" shortcut="Ctrl+Shift+A" />
      <Separator />
      <item name="about" label="About Ledger" />
    </menu>
  </menus>

  <databases>
    <!-- Configuration: national metadata and predefined data. Read-only. -->
    <database name="cfg" class="db_schema_xml">
      <!-- currency_units / cents_units: plural forms for amounts in words,
           "рубль|рубля|рублей"; *_gender is m, f or n. -->
      <table name="settings">
        <field name="id" type="integer" key="YES" />
        <field name="cash_account_id" type="integer" relation="accounts.id" />
        <field name="payroll_account_id" type="integer" relation="accounts.id" />
        <!-- Opening balances are entered against this account (000 in Russia, 9000 in SKR 03). -->
        <field name="opening_account_id" type="integer" relation="accounts.id" />
        <field name="code" type="string" length="32" />
        <field name="name" type="string" length="128" />
        <field name="country" type="string" length="64" />
        <field name="currency" type="string" length="16" />
        <!-- ISO 4217 code of the national currency, which the currencies catalog leaves out. -->
        <field name="currency_code" type="string" length="4" />
        <field name="currency_units" type="string" length="64" />
        <field name="currency_gender" type="string" length="4" />
        <field name="cents_units" type="string" length="64" />
        <field name="cents_gender" type="string" length="4" />
        <field name="language" type="string" length="16" />
        <field name="tax_name" type="string" length="32" />
        <field name="tax_id_name" type="string" length="32" />
        <field name="version" type="string" length="32" />
        <field name="basis" type="string" length="512" />
      </table>
      <!-- Kinds of analytics (subconto): each names the infobase table whose
           records an account is analysed by. -->
      <table name="subconto_kinds">
        <field name="id" type="integer" key="YES" />
        <field name="code" type="string" length="16" />
        <field name="name" type="string" length="64" />
        <field name="table" type="string" length="32" />
      </table>
      <table name="accounts">
        <field name="id" type="integer" key="YES" />
        <field name="subconto_kind_id" type="integer" relation="subconto_kinds.id" />
        <field name="code" type="string" length="16" />
        <field name="name" type="string" length="160" />
        <field name="kind" type="string" length="8" />
        <field name="section" type="string" length="96" />
        <!-- Kept in foreign currency too; revalued when the month is closed. -->
        <field name="currency" type="boolean" />
      </table>
      <table name="units">
        <field name="id" type="integer" key="YES" />
        <field name="code" type="string" length="8" />
        <field name="name" type="string" length="32" />
      </table>
      <!-- Tax rates. A rate may carry its own accounts, as DATEV's automatic
           accounts do: sales at the rate post revenue to revenue_id and tax to
           output_tax_id, purchases post the expense to expense_id and the tax
           to input_tax_id (SKR 03: 8400/1776 for 19 %, 8300/1771 for 7 %).
           Empty accounts fall back to the document type's. -->
      <table name="vat_rates">
        <field name="id" type="integer" key="YES" />
        <field name="revenue_id" type="integer" relation="accounts.id" />
        <field name="expense_id" type="integer" relation="accounts.id" />
        <field name="output_tax_id" type="integer" relation="accounts.id" />
        <field name="input_tax_id" type="integer" relation="accounts.id" />
        <field name="name" type="string" length="32" />
        <field name="rate" type="double" />
      </table>
      <!-- Posting rules. form picks the dialog and the posting:
             document  lines of goods or a total: amount Dt debit / Kt credit,
                       tax Dt vat_debit / Kt vat_credit, and the average cost of
                       goods sold Dt cost_debit / Kt cost_credit;
             operation entries typed by the accountant;
             payroll   employees: base "gross" accrues pay and payroll taxes,
                       "net" pays it out (Dt debit / Kt credit);
             assets    fixed assets put into service: Dt asset account / Kt credit;
             closing   month-end closing by the configuration's closing rules.
           base is "net" (amount without tax) or "total" for documents.
           vat_book: 1 lists the document in the sales book, 2 in the purchase book.
           auto_accounts: each line's tax rate may replace the revenue or
           expense account and the tax account with its own (vat_rates). -->
      <table name="doc_types">
        <field name="id" type="integer" key="YES" />
        <field name="debit_id" type="integer" relation="accounts.id" />
        <field name="credit_id" type="integer" relation="accounts.id" />
        <field name="vat_debit_id" type="integer" relation="accounts.id" />
        <field name="vat_credit_id" type="integer" relation="accounts.id" />
        <field name="cost_debit_id" type="integer" relation="accounts.id" />
        <field name="cost_credit_id" type="integer" relation="accounts.id" />
        <field name="code" type="string" length="32" />
        <field name="name" type="string" length="96" />
        <field name="prefix" type="string" length="8" />
        <field name="form" type="string" length="16" />
        <field name="base" type="string" length="8" />
        <field name="vat_book" type="integer" />
        <field name="auto_accounts" type="boolean" />
        <!-- A function of the configuration's rules.lua that posts the document instead of the form's built-in posting. -->
        <field name="script" type="string" length="32" />
        <field name="description" type="string" length="512" />
      </table>
      <!-- Payroll taxes on accrued pay, in id order: withheld ones reduce the
           employee's net pay (Dt debit / Kt credit), the others are the
           employer's cost (Dt the employee's expense account when debit is
           empty). Rows are effective-dated: a document applies the rows whose
           valid_from..valid_to (empty = open) contain its date, so a new year
           adds rows instead of editing them.
             allowance        the employee's monthly allowance is deducted from
                              the base; allowance_limit (annual, 0 = none) ends
                              it once the year's pay exceeds it (ст. 218 НК РФ)
             cap_month        monthly base ceiling (Beitragsbemessungsgrenze)
             cap_year         annual base ceiling (единая предельная база);
                              rate_above applies to the part above either cap
             scale            "" flat rate; "cumulative": the tax_scales zones
                              on the year's base so far (НДФЛ); "annualized":
                              the zones on twelve monthly bases, one twelfth
                              of the result (Lohnsteuer, § 39b EStG)
             after_withheld   the base is reduced by the taxes withheld before
                              this row (Vorsorgepauschale)
             rounding         "" to cents; "unit" to whole currency units
                              (НДФЛ, ст. 52 НК РФ); "floor" the annual tax to
                              whole units, then the twelfth to cents (§ 39b) -->
      <table name="payroll_taxes">
        <field name="id" type="integer" key="YES" />
        <field name="debit_id" type="integer" relation="accounts.id" />
        <field name="credit_id" type="integer" relation="accounts.id" />
        <field name="code" type="string" length="16" />
        <field name="name" type="string" length="96" />
        <field name="rate" type="double" />
        <field name="rate_above" type="double" />
        <field name="cap_month" type="double" />
        <field name="cap_year" type="double" />
        <field name="allowance_limit" type="double" />
        <field name="withheld" type="boolean" />
        <field name="allowance" type="boolean" />
        <field name="after_withheld" type="boolean" />
        <field name="scale" type="string" length="16" />
        <field name="rounding" type="string" length="8" />
        <!-- A function of rules.lua that computes this tax from the context (Solidaritätszuschlag, SME tariffs). -->
        <field name="script" type="string" length="32" />
        <field name="valid_from" type="date" />
        <field name="valid_to" type="date" />
      </table>
      <!-- Zones of a progressive scale, by base_from ascending. The tax on an
           annual base x in a zone is fixed + rate % of (x - base_from) +
           curve * ((x - base_from) / 10000)^2: a marginal bracket (НДФЛ, curve
           0) or a quadratic progression zone (§ 32a EStG). -->
      <table name="tax_scales">
        <field name="id" type="integer" key="YES" />
        <field name="tax_id" type="integer" relation="payroll_taxes.id" />
        <field name="base_from" type="double" />
        <field name="rate" type="double" />
        <field name="fixed" type="double" />
        <field name="curve" type="double" precision="2" />
      </table>
      <!-- Month-end closing, in id order:
             depreciation  each asset's monthly straight-line depreciation;
             transfer      the balance of account (with subaccounts) to target,
                           written against via (default: the account itself);
             revaluation   currency accounts at the closing date's rate, the
                           difference to gain or loss. -->
      <table name="closing_rules">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="accounts.id" />
        <field name="target_id" type="integer" relation="accounts.id" />
        <field name="via_id" type="integer" relation="accounts.id" />
        <field name="gain_id" type="integer" relation="accounts.id" />
        <field name="loss_id" type="integer" relation="accounts.id" />
        <field name="kind" type="string" length="16" />
        <!-- depreciation: "next" starts in the month after the asset is put
             into service, "same" in that month. -->
        <field name="start" type="string" length="8" />
        <!-- kind="script": the rules.lua function that writes the step's entries. -->
        <field name="script" type="string" length="32" />
        <field name="name" type="string" length="96" />
      </table>
      <!-- Opening balances in a 1C EnterpriseData file come as documents named
           by what they hold (Документ.ОстаткиРасчетовСПоставщикамиДолги): each
           opens its rows on account (Dt, or Kt when credit), on
           currency_account_id when the row is in a foreign currency. -->
      <table name="balance_rules">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="accounts.id" />
        <field name="currency_account_id" type="integer" relation="accounts.id" />
        <field name="document" type="string" length="128" />
        <field name="credit" type="boolean" />
      </table>
      <!-- Document print forms; report forms name a report table instead. -->
      <table name="print_forms">
        <field name="id" type="integer" key="YES" />
        <field name="doc_type_id" type="integer" relation="doc_types.id" />
        <field name="report" type="string" length="32" />
        <field name="name" type="string" length="96" />
        <field name="template" type="string" length="64" />
        <field name="basis" type="string" length="256" />
      </table>
      <!-- The legal acts the configuration implements, by area (accounts,
           vat, payroll, assets, forms, cash, reporting), with the date the
           cited wording took effect and where to re-check it. -->
      <table name="regulations">
        <field name="id" type="integer" key="YES" />
        <field name="area" type="string" length="32" />
        <field name="title" type="string" length="160" />
        <field name="reference" type="string" length="160" />
        <field name="valid_from" type="date" />
        <field name="url" type="string" length="160" />
      </table>
    </database>

    <!-- Index of installed configurations (share/configurations/index.xml). -->
    <database name="catalog" class="db_schema_xml">
      <table name="configurations">
        <field name="id" type="integer" key="YES" />
        <field name="code" type="string" length="32" />
        <field name="name" type="string" length="128" />
        <field name="country" type="string" length="64" />
      </table>
      <table name="languages">
        <field name="id" type="integer" key="YES" />
        <field name="code" type="string" length="16" />
        <field name="name" type="string" length="64" />
      </table>
      <table name="choices">
        <field name="id" type="integer" key="YES" />
        <field name="configuration_id" type="integer" relation="configurations.id" />
        <field name="language_id" type="integer" relation="languages.id" />
      </table>
    </database>

    <!-- Infobase: the organization's own data, one per configuration. The
         ledger_ib datasource (ledger_ib.c) adds Ledger's rules to the schema
         class: numbering, recalculation of documents when they or their lines
         change. default= fills new records; on-delete= says what deleting a
         referenced record does: cascade, nullify or deny. -->
    <database name="ib" class="ledger_ib">
      <table name="organizations">
        <field name="id" type="integer" key="YES" />
        <field name="name" type="string" length="160" />
        <field name="tax_id" type="string" length="16" />
        <field name="kpp" type="string" length="16" />
        <field name="address" type="string" length="256" />
        <field name="bank" type="string" length="160" />
        <field name="bank_account" type="string" length="32" />
        <field name="bik" type="string" length="16" />
        <field name="corr_account" type="string" length="32" />
        <field name="director" type="string" length="96" />
        <field name="accountant" type="string" length="96" />
        <field name="cashier" type="string" length="96" />
      </table>
      <table name="counterparties">
        <field name="id" type="integer" key="YES" />
        <field name="name" type="string" length="160" />
        <field name="tax_id" type="string" length="16" />
        <field name="kpp" type="string" length="16" />
        <field name="address" type="string" length="256" />
        <field name="bank" type="string" length="160" />
        <field name="bank_account" type="string" length="32" />
        <field name="bik" type="string" length="16" />
        <field name="phone" type="string" length="32" />
      </table>
      <table name="items">
        <field name="id" type="integer" key="YES" />
        <field name="unit_id" type="integer" relation="cfg.units.id" />
        <field name="vat_rate_id" type="integer" relation="cfg.vat_rates.id" />
        <field name="sku" type="string" length="16" />
        <field name="name" type="string" length="160" />
        <field name="price" type="double" />
      </table>
      <!-- account_id: where the employee's pay is expensed (26, 44, ...).
           allowance: monthly amount exempt from allowance taxes. -->
      <table name="employees">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="cfg.accounts.id" />
        <field name="name" type="string" length="128" />
        <field name="position" type="string" length="96" />
        <field name="tax_id" type="string" length="16" />
        <field name="hired" type="date" default="today" />
        <field name="salary" type="double" />
        <field name="allowance" type="double" />
      </table>
      <!-- Fixed assets: straight-line depreciation over life months from the
           month after the asset is put into service. -->
      <table name="assets">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="cfg.accounts.id" />
        <field name="depreciation_id" type="integer" relation="cfg.accounts.id" />
        <field name="expense_id" type="integer" relation="cfg.accounts.id" />
        <field name="inventory" type="string" length="16" />
        <field name="name" type="string" length="160" />
        <field name="cost" type="double" />
        <field name="life" type="integer" default="36" />
        <field name="commissioned" type="date" />
      </table>
      <table name="currencies">
        <field name="id" type="integer" key="YES" />
        <field name="code" type="string" length="8" />
        <field name="name" type="string" length="64" />
      </table>
      <!-- Exchange rates: units of national currency per unit of currency. -->
      <table name="rates">
        <field name="id" type="integer" key="YES" />
        <field name="currency_id" type="integer" relation="currencies.id" on-delete="cascade" />
        <field name="date" type="date" default="today" />
        <field name="rate" type="double" precision="4" />
      </table>
      <!-- Amounts are in the document's currency; posting converts them at
           its rate (the rate on the document date when left empty). -->
      <table name="documents">
        <field name="id" type="integer" key="YES" />
        <field name="doc_type_id" type="integer" relation="cfg.doc_types.id" />
        <field name="counterparty_id" type="integer" relation="counterparties.id" on-delete="deny" />
        <field name="currency_id" type="integer" relation="currencies.id" on-delete="deny" />
        <field name="number" type="string" length="24" />
        <field name="date" type="date" default="today" />
        <field name="comment" type="string" length="256" />
        <field name="import_source" type="string" length="65" />
        <field name="rate" type="double" precision="4" />
        <field name="amount" type="double" />
        <field name="vat" type="double" />
        <field name="total" type="double" />
        <field name="posted" type="boolean" />
      </table>
      <table name="doc_lines">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" on-delete="cascade" />
        <field name="item_id" type="integer" relation="items.id" on-delete="deny" />
        <field name="vat_rate_id" type="integer" relation="cfg.vat_rates.id" />
        <field name="quantity" type="double" precision="3" default="1" />
        <field name="price" type="double" />
        <field name="amount" type="double" />
        <field name="vat" type="double" />
        <field name="total" type="double" />
      </table>
      <!-- amount: accrued pay, or the sum paid out by a payout document. -->
      <table name="payroll_lines">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" on-delete="cascade" />
        <field name="employee_id" type="integer" relation="employees.id" on-delete="deny" />
        <field name="amount" type="double" />
        <field name="withheld" type="double" />
        <field name="contributions" type="double" />
        <field name="net" type="double" />
      </table>
      <table name="asset_lines">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" on-delete="cascade" />
        <field name="asset_id" type="integer" relation="assets.id" on-delete="deny" />
        <field name="amount" type="double" />
      </table>
      <!-- Each side keeps the analytics its account asks for: the subconto's
           table comes from the account's subconto kind. -->
      <table name="entries">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" on-delete="cascade" />
        <field name="debit_id" type="integer" relation="cfg.accounts.id" />
        <field name="credit_id" type="integer" relation="cfg.accounts.id" />
        <field name="debit_subconto_id" type="integer" relation="ib.{debit.subconto_kind.table}.id" />
        <field name="credit_subconto_id" type="integer" relation="ib.{credit.subconto_kind.table}.id" />
        <field name="currency_id" type="integer" relation="currencies.id" />
        <field name="date" type="date" />
        <field name="quantity" type="double" precision="3" />
        <field name="currency_amount" type="double" />
        <field name="amount" type="double" />
        <field name="content" type="string" length="160" />
      </table>
      <!-- Report parameters (one record): the period and the analysed account. -->
      <table name="report_settings">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="cfg.accounts.id" />
        <field name="date_from" type="date" />
        <field name="date_to" type="date" />
      </table>
      <!-- Report results, rebuilt from entries; never saved. -->
      <!-- subaccount: the row repeats part of its parent account's row and stays out of the totals. -->
      <table name="balances" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="cfg.accounts.id" />
        <field name="subaccount" type="boolean" />
        <field name="opening_dr" type="double" />
        <field name="opening_cr" type="double" />
        <field name="debit_turnover" type="double" />
        <field name="credit_turnover" type="double" />
        <field name="balance_dr" type="double" />
        <field name="balance_cr" type="double" />
      </table>
      <table name="card" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" />
        <field name="account_id" type="integer" relation="cfg.accounts.id" />
        <field name="subconto_id" type="integer" relation="ib.{account.subconto_kind.table}.id" />
        <field name="corr_id" type="integer" relation="cfg.accounts.id" />
        <field name="date" type="date" />
        <field name="debit" type="double" />
        <field name="credit" type="double" />
        <field name="balance" type="double" />
        <field name="content" type="string" length="160" />
      </table>
      <table name="analysis_rows" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="account_id" type="integer" relation="cfg.accounts.id" />
        <field name="subconto_id" type="integer" relation="ib.{account.subconto_kind.table}.id" />
        <field name="opening_dr" type="double" />
        <field name="opening_cr" type="double" />
        <field name="debit_turnover" type="double" />
        <field name="credit_turnover" type="double" />
        <field name="balance_dr" type="double" />
        <field name="balance_cr" type="double" />
      </table>
      <!-- Sales (book 1) and purchase (book 2) books: one row per document
           and tax rate, as the books and the tax return split them. -->
      <table name="vat_book" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" />
        <field name="counterparty_id" type="integer" relation="counterparties.id" />
        <field name="vat_rate_id" type="integer" relation="cfg.vat_rates.id" />
        <field name="book" type="integer" />
        <field name="date" type="date" />
        <field name="total" type="double" />
        <field name="amount" type="double" />
        <field name="vat" type="double" />
      </table>
      <!-- The books totalled per tax rate: the lines of a VAT return
           (раздел 3 декларации по НДС, Umsatzsteuer-Voranmeldung). -->
      <table name="vat_summary" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="vat_rate_id" type="integer" relation="cfg.vat_rates.id" />
        <field name="book" type="integer" />
        <field name="documents" type="integer" />
        <field name="total" type="double" />
        <field name="amount" type="double" />
        <field name="vat" type="double" />
      </table>
      <!-- Entries of posted documents within the report period: the journal
           printed or exported (DATEV Buchungsstapel, журнал операций). -->
      <table name="journal_rows" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" />
        <field name="debit_id" type="integer" relation="cfg.accounts.id" />
        <field name="credit_id" type="integer" relation="cfg.accounts.id" />
        <field name="debit_subconto_id" type="integer" relation="ib.{debit.subconto_kind.table}.id" />
        <field name="credit_subconto_id" type="integer" relation="ib.{credit.subconto_kind.table}.id" />
        <field name="currency_id" type="integer" relation="currencies.id" />
        <field name="date" type="date" />
        <field name="quantity" type="double" precision="3" />
        <field name="currency_amount" type="double" />
        <field name="amount" type="double" />
        <field name="content" type="string" length="160" />
      </table>
      <!-- Cash book: per day the opening balance, the cash orders, the day's
           totals and the closing balance. -->
      <table name="cash_book" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="document_id" type="integer" relation="documents.id" />
        <field name="corr_id" type="integer" relation="cfg.accounts.id" />
        <field name="subconto_id" type="integer" relation="ib.{corr.subconto_kind.table}.id" />
        <field name="date" type="date" />
        <field name="content" type="string" length="160" />
        <field name="receipt" type="double" />
        <field name="expense" type="double" />
        <field name="balance" type="double" />
        <!-- A day's opening balance or totals row: not counted in the book's totals. -->
        <field name="summary" type="boolean" />
      </table>
      <table name="asset_rows" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="asset_id" type="integer" relation="assets.id" />
        <field name="cost" type="double" />
        <field name="monthly" type="double" />
        <field name="depreciation" type="double" />
        <field name="residual" type="double" />
      </table>
      <!-- Payroll statement: what each employee is owed on the payroll account. -->
      <table name="payroll_rows" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="employee_id" type="integer" relation="employees.id" />
        <field name="opening" type="double" />
        <field name="accrued" type="double" />
        <field name="deducted" type="double" />
        <field name="closing" type="double" />
      </table>
    </database>
  </databases>

  <forms>
    <form name="main_window" title="Ledger" width="1200" height="700"
          role="host" active-page="journal_page" flags="statusbar,toolbar,titletoolbar" spacing="0">
      <!-- One row, as in Finder or Mail: the sidebar toggle over the section panel, then back and
           forward, the page's title over the organization and period, and the active page's buttons. -->
      <Toolbar>
        <Button command="view.sidebar" icon="ledger-sidebar" tooltip="Show or hide the sidebar (Ctrl+B)" />
        <sidebar-separator />
        <Button command="view.back" icon="ledger-back" tooltip="Back (Alt+Left)" />
        <Button command="view.forward" icon="ledger-forward" tooltip="Forward (Alt+Right)" />
        <title />
        <spacer flags="TOOLBAR_ITEM_FLAG_FLEXSPACE" />
      </Toolbar>
      <ActivityBar name="activity" flags="notitle" labels="right">
        <Page form="journal_page" command="view.journal" />
        <Page form="counterparties_page" command="view.counterparties" />
        <Page form="items_page" command="view.items" />
        <Page form="accounts_page" command="view.accounts" />
        <Page form="employees_page" command="view.employees" />
        <Page form="assets_page" command="view.assets" />
        <Page form="currencies_page" command="view.currencies" />
        <Page form="entries_page" command="view.entries" />
        <Page form="reports_page" command="view.reports" />
        <Page form="config_page" command="view.config" />
      </ActivityBar>
      <MDIClient name="documents_client" />
    </form>

    <!-- Document journal: documents with their lines and entries below. -->
    <form name="journal_page" label="Journal" title="Document Journal" icon="ledger-nav-journal"
          checked-icon="ledger-nav-journal-fill" tooltip="Document journal (Ctrl+1)"
          focus="documents" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="doc.new" icon="ledger-new" text="New" tooltip="New document (Ctrl+N)" />
        <Button command="doc.new_operation" icon="ledger-operation" text="Operation" tooltip="New manual operation (Ctrl+M)" />
        <Button command="doc.new_payroll" icon="ledger-payroll" text="Payroll" tooltip="New payroll document (Ctrl+W)" />
        <Button command="doc.close_month" icon="ledger-close-month" text="Close Month" tooltip="Month-end closing (Ctrl+E)" />
        <Button command="doc.open" icon="ledger-edit" text="Open" tooltip="Open document (Ctrl+O)" />
        <Button command="doc.post" icon="ledger-post" text="Post" tooltip="Post: write accounting entries (F9)" />
        <Button command="doc.unpost" icon="ledger-unpost" text="Unpost" tooltip="Cancel posting" />
        <Button command="doc.print" icon="ledger-print" text="Print" tooltip="Print forms (Ctrl+P)" />
        <spacer />
        <Button command="doc.delete" icon="ledger-delete" text="Delete" tooltip="Delete document" />
      </Toolbar>
      <StackView name="journal" spacing="0" flags="flexspace">
        <SplitView name="journal_split" orientation="vertical" split-ratio="0.58" flags="flexspace">
          <TableView name="documents" source="ib.documents" flags="notitle,nofill,vscroll,flexspace">
            <RowIcon field="posted" icon="ledger-doc-posted" color="success" />
            <RowIcon icon="ledger-doc-draft" color="secondary" />
            <Column field="date" title="Date" width="100" />
            <Column field="number" title="Number" width="80" />
            <Column field="doc_type.name" title="Document" width="0" min-width="120" />
            <Column field="counterparty.name" title="Counterparty" width="0" min-width="120" />
            <Column field="total" title="Amount" width="90" />
            <Column field="currency.code" title="Cur." width="40" />
            <Column field="comment" title="Comment" width="0" />
          </TableView>
          <TabView name="details" flags="flexspace">
            <TableView name="lines" text="Lines" source="ib.doc_lines" flags="notitle,nofill,vscroll">
              <Column field="item.name" title="Item" width="0" min-width="120" />
              <Column field="item.unit.name" title="Unit" width="44" />
              <Column field="quantity" title="Qty" width="64" />
              <Column field="price" title="Price" width="80" />
              <Column field="amount" title="Amount" width="84" total="sum" />
              <Column field="vat_rate.name" title="Tax" width="48" />
              <Column field="vat" title="Tax Amount" width="80" total="sum" />
              <Column field="total" title="Total" width="84" total="sum" />
            </TableView>
            <TableView name="doc_entries" zeros="blank" text="Entries" source="ib.entries" flags="notitle,nofill,vscroll">
              <Column field="debit.code" title="Dr" width="56" />
              <Column field="debit_subconto.name" title="Dr Analytics" width="0" />
              <Column field="credit.code" title="Cr" width="56" />
              <Column field="credit_subconto.name" title="Cr Analytics" width="0" />
              <Column field="quantity" title="Qty" width="64" />
              <Column field="amount" title="Amount" width="90" total="sum" />
              <Column field="content" title="Content" width="0" />
            </TableView>
          </TabView>
        </SplitView>
      </StackView>
    </form>

    <form name="counterparties_page" label="Counterparties" title="Counterparties" icon="ledger-nav-counterparties"
          checked-icon="ledger-nav-counterparties-fill" tooltip="Counterparties (Ctrl+2)"
          focus="counterparties" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="catalog.new_counterparty" icon="ledger-new" text="New" tooltip="New counterparty" />
        <Button command="catalog.edit_counterparty" icon="ledger-edit" text="Edit" tooltip="Edit counterparty" />
        <spacer />
        <Button command="catalog.delete_counterparty" icon="ledger-delete" text="Delete" tooltip="Delete counterparty" />
      </Toolbar>
      <TableView name="counterparties" source="ib.counterparties" form="counterparty" flags="notitle,nofill,vscroll,flexspace">
        <RowIcon icon="ledger-row-counterparty" color="info" />
        <Column field="name" title="Name" width="0" min-width="160" />
        <Column field="tax_id" title="Tax ID" width="100" />
        <Column field="kpp" title="KPP" width="84" />
        <Column field="phone" title="Phone" width="100" />
        <Column field="address" title="Address" width="0" />
      </TableView>
    </form>

    <form name="items_page" label="Items" title="Items" icon="ledger-nav-items" checked-icon="ledger-nav-items-fill"
          tooltip="Goods and services (Ctrl+3)" focus="items" width="900" height="560" role="page"
          flags="nofill,flexspace" spacing="4" padding="0">
      <Toolbar>
        <Button command="catalog.new_item" icon="ledger-new" text="New" tooltip="New item" />
        <Button command="catalog.edit_item" icon="ledger-edit" text="Edit" tooltip="Edit item" />
        <spacer />
        <Button command="catalog.delete_item" icon="ledger-delete" text="Delete" tooltip="Delete item" />
      </Toolbar>
      <TableView name="items" source="ib.items" form="item" flags="notitle,nofill,vscroll,flexspace">
        <RowIcon icon="ledger-row-item" color="info" />
        <Column field="sku" title="Code" width="80" />
        <Column field="name" title="Name" width="0" min-width="160" />
        <Column field="unit.name" title="Unit" width="56" />
        <Column field="vat_rate.name" title="Tax" width="56" />
        <Column field="price" title="Price" width="90" />
      </TableView>
    </form>

    <form name="accounts_page" label="Accounts" title="Chart of Accounts" icon="ledger-nav-accounts"
          checked-icon="ledger-nav-accounts-fill" tooltip="Chart of accounts (Ctrl+4)"
          focus="accounts" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="report.card" icon="ledger-card" text="Card" tooltip="Account card of the selected account (Ctrl+K)" />
        <Button command="report.settings" icon="ledger-settings" text="Settings" tooltip="Period and account (Ctrl+R)" />
      </Toolbar>
      <TableView name="accounts" source="cfg.accounts" flags="notitle,nofill,vscroll,flexspace">
        <RowIcon icon="ledger-row-account" color="info" />
        <Column field="code" title="Code" width="72" />
        <Column field="name" title="Account" width="0" min-width="200" />
        <Column field="kind" title="Kind" width="44" />
        <Column field="subconto_kind.name" title="Analytics" width="136" />
        <Column field="currency" title="Currency" width="64" />
        <Column field="section" title="Section" width="0" />
      </TableView>
    </form>

    <form name="employees_page" label="Employees" title="Employees" icon="ledger-nav-employees"
          checked-icon="ledger-nav-employees-fill" tooltip="Employees (Ctrl+5)"
          focus="employees" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="catalog.new_employee" icon="ledger-new" text="New" tooltip="New employee" />
        <Button command="catalog.edit_employee" icon="ledger-edit" text="Edit" tooltip="Edit employee" />
        <Button command="doc.new_payroll" icon="ledger-payroll" text="Payroll" tooltip="New payroll document (Ctrl+W)" />
        <spacer />
        <Button command="catalog.delete_employee" icon="ledger-delete" text="Delete" tooltip="Delete employee" />
      </Toolbar>
      <TableView name="employees" source="ib.employees" form="employee" flags="notitle,nofill,vscroll,flexspace">
        <RowIcon icon="ledger-row-employee" color="info" />
        <Column field="name" title="Name" width="0" min-width="160" />
        <Column field="position" title="Position" width="0" />
        <Column field="tax_id" title="Tax ID" width="100" />
        <Column field="hired" title="Hired" width="80" />
        <Column field="salary" title="Salary" width="90" />
        <Column field="allowance" title="Allowance" width="80" />
        <Column field="account.code" title="Expense" width="60" />
      </TableView>
    </form>

    <form name="assets_page" label="Assets" title="Fixed Assets" icon="ledger-nav-assets"
          checked-icon="ledger-nav-assets-fill" tooltip="Fixed assets (Ctrl+6)"
          focus="assets" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="catalog.new_asset" icon="ledger-new" text="New" tooltip="New fixed asset" />
        <Button command="catalog.edit_asset" icon="ledger-edit" text="Edit" tooltip="Edit fixed asset" />
        <Button command="doc.new_assets" icon="ledger-post" text="Into Service" tooltip="Put assets into service" />
        <spacer />
        <Button command="catalog.delete_asset" icon="ledger-delete" text="Delete" tooltip="Delete fixed asset" />
      </Toolbar>
      <TableView name="assets" source="ib.assets" form="asset" flags="notitle,nofill,vscroll,flexspace">
        <RowIcon field="commissioned" icon="ledger-row-in-service" color="success" />
        <RowIcon icon="ledger-row-pending" color="warning" />
        <Column field="inventory" title="Inv. No." width="84" />
        <Column field="name" title="Name" width="0" min-width="160" />
        <Column field="account.code" title="Account" width="56" />
        <Column field="cost" title="Cost" width="96" />
        <Column field="life" title="Life, months" width="84" />
        <Column field="commissioned" title="In Service" width="80" />
        <Column field="depreciation.code" title="Depr." width="48" />
        <Column field="expense.code" title="Expense" width="56" />
      </TableView>
    </form>

    <form name="currencies_page" label="Currencies" title="Currencies" icon="ledger-nav-currencies"
          checked-icon="ledger-nav-currencies-fill" tooltip="Currencies and exchange rates (Ctrl+7)"
          focus="currencies" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="catalog.new_currency" icon="ledger-new" text="Currency" tooltip="New currency" />
        <Button command="catalog.edit_currency" icon="ledger-edit" text="Edit" tooltip="Edit currency" />
        <Button command="catalog.new_rate" icon="ledger-new" text="Rate" tooltip="New exchange rate" />
        <spacer />
        <Button command="catalog.delete_rate" icon="ledger-delete" text="Delete Rate" tooltip="Delete exchange rate" />
      </Toolbar>
      <StackView name="currency_stack" spacing="0" flags="flexspace">
        <SplitView name="currency_split" orientation="horizontal" split-ratio="0.4" flags="flexspace">
          <TableView name="currencies" source="ib.currencies" form="currency" flags="notitle,nofill,vscroll,flexspace">
            <RowIcon icon="ledger-row-currency" color="info" />
            <Column field="code" title="Code" width="72" />
            <Column field="name" title="Currency" width="0" />
          </TableView>
          <TableView name="rates" source="ib.rates" form="rate" flags="notitle,nofill,vscroll,flexspace">
            <Column field="date" title="Date" width="96" />
            <Column field="rate" title="Rate" width="0" />
          </TableView>
        </SplitView>
      </StackView>
    </form>

    <form name="entries_page" label="Entries" title="Entry Journal" icon="ledger-nav-entries"
          checked-icon="ledger-nav-entries-fill" tooltip="All accounting entries (Ctrl+8)"
          focus="entries" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="doc.open_entry" icon="ledger-open" text="Document" tooltip="Open the entry's document" />
        <Button command="report.card" icon="ledger-card" text="Card" tooltip="Account card of the entry's debit account (Ctrl+K)" />
      </Toolbar>
      <TableView name="entries" zeros="blank" source="ib.entries" master="none" flags="notitle,nofill,vscroll,flexspace">
        <RowIcon icon="ledger-row-entry" color="secondary" />
        <Column field="date" title="Date" width="96" />
        <Column field="document.number" title="Document" width="80" />
        <Column field="debit.code" title="Dr" width="56" />
        <Column field="debit_subconto.name" title="Dr Analytics" width="0" />
        <Column field="credit.code" title="Cr" width="56" />
        <Column field="credit_subconto.name" title="Cr Analytics" width="0" />
        <Column field="quantity" title="Qty" width="64" />
        <Column field="currency.code" title="Cur." width="40" />
        <Column field="currency_amount" title="Cur. Amount" width="100" />
        <Column field="amount" title="Amount" width="96" total="sum" />
        <Column field="content" title="Content" width="0" />
      </TableView>
    </form>

    <!-- Reports for the period in Report Settings: trial balance, account
         card and analysis of the chosen account, VAT books. -->
    <form name="reports_page" label="Reports" title="Reports" icon="ledger-nav-balance"
          checked-icon="ledger-nav-balance-fill" tooltip="Reports (Ctrl+9)"
          focus="balances" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="report.settings" icon="ledger-settings" text="Settings" tooltip="Period and account (Ctrl+R)" />
        <Button command="report.recalc" icon="ledger-post" text="Recalculate" tooltip="Rebuild reports from entries (F5)" />
        <Button command="report.print" icon="ledger-print" text="Print" tooltip="Print report forms: cash book (Ctrl+Shift+P)" />
      </Toolbar>
      <StackView name="reports" spacing="0" flags="flexspace">
        <TabView name="report_tabs" tab-style="sidebar" flags="flexspace">
          <TableView name="balances" zeros="blank" totals-skip="subaccount" text="Trial Balance" source="ib.balances" flags="notitle,nofill,vscroll">
            <Column field="account.code" title="Account" width="48" />
            <Column field="account.name" title="Name" width="0" min-width="100" />
            <Column field="opening_dr" title="Opening Dr" width="86" total="sum" />
            <Column field="opening_cr" title="Opening Cr" width="86" total="sum" />
            <Column field="debit_turnover" title="Turnover Dr" width="86" total="sum" />
            <Column field="credit_turnover" title="Turnover Cr" width="86" total="sum" />
            <Column field="balance_dr" title="Closing Dr" width="86" total="sum" />
            <Column field="balance_cr" title="Closing Cr" width="86" total="sum" />
          </TableView>
          <TableView name="card" zeros="blank" text="Account Card" source="ib.card" flags="notitle,nofill,vscroll">
            <Column field="date" title="Date" width="72" />
            <Column field="document.number" title="Document" width="72" />
            <Column field="content" title="Content" width="0" min-width="100" />
            <Column field="account.code" title="Account" width="48" />
            <Column field="subconto.name" title="Analytics" width="0" min-width="80" />
            <Column field="corr.code" title="Corr." width="48" />
            <Column field="debit" title="Debit" width="90" total="sum" />
            <Column field="credit" title="Credit" width="90" total="sum" />
            <Column field="balance" title="Balance" width="86" />
          </TableView>
          <TableView name="analysis" zeros="blank" text="Account Analysis" source="ib.analysis_rows" flags="notitle,nofill,vscroll">
            <Column field="subconto.name" title="Analytics" width="0" min-width="140" />
            <Column field="opening_dr" title="Opening Dr" width="86" total="sum" />
            <Column field="opening_cr" title="Opening Cr" width="86" total="sum" />
            <Column field="debit_turnover" title="Turnover Dr" width="86" total="sum" />
            <Column field="credit_turnover" title="Turnover Cr" width="86" total="sum" />
            <Column field="balance_dr" title="Closing Dr" width="86" total="sum" />
            <Column field="balance_cr" title="Closing Cr" width="86" total="sum" />
          </TableView>
          <TableView name="sales_book" zeros="blank" text="Sales Book" source="ib.vat_book" filter-field="book" filter-value="1" flags="notitle,nofill,vscroll">
            <Column field="date" title="Date" width="76" />
            <Column field="document.number" title="Document" width="80" />
            <Column field="counterparty.name" title="Counterparty" width="0" min-width="140" />
            <Column field="counterparty.tax_id" title="Tax ID" width="100" />
            <Column field="vat_rate.name" title="Rate" width="56" />
            <Column field="total" title="Total" width="86" total="sum" />
            <Column field="amount" title="Net" width="86" total="sum" />
            <Column field="vat" title="Tax" width="84" total="sum" />
          </TableView>
          <TableView name="purchase_book" zeros="blank" text="Purchase Book" source="ib.vat_book" filter-field="book" filter-value="2" flags="notitle,nofill,vscroll">
            <Column field="date" title="Date" width="76" />
            <Column field="document.number" title="Document" width="80" />
            <Column field="counterparty.name" title="Counterparty" width="0" min-width="140" />
            <Column field="counterparty.tax_id" title="Tax ID" width="100" />
            <Column field="vat_rate.name" title="Rate" width="56" />
            <Column field="total" title="Total" width="86" total="sum" />
            <Column field="amount" title="Net" width="86" total="sum" />
            <Column field="vat" title="Tax" width="84" total="sum" />
          </TableView>
          <TableView name="vat_summary" zeros="blank" text="Tax Summary" source="ib.vat_summary" flags="notitle,nofill,vscroll">
            <Column field="book" title="Book" width="48" />
            <Column field="vat_rate.name" title="Rate" width="0" min-width="100" />
            <Column field="documents" title="Documents" width="80" />
            <Column field="total" title="Total" width="96" total="sum" />
            <Column field="amount" title="Net" width="96" total="sum" />
            <Column field="vat" title="Tax" width="96" total="sum" />
          </TableView>
          <TableView name="journal" zeros="blank" text="Journal" source="ib.journal_rows" flags="notitle,nofill,vscroll">
            <Column field="date" title="Date" width="76" />
            <Column field="document.number" title="Document" width="72" />
            <Column field="debit.code" title="Dr" width="56" />
            <Column field="debit_subconto.name" title="Dr Analytics" width="0" />
            <Column field="credit.code" title="Cr" width="56" />
            <Column field="credit_subconto.name" title="Cr Analytics" width="0" />
            <Column field="amount" title="Amount" width="96" total="sum" />
            <Column field="content" title="Content" width="0" />
          </TableView>
          <TableView name="cash_book" zeros="blank" totals-skip="summary" text="Cash Book" source="ib.cash_book" flags="notitle,nofill,vscroll">
            <Column field="date" title="Date" width="72" />
            <Column field="document.number" title="Document" width="72" />
            <Column field="content" title="Content" width="0" min-width="100" />
            <Column field="subconto.name" title="Received from / Paid to" width="0" min-width="80" />
            <Column field="corr.code" title="Corr." width="48" />
            <Column field="receipt" title="Receipt" width="86" total="sum" />
            <Column field="expense" title="Expense" width="86" total="sum" />
            <Column field="balance" title="Balance" width="86" />
          </TableView>
          <TableView name="asset_rows" zeros="blank" text="Fixed Assets" source="ib.asset_rows" flags="notitle,nofill,vscroll">
            <Column field="asset.inventory" title="Inv. No." width="64" />
            <Column field="asset.name" title="Fixed Asset" width="0" min-width="140" />
            <Column field="asset.commissioned" title="In Service" width="80" />
            <Column field="cost" title="Cost" width="86" total="sum" />
            <Column field="monthly" title="Monthly" width="84" total="sum" />
            <Column field="depreciation" title="Depreciation" width="86" total="sum" />
            <Column field="residual" title="Residual Value" width="86" total="sum" />
          </TableView>
          <TableView name="payroll_rows" zeros="blank" text="Payroll Statement" source="ib.payroll_rows" flags="notitle,nofill,vscroll">
            <Column field="employee.name" title="Employee" width="0" min-width="140" />
            <Column field="employee.position" title="Position" width="0" />
            <Column field="opening" title="Owed at Start" width="86" total="sum" />
            <Column field="accrued" title="Accrued" width="86" total="sum" />
            <Column field="deducted" title="Withheld and Paid" width="96" total="sum" />
            <Column field="closing" title="Owed at End" width="86" total="sum" />
          </TableView>
        </TabView>
      </StackView>
    </form>

    <!-- What the active configuration defines: document types, tax rates, units. -->
    <form name="config_page" label="Setup" title="Configuration" icon="ledger-nav-config"
          checked-icon="ledger-nav-config-fill" tooltip="Active configuration (Ctrl+0)"
          focus="doc_types" width="900" height="560" role="page" flags="nofill,flexspace"
          spacing="4" padding="0">
      <Toolbar>
        <Button command="file.configuration" icon="ledger-configuration" text="Configuration" tooltip="Select configuration" />
        <Button command="file.language" icon="ledger-language" text="Language" tooltip="Interface language" />
      </Toolbar>
      <StackView name="metadata_stack" spacing="0" flags="flexspace">
        <TabView name="metadata" tab-style="sidebar" flags="flexspace">
          <TableView name="settings" text="Configuration" source="cfg.settings" flags="notitle,nofill,vscroll">
            <Column field="name" title="Configuration" width="0" min-width="160" />
            <Column field="country" title="Country" width="140" />
            <Column field="currency" title="Currency" width="64" />
            <Column field="version" title="Version" width="72" />
            <Column field="basis" title="Legal Basis" width="0" />
          </TableView>
          <TableView name="doc_types" text="Document Types" source="cfg.doc_types" master="none" flags="notitle,nofill,vscroll">
            <Column field="name" title="Document" width="0" min-width="140" />
            <Column field="prefix" title="Prefix" width="44" />
            <Column field="debit.code" title="Dr" width="48" />
            <Column field="credit.code" title="Cr" width="48" />
            <Column field="vat_debit.code" title="Tax Dr" width="52" />
            <Column field="vat_credit.code" title="Tax Cr" width="52" />
            <Column field="form" title="Form" width="72" />
            <Column field="script" title="Script" width="96" />
            <Column field="description" title="Description" width="0" />
          </TableView>
          <TableView name="print_forms" text="Print Forms" source="cfg.print_forms" master="none" flags="notitle,nofill,vscroll">
            <Column field="doc_type.name" title="Document" width="0" />
            <Column field="report" title="Report" width="80" />
            <Column field="name" title="Form" width="0" />
            <Column field="basis" title="Legal Basis" width="0" />
          </TableView>
          <TableView name="payroll_taxes" zeros="blank" text="Payroll Taxes" source="cfg.payroll_taxes" master="none" flags="notitle,nofill,vscroll">
            <Column field="name" title="Tax" width="0" min-width="160" />
            <Column field="rate" title="Percent" width="56" />
            <Column field="rate_above" title="Above Cap" width="64" />
            <Column field="cap_month" title="Cap / Month" width="80" />
            <Column field="cap_year" title="Cap / Year" width="90" />
            <Column field="scale" title="Scale" width="72" />
            <Column field="script" title="Script" width="96" />
            <Column field="withheld" title="Withheld" width="64" />
            <Column field="valid_from" title="From" width="80" />
            <Column field="valid_to" title="To" width="80" />
            <Column field="debit.code" title="Dr" width="48" />
            <Column field="credit.code" title="Cr" width="48" />
          </TableView>
          <TableView name="tax_scales" zeros="blank" text="Tax Scales" source="cfg.tax_scales" master="none" flags="notitle,nofill,vscroll">
            <Column field="tax.name" title="Tax" width="0" min-width="160" />
            <Column field="base_from" title="Annual Base From" width="120" />
            <Column field="rate" title="Percent" width="64" />
            <Column field="fixed" title="Tax at Zone Start" width="110" />
            <Column field="curve" title="Curve" width="72" />
          </TableView>
          <TableView name="closing_rules" text="Closing Rules" source="cfg.closing_rules" master="none" flags="notitle,nofill,vscroll">
            <Column field="name" title="Step" width="0" min-width="160" />
            <Column field="kind" title="Kind" width="96" />
            <Column field="account.code" title="Account" width="56" />
            <Column field="target.code" title="Target" width="56" />
            <Column field="via.code" title="Via" width="48" />
            <Column field="gain.code" title="Gain" width="48" />
            <Column field="loss.code" title="Loss" width="48" />
          </TableView>
          <TableView name="subconto_kinds" text="Analytics Kinds" source="cfg.subconto_kinds" flags="notitle,nofill,vscroll">
            <Column field="name" title="Analytics" width="0" />
            <Column field="table" title="Catalog" width="120" />
          </TableView>
          <TableView name="vat_rates" text="Tax Rates" source="cfg.vat_rates" flags="notitle,nofill,vscroll">
            <Column field="name" title="Rate" width="0" min-width="100" />
            <Column field="rate" title="Percent" width="64" />
            <Column field="revenue.code" title="Revenue" width="64" />
            <Column field="output_tax.code" title="Tax Cr" width="64" />
            <Column field="expense.code" title="Expense" width="64" />
            <Column field="input_tax.code" title="Tax Dr" width="64" />
          </TableView>
          <TableView name="units" text="Units" source="cfg.units" flags="notitle,nofill,vscroll">
            <Column field="code" title="Code" width="56" />
            <Column field="name" title="Unit" width="0" />
          </TableView>
          <TableView name="regulations" text="Legal Basis" source="cfg.regulations" master="none" flags="notitle,nofill,vscroll">
            <Column field="area" title="Area" width="80" />
            <Column field="title" title="Rule" width="0" min-width="160" />
            <Column field="reference" title="Act" width="0" min-width="160" />
            <Column field="valid_from" title="In Force From" width="90" />
          </TableView>
        </TabView>
      </StackView>
    </form>

    <!-- Document form, in the order 1C lays one out: the commands, number and
         date on one line, the lines with their commands above them, the entries
         posting will write (recomputed as the lines change), then the comment
         and the totals. -->
    <form name="document" title="Document" width="820" height="600" spacing="8" padding="12">
      <StackView name="heading" orientation="horizontal" spacing="10">
        <Label name="caption" text="New Document" font="title" />
        <Badge name="state" text="Not posted" icon="ledger-doc-draft" color="warning" v-align="center" />
        <Badge name="payment" text="Paid" icon="ledger-post" color="info" v-align="center" />
        <Space name="heading_flex" />
      </StackView>
      <StackView name="commands" orientation="horizontal" spacing="6">
        <Button name="post_close" text="Post and Close" flags="BUTTON_DEFAULT" tooltip="Save, post and close (Ctrl+Enter)" />
        <Button name="save" text="Write" tooltip="Save without closing (Ctrl+S)" />
        <Button name="post" text="Post" icon="ledger-post" tooltip="Save and post without closing" />
        <Button name="entries_toggle" text="Dr/Cr" tooltip="Show or hide the entries this document writes" />
        <Button name="print" text="Print" icon="ledger-print" tooltip="Save and write the print forms" />
        <Space name="command_flex" />
        <Button name="cancel" text="Cancel" />
      </StackView>
      <GridView name="header" spacing="6">
        <Column name="labels" width="auto">
          <Label name="lbl_number" text="Number:" />
          <Label name="lbl_counterparty" text="Counterparty:" />
          <Label name="lbl_spare" />
        </Column>
        <Column name="inputs">
          <StackView name="number_row" orientation="horizontal" spacing="8">
            <TextBox name="number" field="ib.documents.number" placeholder="Assigned when saved" width="130" />
            <Label name="lbl_date" text="dated:" />
            <TextBox name="date" field="ib.documents.date" width="120" />
            <Space name="number_flex" />
          </StackView>
          <ComboBox name="counterparty" field="ib.documents.counterparty_id" source="ib.counterparties" display="name" value="id" />
          <Label name="spare" />
        </Column>
        <Column name="labels2" width="auto">
          <Label name="lbl_type" text="Document:" />
          <Label name="lbl_currency" text="Currency:" />
          <Label name="lbl_rate" text="Exchange rate:" />
        </Column>
        <Column name="inputs2">
          <ComboBox name="doc_type" field="ib.documents.doc_type_id" source="cfg.doc_types" display="name" value="id" filter-field="form" filter-value="document" />
          <ComboBox name="currency" field="ib.documents.currency_id" source="ib.currencies" display="code" value="id" />
          <TextBox name="rate" field="ib.documents.rate" placeholder="Rate on the document date" />
        </Column>
      </GridView>
      <SplitView name="body" orientation="vertical" split-ratio="0.58" flags="flexspace">
        <StackView name="goods" spacing="6" flags="flexspace">
          <StackView name="line_actions" orientation="horizontal" spacing="6">
            <Button name="add_line" text="Add" icon="ledger-new" target="lines" action="insert" tooltip="Add a line (Ins)" />
            <Button name="edit_line" text="Edit" icon="ledger-edit" target="lines" action="edit" tooltip="Edit the line (F2)" />
            <Button name="delete_line" text="Delete" icon="ledger-delete" target="lines" action="delete" tooltip="Delete the line (Del)" />
            <Space name="line_flex" />
            <Label name="line_keys" text="Ins add · F2 edit · Del delete" color="text-secondary" />
          </StackView>
          <TableView name="lines" frame="true" source="ib.doc_lines" form="doc_line" flags="notitle,nofill,vscroll,flexspace">
            <Column field="item.name" title="Item" width="0" min-width="120" />
            <Column field="item.unit.name" title="Unit" width="44" />
            <Column field="quantity" title="Qty" width="64" />
            <Column field="price" title="Price" width="80" />
            <Column field="amount" title="Amount" width="90" total="sum" />
            <Column field="vat_rate.name" title="Tax" width="48" />
            <Column field="vat" title="Tax Amount" width="84" total="sum" />
            <Column field="total" title="Total" width="90" total="sum" />
          </TableView>
        </StackView>
        <StackView name="postings_pane" spacing="6" flags="flexspace">
          <StackView name="postings_head" orientation="horizontal" spacing="8">
            <Label name="lbl_postings" text="Entries" font="system" />
            <Label name="postings_hint" text="What posting writes, recomputed as you change the lines" color="text-secondary" />
          </StackView>
          <TableView name="postings" frame="true" zeros="blank" source="ib.entries" flags="notitle,nofill,vscroll,flexspace">
            <Column field="debit.code" title="Dr" width="56" />
            <Column field="debit_subconto.name" title="Dr Analytics" width="0" />
            <Column field="credit.code" title="Cr" width="56" />
            <Column field="credit_subconto.name" title="Cr Analytics" width="0" />
            <Column field="quantity" title="Qty" width="64" />
            <Column field="amount" title="Amount" width="96" />
            <Column field="content" title="Content" width="0" />
          </TableView>
        </StackView>
      </SplitView>
      <StackView name="footer" orientation="horizontal" spacing="16">
        <Label name="lbl_comment" text="Comment:" />
        <TextBox name="comment" field="ib.documents.comment" placeholder="Comment for the document" flags="flexspace" />
        <StackView name="sum_amount" spacing="0">
          <Label name="lbl_amount" text="Amount" color="text-secondary" h-align="end" />
          <Label name="amount" field="ib.documents.amount" font="system" h-align="end" />
        </StackView>
        <StackView name="sum_vat" spacing="0">
          <Label name="lbl_vat" text="Tax" color="text-secondary" h-align="end" />
          <Label name="vat" field="ib.documents.vat" font="system" h-align="end" />
        </StackView>
        <StackView name="sum_total" spacing="0">
          <Label name="lbl_total" text="Total" color="text-secondary" h-align="end" />
          <Label name="total" field="ib.documents.total" font="title" h-align="end" />
        </StackView>
      </StackView>
    </form>

    <form name="doc_line" title="Document Line" width="340" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_item" text="Item:" />
          <Label name="lbl_quantity" text="Quantity:" />
          <Label name="lbl_price" text="Price:" />
          <Label name="lbl_vat_rate" text="Tax rate:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="item" field="ib.doc_lines.item_id" source="ib.items" display="name" value="id" />
          <TextBox name="quantity" field="ib.doc_lines.quantity" />
          <TextBox name="price" field="ib.doc_lines.price" placeholder="Item price" />
          <ComboBox name="vat_rate" field="ib.doc_lines.vat_rate_id" source="cfg.vat_rates" display="name" value="id" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.doc_lines.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="counterparty" title="Counterparty" width="420" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_name" text="Name:" />
          <Label name="lbl_tax_id" text="Tax ID:" />
          <Label name="lbl_kpp" text="KPP:" />
          <Label name="lbl_address" text="Address:" />
          <Label name="lbl_bank" text="Bank:" />
          <Label name="lbl_bank_account" text="Bank account:" />
          <Label name="lbl_bik" text="Bank ID (BIK):" />
          <Label name="lbl_phone" text="Phone:" />
        </Column>
        <Column name="inputs">
          <TextBox name="name" field="ib.counterparties.name" />
          <TextBox name="tax_id" field="ib.counterparties.tax_id" />
          <TextBox name="kpp" field="ib.counterparties.kpp" />
          <TextBox name="address" field="ib.counterparties.address" />
          <TextBox name="bank" field="ib.counterparties.bank" />
          <TextBox name="bank_account" field="ib.counterparties.bank_account" />
          <TextBox name="bik" field="ib.counterparties.bik" />
          <TextBox name="phone" field="ib.counterparties.phone" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.counterparties.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="item" title="Item" width="360" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_sku" text="Code:" />
          <Label name="lbl_name" text="Name:" />
          <Label name="lbl_unit" text="Unit:" />
          <Label name="lbl_vat_rate" text="Tax rate:" />
          <Label name="lbl_price" text="Price:" />
        </Column>
        <Column name="inputs">
          <TextBox name="sku" field="ib.items.sku" />
          <TextBox name="name" field="ib.items.name" />
          <ComboBox name="unit" field="ib.items.unit_id" source="cfg.units" display="name" value="id" />
          <ComboBox name="vat_rate" field="ib.items.vat_rate_id" source="cfg.vat_rates" display="name" value="id" />
          <TextBox name="price" field="ib.items.price" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.items.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="organization" title="Organization Details" width="440" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_name" text="Name:" />
          <Label name="lbl_tax_id" text="Tax ID:" />
          <Label name="lbl_kpp" text="KPP:" />
          <Label name="lbl_address" text="Address:" />
          <Label name="lbl_bank" text="Bank:" />
          <Label name="lbl_bank_account" text="Bank account:" />
          <Label name="lbl_bik" text="Bank ID (BIK):" />
          <Label name="lbl_corr_account" text="Corr. account:" />
          <Label name="lbl_director" text="Director:" />
          <Label name="lbl_accountant" text="Chief accountant:" />
          <Label name="lbl_cashier" text="Cashier:" />
        </Column>
        <Column name="inputs">
          <TextBox name="name" field="ib.organizations.name" />
          <TextBox name="tax_id" field="ib.organizations.tax_id" />
          <TextBox name="kpp" field="ib.organizations.kpp" />
          <TextBox name="address" field="ib.organizations.address" />
          <TextBox name="bank" field="ib.organizations.bank" />
          <TextBox name="bank_account" field="ib.organizations.bank_account" />
          <TextBox name="bik" field="ib.organizations.bik" />
          <TextBox name="corr_account" field="ib.organizations.corr_account" />
          <TextBox name="director" field="ib.organizations.director" />
          <TextBox name="accountant" field="ib.organizations.accountant" />
          <TextBox name="cashier" field="ib.organizations.cashier" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.organizations.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <!-- The choice is a catalog record; the next start opens its infobase. -->
    <form name="select_configuration" title="Select Configuration" width="360" spacing="6" padding="8">
      <Label name="hint" text="Ledger opens the infobase of the chosen configuration on next start." />
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_configuration" text="Configuration:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="configuration" field="catalog.choices.configuration_id" source="catalog.configurations" display="name" value="id" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="catalog.choices.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="select_language" title="Language" width="320" spacing="6" padding="8">
      <Label name="hint" text="The new language applies the next time Ledger starts." />
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_language" text="Language:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="language" field="catalog.choices.language_id" source="catalog.languages" display="name" value="id" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="catalog.choices.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <!-- Manual operation: the accountant types the entries themselves. -->
    <form name="operation" title="Manual Operation" width="680" height="420" spacing="6" padding="8">
      <GridView name="header" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_type" text="Operation:" />
          <Label name="lbl_number" text="Number:" />
          <Label name="lbl_date" text="Date:" />
          <Label name="lbl_comment" text="Comment:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="doc_type" field="ib.documents.doc_type_id" source="cfg.doc_types" display="name" value="id" filter-field="form" filter-value="operation" />
          <TextBox name="number" field="ib.documents.number" placeholder="Assigned when saved" />
          <TextBox name="date" field="ib.documents.date" />
          <TextBox name="comment" field="ib.documents.comment" />
        </Column>
      </GridView>
      <TableView name="entries" zeros="blank" source="ib.entries" form="entry" flags="notitle,nofill,vscroll,flexspace">
        <Column field="debit.code" title="Dr" width="56" />
        <Column field="debit_subconto.name" title="Dr Analytics" width="0" />
        <Column field="credit.code" title="Cr" width="56" />
        <Column field="credit_subconto.name" title="Cr Analytics" width="0" />
        <Column field="quantity" title="Qty" width="64" />
        <Column field="amount" title="Amount" width="90" />
        <Column field="content" title="Content" width="0" />
      </TableView>
      <StackView name="entry_actions" orientation="horizontal" spacing="4">
        <Button name="add_entry" text="Add Entry..." target="entries" action="insert" />
        <Button name="edit_entry" text="Edit Entry..." target="entries" action="edit" />
        <Button name="delete_entry" text="Delete Entry" target="entries" action="delete" />
        <Space name="entry_flex" />
      </StackView>
      <GridView name="totals" spacing="4">
        <Column name="col_total_label" width="auto"><Label name="lbl_total" text="Total:" /></Column>
        <Column name="col_total"><TextBox name="total" field="ib.documents.total" /></Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.documents.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <!-- The analytics boxes are bound to polymorphic relations: each lists
         the catalog its account is analysed by. -->
    <form name="entry" title="Entry" width="400" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_debit" text="Debit:" />
          <Label name="lbl_debit_subconto" text="Debit analytics:" />
          <Label name="lbl_credit" text="Credit:" />
          <Label name="lbl_credit_subconto" text="Credit analytics:" />
          <Label name="lbl_quantity" text="Quantity:" />
          <Label name="lbl_currency" text="Currency:" />
          <Label name="lbl_currency_amount" text="Currency amount:" />
          <Label name="lbl_amount" text="Amount:" />
          <Label name="lbl_content" text="Content:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="debit" field="ib.entries.debit_id" source="cfg.accounts" display="code" value="id" />
          <ComboBox name="debit_subconto" field="ib.entries.debit_subconto_id" source="ib.counterparties" display="name" value="id" />
          <ComboBox name="credit" field="ib.entries.credit_id" source="cfg.accounts" display="code" value="id" />
          <ComboBox name="credit_subconto" field="ib.entries.credit_subconto_id" source="ib.counterparties" display="name" value="id" />
          <TextBox name="quantity" field="ib.entries.quantity" />
          <ComboBox name="currency" field="ib.entries.currency_id" source="ib.currencies" display="code" value="id" />
          <TextBox name="currency_amount" field="ib.entries.currency_amount" />
          <TextBox name="amount" field="ib.entries.amount" />
          <TextBox name="content" field="ib.entries.content" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.entries.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <!-- Payroll: accrual (pay and payroll taxes) or payout of what is owed. -->
    <form name="payroll" title="Payroll" width="640" height="420" spacing="6" padding="8">
      <GridView name="header" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_type" text="Document:" />
          <Label name="lbl_number" text="Number:" />
          <Label name="lbl_date" text="Date:" />
          <Label name="lbl_comment" text="Comment:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="doc_type" field="ib.documents.doc_type_id" source="cfg.doc_types" display="name" value="id" filter-field="form" filter-value="payroll" />
          <TextBox name="number" field="ib.documents.number" placeholder="Assigned when saved" />
          <TextBox name="date" field="ib.documents.date" />
          <TextBox name="comment" field="ib.documents.comment" />
        </Column>
      </GridView>
      <TableView name="lines" source="ib.payroll_lines" form="payroll_line" flags="notitle,nofill,vscroll,flexspace">
        <Column field="employee.name" title="Employee" width="0" min-width="140" />
        <Column field="employee.position" title="Position" width="0" />
        <Column field="amount" title="Amount" width="90" />
        <Column field="withheld" title="Withheld" width="84" />
        <Column field="contributions" title="Contributions" width="90" />
        <Column field="net" title="Net Pay" width="90" />
      </TableView>
      <StackView name="line_actions" orientation="horizontal" spacing="4">
        <Button name="fill" text="Fill" />
        <Button name="add_line" text="Add Line..." target="lines" action="insert" />
        <Button name="edit_line" text="Edit Line..." target="lines" action="edit" />
        <Button name="delete_line" text="Delete Line" target="lines" action="delete" />
        <Space name="line_flex" />
      </StackView>
      <GridView name="totals" spacing="4">
        <Column name="col_total_label" width="auto"><Label name="lbl_total" text="Total:" /></Column>
        <Column name="col_total"><TextBox name="total" field="ib.documents.total" /></Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK and Post" action="ib.documents.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="payroll_line" title="Payroll Line" width="340" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_employee" text="Employee:" />
          <Label name="lbl_amount" text="Amount:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="employee" field="ib.payroll_lines.employee_id" source="ib.employees" display="name" value="id" />
          <TextBox name="amount" field="ib.payroll_lines.amount" placeholder="Salary" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.payroll_lines.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="asset_document" title="Put into Service" width="560" height="360" spacing="6" padding="8">
      <GridView name="header" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_type" text="Document:" />
          <Label name="lbl_number" text="Number:" />
          <Label name="lbl_date" text="Date:" />
          <Label name="lbl_comment" text="Comment:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="doc_type" field="ib.documents.doc_type_id" source="cfg.doc_types" display="name" value="id" filter-field="form" filter-value="assets" />
          <TextBox name="number" field="ib.documents.number" placeholder="Assigned when saved" />
          <TextBox name="date" field="ib.documents.date" />
          <TextBox name="comment" field="ib.documents.comment" />
        </Column>
      </GridView>
      <TableView name="lines" source="ib.asset_lines" form="asset_line" flags="notitle,nofill,vscroll,flexspace">
        <Column field="asset.inventory" title="Inv. No." width="64" />
        <Column field="asset.name" title="Fixed Asset" width="0" min-width="160" />
        <Column field="asset.life" title="Life, months" width="84" />
        <Column field="amount" title="Cost" width="96" />
      </TableView>
      <StackView name="line_actions" orientation="horizontal" spacing="4">
        <Button name="add_line" text="Add Asset..." target="lines" action="insert" />
        <Button name="delete_line" text="Remove Asset" target="lines" action="delete" />
        <Space name="line_flex" />
      </StackView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK and Post" action="ib.documents.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="asset_line" title="Fixed Asset" width="320" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_asset" text="Fixed asset:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="asset" field="ib.asset_lines.asset_id" source="ib.assets" display="name" value="id" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.asset_lines.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <!-- Month-end closing: the entries come from the configuration's closing rules. -->
    <form name="closing" title="Close Month" width="640" height="400" spacing="6" padding="8">
      <GridView name="header" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_type" text="Document:" />
          <Label name="lbl_number" text="Number:" />
          <Label name="lbl_date" text="Last day of month:" />
          <Label name="lbl_comment" text="Comment:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="doc_type" field="ib.documents.doc_type_id" source="cfg.doc_types" display="name" value="id" filter-field="form" filter-value="closing" />
          <TextBox name="number" field="ib.documents.number" placeholder="Assigned when saved" />
          <TextBox name="date" field="ib.documents.date" />
          <TextBox name="comment" field="ib.documents.comment" />
        </Column>
      </GridView>
      <Label name="hint" text="Posting charges depreciation, revalues currency accounts and closes the month's expenses and result." />
      <TableView name="entries" zeros="blank" source="ib.entries" flags="notitle,nofill,vscroll,flexspace">
        <Column field="debit.code" title="Dr" width="56" />
        <Column field="debit_subconto.name" title="Dr Analytics" width="0" />
        <Column field="credit.code" title="Cr" width="56" />
        <Column field="credit_subconto.name" title="Cr Analytics" width="0" />
        <Column field="amount" title="Amount" width="90" />
        <Column field="content" title="Content" width="0" />
      </TableView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK and Post" action="ib.documents.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="employee" title="Employee" width="380" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_name" text="Name:" />
          <Label name="lbl_position" text="Position:" />
          <Label name="lbl_tax_id" text="Tax ID:" />
          <Label name="lbl_hired" text="Hired:" />
          <Label name="lbl_salary" text="Monthly salary:" />
          <Label name="lbl_allowance" text="Tax allowance:" />
          <Label name="lbl_account" text="Expense account:" />
        </Column>
        <Column name="inputs">
          <TextBox name="name" field="ib.employees.name" />
          <TextBox name="position" field="ib.employees.position" />
          <TextBox name="tax_id" field="ib.employees.tax_id" />
          <TextBox name="hired" field="ib.employees.hired" />
          <TextBox name="salary" field="ib.employees.salary" />
          <TextBox name="allowance" field="ib.employees.allowance" placeholder="Monthly, before allowance taxes" />
          <ComboBox name="account" field="ib.employees.account_id" source="cfg.accounts" display="code" value="id" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.employees.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="asset" title="Fixed Asset" width="400" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_inventory" text="Inventory number:" />
          <Label name="lbl_name" text="Name:" />
          <Label name="lbl_cost" text="Cost:" />
          <Label name="lbl_life" text="Useful life, months:" />
          <Label name="lbl_commissioned" text="In service since:" />
          <Label name="lbl_account" text="Asset account:" />
          <Label name="lbl_depreciation" text="Depreciation account:" />
          <Label name="lbl_expense" text="Expense account:" />
        </Column>
        <Column name="inputs">
          <TextBox name="inventory" field="ib.assets.inventory" />
          <TextBox name="name" field="ib.assets.name" />
          <TextBox name="cost" field="ib.assets.cost" />
          <TextBox name="life" field="ib.assets.life" />
          <TextBox name="commissioned" field="ib.assets.commissioned" placeholder="Set when put into service" />
          <ComboBox name="account" field="ib.assets.account_id" source="cfg.accounts" display="code" value="id" />
          <ComboBox name="depreciation" field="ib.assets.depreciation_id" source="cfg.accounts" display="code" value="id" />
          <ComboBox name="expense" field="ib.assets.expense_id" source="cfg.accounts" display="code" value="id" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.assets.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="currency" title="Currency" width="300" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_code" text="Code:" />
          <Label name="lbl_name" text="Name:" />
        </Column>
        <Column name="inputs">
          <TextBox name="code" field="ib.currencies.code" placeholder="USD" />
          <TextBox name="name" field="ib.currencies.name" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.currencies.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="rate" title="Exchange Rate" width="300" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_currency" text="Currency:" />
          <Label name="lbl_date" text="Date:" />
          <Label name="lbl_rate" text="Rate:" />
        </Column>
        <Column name="inputs">
          <ComboBox name="currency" field="ib.rates.currency_id" source="ib.currencies" display="code" value="id" />
          <TextBox name="date" field="ib.rates.date" />
          <TextBox name="rate" field="ib.rates.rate" />
        </Column>
      </GridView>
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.rates.insert" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>

    <form name="report_settings" title="Report Settings" width="320" spacing="6" padding="8">
      <GridView name="fields" spacing="4">
        <Column name="labels" width="auto">
          <Label name="lbl_from" text="From:" />
          <Label name="lbl_to" text="To:" />
          <Label name="lbl_account" text="Account:" />
        </Column>
        <Column name="inputs">
          <TextBox name="date_from" field="ib.report_settings.date_from" placeholder="Beginning" />
          <TextBox name="date_to" field="ib.report_settings.date_to" placeholder="End" />
          <ComboBox name="account" field="ib.report_settings.account_id" source="cfg.accounts" display="code" value="id" />
        </Column>
      </GridView>
      <Label name="hint" text="The account card and analysis show the chosen account; the cash book, assets and payroll use the period." />
      <Separator name="sep" />
      <StackView name="actions" orientation="horizontal" spacing="6">
        <Space name="flex" />
        <Button name="ok" text="OK" action="ib.report_settings.update" flags="BUTTON_DEFAULT" />
        <Button name="cancel" text="Cancel" />
      </StackView>
    </form>
  </forms>
</orion>
