<?xml version="1.0" encoding="UTF-8"?>
<!-- German command words, keyed by the English source words in en.xml.
     `paradigm` names a table below and applies to the headword and its
     `synonyms`; `forms` lists irregular forms. -->
<vocabulary language="de">
  <!-- Cut `cut` letters, then one ending per slot: "=" is the headword, "0" the
       bare stem, "-" no form. A spelling adds an ASCII variant of every form. -->
  <morphology>
    <class name="noun"      slots="nom gen dat acc  pl.nom pl.gen pl.dat pl.acc"/>
    <class name="adjective" slots="base e en er es em"/>
    <paradigm name="noun-weak" class="noun"      cut="0">= n  n n  n n n  n</paradigm> <!-- Kunde -->
    <paradigm name="noun-er"   class="noun"      cut="0">= s  = =  = = n  =</paradigm> <!-- Schuldner, Artikel -->
    <paradigm name="noun-e"    class="noun"      cut="0">= es = =  e e en e</paradigm> <!-- Beleg -->
    <paradigm name="adjective" class="adjective" cut="0">= e en er es em</paradigm>    <!-- gebucht -->
    <paradigm name="ordinal"   class="adjective" cut="0">- e en er es em</paradigm>    <!-- erst-: erste, ersten -->
    <spelling from="ä" to="ae"/>
    <spelling from="ö" to="oe"/>
    <spelling from="ü" to="ue"/>
    <spelling from="ß" to="ss"/>
  </morphology>

  <verb source="show" synonyms="anzeigen">zeige</verb>
  <verb source="find">suche</verb>
  <verb source="open">öffne</verb>
  <verb source="sort">sortiere</verb>
  <verb source="help">hilfe</verb>
  <verb source="cancel">abbrechen</verb>
  <verb source="reset">zurücksetzen</verb>

  <noun source="customer" paradigm="noun-weak">Kunde</noun>
  <noun source="debtor"   paradigm="noun-er">Schuldner</noun>
  <noun source="document" paradigm="noun-e" forms="Belegs">Beleg</noun>
  <noun source="item"     paradigm="noun-er">Artikel</noun>

  <adjective  source="posted" paradigm="adjective">gebucht</adjective>
  <adjective  source="draft"  paradigm="adjective">ungebucht</adjective>
  <adjective  source="owing"  paradigm="adjective">schuldend</adjective>
  <field      source="debt">Schulden</field>
  <field      source="amount" forms="Betrags Beträge Beträgen">Betrag</field>
  <field      source="name"   forms="Namens Namen">Name</field>
  <comparison source="greater than">über</comparison>
  <comparison source="greater than">mehr als</comparison>
  <comparison source="less than">unter</comparison>
  <comparison source="less than">weniger als</comparison>
  <comparison source="at least">mindestens</comparison>
  <comparison source="at most">höchstens</comparison>
  <comparison source="exactly">genau</comparison>
  <relation   source="for">für</relation>
  <direction  source="descending">absteigend</direction>
  <direction  source="ascending">aufsteigend</direction>

  <ordinal value="1" paradigm="ordinal">erst</ordinal>  <ordinal value="2" paradigm="ordinal">zweit</ordinal>
  <ordinal value="3" paradigm="ordinal">dritt</ordinal> <ordinal value="4" paradigm="ordinal">viert</ordinal>
  <ordinal value="5" paradigm="ordinal">fünft</ordinal>
  <pronoun>ihn</pronoun> <pronoun>sie</pronoun> <pronoun>es</pronoun>
  <pronoun>diesen</pronoun> <pronoun>diese</pronoun> <pronoun>dieses</pronoun>
  <noise>bitte</noise> <noise>nur</noise> <noise>mit</noise> <noise>nach</noise> <noise>alle</noise>
  <noise>der</noise> <noise>die</noise> <noise>das</noise> <noise>den</noise> <noise>dem</noise>

  <!-- `compound` numbers are the stems german_numbers.lua composes, as in einhundertfünfundzwanzig. -->
  <number value="0"  compound="small">null</number>
  <number value="1"  compound="ones">ein</number>  <number value="1" compound="ones" prefix="false">eins</number>
  <number value="1">eine</number>
  <number value="2"  compound="ones">zwei</number>     <number value="3"  compound="ones">drei</number>
  <number value="4"  compound="ones">vier</number>     <number value="5"  compound="ones">fünf</number>
  <number value="6"  compound="ones">sechs</number>    <number value="7"  compound="ones">sieben</number>
  <number value="8"  compound="ones">acht</number>     <number value="9"  compound="ones">neun</number>
  <number value="10" compound="small">zehn</number>    <number value="11" compound="small">elf</number>
  <number value="12" compound="small">zwölf</number>   <number value="13" compound="small">dreizehn</number>
  <number value="14" compound="small">vierzehn</number> <number value="15" compound="small">fünfzehn</number>
  <number value="16" compound="small">sechzehn</number> <number value="17" compound="small">siebzehn</number>
  <number value="18" compound="small">achtzehn</number> <number value="19" compound="small">neunzehn</number>
  <number value="20" compound="tens">zwanzig</number>  <number value="30" compound="tens">dreißig</number>
  <number value="40" compound="tens">vierzig</number>  <number value="50" compound="tens">fünfzig</number>
  <number value="60" compound="tens">sechzig</number>  <number value="70" compound="tens">siebzig</number>
  <number value="80" compound="tens">achtzig</number>  <number value="90" compound="tens">neunzig</number>
  <multiplier value="100">hundert</multiplier>
  <scale value="1000">tausend</scale>
  <scale value="1000000" forms="Millionen">Million</scale>
  <compound-numbers conjunction="und" multiplier="hundert" scale="tausend">
    <replace source="ae" target="ä"/>
    <replace source="oe" target="ö"/>
    <replace source="ue" target="ü"/>
    <replace source="ss" target="ß"/>
  </compound-numbers>

  <normalization>
    <map source="ÄÖÜẞ" target="äöüß"/>
  </normalization>
</vocabulary>
