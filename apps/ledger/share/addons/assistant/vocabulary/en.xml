<?xml version="1.0" encoding="UTF-8"?>
<!-- English command words, and the source words every language translates.
     An entry with `means` defines a source word and its meaning; an entry
     without `means` adds a word to an existing source. `synonyms` lists more
     words separated by spaces, like class= in HTML. A phrase or a word with
     another paradigm gets its own entry. -->
<vocabulary language="en">
  <morphology>
    <class name="noun" slots="sg pl"/>
    <paradigm name="noun"   class="noun" cut="0">= s</paradigm>   <!-- customer -->
    <paradigm name="noun-y" class="noun" cut="1">= ies</paradigm> <!-- counterparty -->
  </morphology>

  <!-- Verbs: the action a command performs. -->
  <verb source="show"   means="list" synonyms="list"/>
  <verb source="find"   means="find"/>
  <verb source="open"   means="open"/>
  <verb source="sort"   means="sort"/>
  <verb source="help"   means="help"/>
  <verb source="cancel" means="cancel"/>
  <verb source="reset"  means="reset"/>

  <!-- Nouns: the records a command refers to. -->
  <noun source="customer" means="counterparties" paradigm="noun" synonyms="client"/>
  <noun source="customer" paradigm="noun-y">counterparty</noun>
  <noun source="debtor"   means="debtors"        paradigm="noun"/>
  <noun source="document" means="documents"      paradigm="noun"/>
  <noun source="item"     means="items"          paradigm="noun"/>

  <!-- Qualifiers: filters, fields, comparisons, relations and sort order. -->
  <adjective  source="posted"       means="posted"/>
  <adjective  source="draft"        means="draft"   paradigm="noun"/>
  <adjective  source="owing"        means="debtors"/>
  <field      source="debt"         means="debt"/>
  <field      source="amount"       means="amount"  synonyms="total"/>
  <field      source="name"         means="name"/>
  <comparison source="greater than" means="gt"      synonyms="over"/>
  <comparison source="greater than">more than</comparison>
  <comparison source="less than"    means="lt"      synonyms="under"/>
  <comparison source="at least"     means="ge"/>
  <comparison source="at most"      means="le"/>
  <comparison source="exactly"      means="eq"      synonyms="equals"/>
  <relation   source="for"          means="counterparty"/>
  <direction  source="descending"   means="desc"/>
  <direction  source="ascending"    means="asc"/>

  <!-- Words whose meaning is their value or their role; they need no source word. -->
  <ordinal value="1">first</ordinal>  <ordinal value="2">second</ordinal>  <ordinal value="3">third</ordinal>
  <ordinal value="4">fourth</ordinal> <ordinal value="5">fifth</ordinal>
  <pronoun>it</pronoun> <pronoun>this</pronoun>
  <noise>please</noise> <noise>the</noise> <noise>all</noise> <noise>with</noise> <noise>by</noise> <noise>only</noise>
  <unit paradigm="noun">euro</unit> <unit paradigm="noun">ruble</unit>

  <number value="0">zero</number>      <number value="1">one</number>        <number value="2">two</number>
  <number value="3">three</number>     <number value="4">four</number>       <number value="5">five</number>
  <number value="6">six</number>       <number value="7">seven</number>      <number value="8">eight</number>
  <number value="9">nine</number>      <number value="10">ten</number>       <number value="11">eleven</number>
  <number value="12">twelve</number>   <number value="13">thirteen</number>  <number value="14">fourteen</number>
  <number value="15">fifteen</number>  <number value="16">sixteen</number>   <number value="17">seventeen</number>
  <number value="18">eighteen</number> <number value="19">nineteen</number>  <number value="20">twenty</number>
  <number value="30">thirty</number>   <number value="40">forty</number>     <number value="50">fifty</number>
  <number value="60">sixty</number>    <number value="70">seventy</number>   <number value="80">eighty</number>
  <number value="90">ninety</number>
  <multiplier value="100">hundred</multiplier>
  <scale value="1000">thousand</scale>
  <scale value="1000000" paradigm="noun">million</scale>
  <conjunction>and</conjunction>
</vocabulary>
