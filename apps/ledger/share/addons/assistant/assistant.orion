<?xml version="1.0" encoding="UTF-8"?>
<orion>
  <databases>
    <database name="assistant" class="db_schema_xml">
      <table name="results" transient="true">
        <field name="id" type="integer" key="YES" />
        <field name="record_id" type="integer" />
        <field name="name" type="string" length="256" />
        <field name="amount" type="double" />
        <field name="date" type="date" />
      </table>
    </database>
  </databases>
  <forms>
    <form name="assistant" title="Ledger — Assistant" width="480" height="520" spacing="0" padding="0"
          flags="WINDOW_NOTITLE,WINDOW_NORESIZE,WINDOW_NOFILL,WINDOW_TRANSPARENT,WINDOW_NOACTIVATE,WINDOW_NOTRAYBUTTON,WINDOW_ALWAYSONTOP,WINDOW_NODRAG">
      <SpeechBubble name="bubble" spacing="8" flags="flexspace,WINDOW_NOACTIVATE">
        <StackView name="header" orientation="horizontal" spacing="8">
          <Label name="title" text="Clippy" />
          <Space name="header_flex" />
          <Button name="collapse" text="Collapse" action="collapse" />
          <Button name="hide" text="Hide assistant" />
        </StackView>
        <Label name="summary" text="Hello! Say or type: show debtors." />
        <Label name="request" color="secondary" />
        <TextBox name="command" placeholder="Ask me, for example: show debtors" />
        <StackView name="actions" orientation="horizontal" spacing="8">
          <Button name="submit" text="Send" action="submit" flags="BUTTON_DEFAULT" />
          <Button name="help" text="Examples" action="help" />
        </StackView>
        <TableView name="results" source="assistant.results" flags="flexspace,vscroll">
          <Column field="id" title="№" width="30" />
          <Column field="name" title="Name / document" width="0" min-width="130" />
          <Column field="amount" title="Amount" width="100" />
          <Column field="date" title="Date" width="90" />
        </TableView>
        <Label name="error" color="error" />
      </SpeechBubble>
      <StackView name="character" orientation="horizontal" spacing="0" margin="0,0,18,0">
        <Space name="character_flex" />
        <SpriteButton name="mascot" width="124" height="93" action="greet" />
      </StackView>
    </form>
  </forms>
</orion>
