<?xml version="1.0" encoding="UTF-8"?>
<!-- How to start this checkout. Git Client lists these targets for every
     worktree; keep them in step with the Makefile (see AGENTS.md). -->
<launch project="ui">
    <target name="Jamsheet" default="true" run="make groove" />
    <target name="Jamsheet demo song" run="make groove-demo" />
    <target name="Git Client" build="make build/bin/gitclient" run="build/bin/gitclient ${workspace}">
        <param name="workspace" default="." />
    </target>
    <target name="Ledger" run="make run-ledger-${lang}">
        <param name="lang" choices="ru de" />
    </target>
    <!-- Shared targets require ORION_SERVER_URL and ORION_SERVER_TOKEN in the launch environment. -->
    <target name="Lodge shared company" build="make share build/bin/lodge" run="build/bin/lodge --remote" />
    <target name="Ledger shared company" build="make share build/bin/ledger" run="build/bin/ledger --remote" />
    <target name="Scener" build="make scener" run="build/bin/scener" />
    <target name="Image Editor" build="make build/bin/imageeditor" run="build/bin/imageeditor" />
    <target name="Form Editor" build="make build/bin/formeditor" run="build/bin/formeditor" />
    <target name="iPad Simulator" run="make ipad-run APP=${app}">
        <param name="app" choices="imageeditor groove penciltest" />
    </target>
    <target name="All apps" kind="build" run="make" />
    <target name="Tests" kind="test" run="make test" />
    <target name="Business server checks" kind="test" run="make business-server-check" />
    <target name="Business server" run="python3 tools/orion_server.py serve --state ${state}">
        <param name="state" default="/tmp/orion-company-server" />
    </target>
</launch>
