      <StackView name="page" orientation="vertical" spacing="8" padding="12" flags="flexspace">
        <Label name="regular"  text="Regular 400 at 13px" />
        <Label name="semibold" text="SemiBold 600 at 13px" />
        <Label name="title"    text="SemiBold 600 at 18px" />
